# Generated by scripts/build-package-docs.mjs from the repo-root main-llm.md
# (links rewritten for the installed layout). Regenerated on build and prepack,
# so the tarball always has it.
packages/core/main-llm.md


# Throwaway diagnostic scripts. The convention is a leading dot — `.probe.mjs`,
# `.verify.mjs` — so a one-off written to chase a bug cannot be swept into a
# commit by a broad `git add <dir>`. Two of them were, once.
.*.mjs
!.eslintrc.mjs

# Git worktrees created by Claude Code sessions (`.claude/worktrees/<branch>`).
# These are working copies of THIS repo — committing one would nest the repo
# inside itself. Only the worktrees dir is ignored, so shared .claude config
# (settings, agents) can still be committed deliberately.
.claude/worktrees/
