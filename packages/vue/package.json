{
  "name": "@awc-ui/vue",
  "version": "1.0.0-beta",
  "description": "Vue 3 wrapper for AWC UI Material Design 3 components",
  "keywords": [
    "vue",
    "vue3",
    "vue-components",
    "material-design",
    "material-design-3",
    "md3",
    "ui-components",
    "component-library",
    "web-components",
    "design-system"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "lib",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && esbuild lib/index.ts --bundle --format=esm --target=es2020 --sourcemap --outfile=dist/index.mjs --external:vue --external:@awc-ui/core --external:@awc-ui/core/*"
  },
  "peerDependencies": {
    "@awc-ui/core": "workspace:*",
    "vue": ">=3"
  },
  "devDependencies": {
    "@awc-ui/core": "workspace:*",
    "esbuild": "^0.25.12",
    "typescript": "^5.4.0"
  },
  "license": "MIT",
  "author": "AWC UI",
  "homepage": "https://awc-ui.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awc-ui/core.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/awc-ui/core/issues"
  }
}
