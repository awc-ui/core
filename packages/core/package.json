{
  "name": "@awc-ui/core",
  "version": "1.0.0-beta.14",
  "description": "Accessible Material Design 3 Web Components for React, Angular, Vue, and Svelte, with SSR, theming, RTL, forms, and custom elements",
  "keywords": [
    "material-design",
    "material-design-3",
    "md3",
    "web-component",
    "web-components",
    "custom-element",
    "custom-elements",
    "component",
    "components",
    "stencil",
    "ui-components",
    "component-library",
    "design-system",
    "accessibility",
    "wcag",
    "ssr",
    "material-3",
    "ui-library",
    "typescript",
    "design-tokens",
    "rtl",
    "dark-mode",
    "forms",
    "charts",
    "react-component",
    "react-components",
    "angular-component",
    "angular-components",
    "vue-component",
    "vue-components",
    "svelte-component",
    "svelte-components",
    "server-side-rendering",
    "nextjs",
    "nuxt",
    "sveltekit",
    "angular-ssr"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css",
    "./define.mjs",
    "./loader/**",
    "./dist/components/index.js",
    "./dist/components-csr/index.js",
    "./dist/md3/**",
    "./dist/components/md-*.js",
    "./dist/components-csr/md-*.js"
  ],
  "size-limit": [
    {
      "name": "custom element md-button (SSR-capable default, min+br)",
      "path": "dist/components/md-button.js",
      "limit": "19 kB"
    },
    {
      "name": "custom element md-button (CSR build, min+br)",
      "path": "dist/components-csr/md-button.js",
      "limit": "16 kB"
    }
  ],
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/md3/md3.esm.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.cjs.js"
      }
    },
    "./loader": {
      "import": {
        "types": "./loader/index.d.mts",
        "default": "./loader/index.mjs"
      },
      "require": {
        "types": "./loader/index.d.ts",
        "default": "./loader/index.cjs"
      }
    },
    "./define": {
      "types": "./define.d.mts",
      "default": "./define.mjs"
    },
    "./hydrate": {
      "import": {
        "types": "./hydrate/index.d.mts",
        "default": "./hydrate/index.mjs"
      },
      "require": {
        "types": "./hydrate/index.d.ts",
        "default": "./hydrate/index.js"
      }
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./components-csr/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components-csr/*.js"
    },
    "./dist/components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./dist/components/*.js": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./dist/components-csr": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components-csr/index.js"
    },
    "./dist/components-csr/*.js": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components-csr/*.js"
    },
    "./css/tokens.css": "./dist/md3/md3.css",
    "./css/pre-upgrade.css": "./dist/md3/pre-upgrade.css",
    "./customElements": "./custom-elements.json",
    "./ssr/sveltekit": {
      "types": "./ssr/sveltekit.d.mts",
      "import": "./ssr/sveltekit.mjs"
    }
  },
  "customElements": "./custom-elements.json",
  "files": [
    "dist/",
    "loader/",
    "hydrate/",
    "define.mjs",
    "LICENSE",
    "README.md",
    "bin/",
    "main-llm.md",
    "custom-elements.json",
    "src/components/*/readme.md",
    "define.d.mts",
    "ssr/",
    "!bin/**/*.test.mjs",
    "skills/"
  ],
  "scripts": {
    "build": "node ../../scripts/build-starter-templates.mjs && node ../../scripts/build-package-docs.mjs && rm -rf dist && stencil build && stencil build --config stencil.config.csr.ts && node ../../scripts/fix-module-types.mjs && node ../../scripts/fix-declarations.mjs && node ../../scripts/split-react-components.mjs && node ../../scripts/emit-tokens-css.mjs && node ../../scripts/emit-pre-upgrade-css.mjs && node ../../scripts/compact-sourcemaps.mjs",
    "build:watch": "stencil build --watch",
    "build:dev": "stencil build --config stencil.config.dev.ts",
    "build:watch:dev": "stencil build --config stencil.config.dev.ts --watch",
    "build:coverage-sb": "stencil build --config stencil.config.coverage-sb.ts",
    "build:wasm": "node ../../scripts/build-wasm.mjs",
    "build:wasm:check": "node ../../scripts/build-wasm.mjs --check",
    "test": "stencil test --spec --e2e",
    "test:spec": "stencil test --spec",
    "test:e2e": "stencil test --e2e",
    "test:e2e:coverage": "E2E_COVERAGE=1 stencil test --e2e --config stencil.config.coverage.ts",
    "test:spec:coverage": "jest --config jest.coverage.config.cjs",
    "test:spec:coverage:html": "node scripts/coverage-html.mjs",
    "test:ssr:coverage": "node scripts/ssr-coverage.mjs",
    "test:ssr": "node scripts/ssr-smoke.mjs",
    "test:csr": "node --test scripts/overlay-csr.test.mjs scripts/tables-csr.test.mjs",
    "lint": "tsc --noEmit",
    "dev": "stencil build --dev --watch --serve",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "prepack": "node ../../scripts/generate-custom-elements-manifest.mjs && node ../../scripts/build-package-docs.mjs && node ../../scripts/build-starter-templates.mjs"
  },
  "devDependencies": {
    "@awc-ui/tokens": "workspace:*",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@stencil/angular-output-target": "^0.9.0",
    "@stencil/core": "^4.20.0",
    "@stencil/react-output-target": "^1.6.1",
    "@stencil/vue-output-target": "^0.8.8",
    "@types/jest": "^29.5.0",
    "@types/jest-axe": "^3.5.9",
    "@types/jsdom": "^21.1.0",
    "assemblyscript": "^0.27.31",
    "axe-core": "^4.11.1",
    "esbuild": "^0.25.12",
    "jest": "^29.5.0",
    "jest-axe": "^10.0.0",
    "jest-cli": "^29.5.0",
    "jsdom": "^22.1.0",
    "monocart-coverage-reports": "^2.12.9",
    "puppeteer": "^24.0.0",
    "size-limit": "^11.1.6",
    "typescript": "^5.4.0"
  },
  "license": "MIT",
  "author": "AWC UI",
  "homepage": "https://awc-ui.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awc-ui/core.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/awc-ui/core/issues"
  },
  "bin": {
    "awc-ui": "bin/awc-ui.mjs"
  }
}
