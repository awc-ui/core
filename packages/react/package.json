{
  "name": "@awc-ui/react",
  "version": "1.0.0-beta.3",
  "description": "React wrapper for AWC UI Material Design 3 components",
  "keywords": [
    "react",
    "react-components",
    "material-design",
    "material-design-3",
    "md3",
    "ui-components",
    "component-library",
    "web-components",
    "design-system"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "import { MdButton } from '@awc-ui/react' — wrapper share only (react and @awc-ui/core are peers, excluded). Tripwire: if barrel tree-shaking breaks, all 81 wrappers land here.",
      "path": "dist/index.js",
      "import": "{ MdButton }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "2 kB"
    }
  ],
  "dependencies": {
    "@stencil/react-output-target": "^1.6.1"
  },
  "peerDependencies": {
    "@awc-ui/core": "workspace:*",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@awc-ui/core": "workspace:*",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@types/node": "^20.14.0",
    "@types/react": "~18.2.79",
    "@types/react-dom": "~18.2.25",
    "size-limit": "^11.1.6",
    "typescript": "^5.4.0"
  },
  "license": "MIT",
  "author": "AWC UI",
  "homepage": "https://awc-ui.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awc-ui/core.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/awc-ui/core/issues"
  }
}
