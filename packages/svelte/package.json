{
  "name": "@awc-ui/svelte",
  "version": "1.0.0-beta.9",
  "description": "Svelte 4 and 5 components for accessible Material Design 3 Web Components, with SvelteKit SSR and server-rendering guidance",
  "keywords": [
    "svelte",
    "svelte-component",
    "svelte-components",
    "components",
    "material-design",
    "material-design-3",
    "md3",
    "ui-components",
    "component-library",
    "web-components",
    "design-system",
    "material-3",
    "svelte-ui",
    "custom-elements",
    "typescript",
    "accessibility",
    "wcag",
    "sveltekit",
    "ssr",
    "ui-library",
    "svelte5",
    "svelte-5",
    "svelte-ui-library",
    "svelte-ui-components",
    "svelte-component-library",
    "web-component",
    "svelte-web-components",
    "sveltekit-components",
    "server-side-rendering"
  ],
  "main": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json --emitDeclarationOnly && esbuild src/index.ts --bundle --format=esm --target=es2020 --sourcemap --outfile=dist/index.mjs --external:svelte --external:@awc-ui/core --external:@awc-ui/core/*"
  },
  "peerDependencies": {
    "@awc-ui/core": "workspace:*",
    "svelte": ">=4"
  },
  "devDependencies": {
    "@awc-ui/core": "workspace:*",
    "esbuild": "^0.25.12",
    "typescript": "^5.4.0"
  },
  "license": "MIT",
  "author": "AWC UI",
  "homepage": "https://awc-ui.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awc-ui/core.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/awc-ui/core/issues"
  },
  "module": "dist/index.mjs",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module"
}
