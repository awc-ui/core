      "type": "| 'bottom' | 'bottom-start' | 'bottom-end'\n    | 'top' | 'top-start' | 'top-end'\n    | 'start' | 'end' | 'center'",
      "default": "'bottom'",
      "defaultValue": "bottom",
      "options": [
        "bottom",
        "bottom-start",
        "bottom-end",
        "top",
        "top-start",
        "top-end",
        "start",
        "end",
        "center"
