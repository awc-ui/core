    {
      "name": "politeness",
      "type": "'polite' | 'assertive'",
      "default": "'polite'",
      "defaultValue": "polite",
      "options": [
        "polite",
        "assertive"
      ],
      "mutable": false,
      "reflect": true,
      "attribute": "politeness",
      "optional": false,
      "description": "Live-region politeness. `'polite'` (default) → `role=\"status\"` /\n`aria-live=\"polite\"` (announced when idle). `'assertive'` → `role=\"alert\"` /\n`aria-live=\"assertive\"` — interrupts the screen reader; use sparingly for\nimportant / error messages."
    },
    {
      "name": "dismissLabel",
      "type": "string",
      "default": "'Dismiss'",
      "defaultValue": "Dismiss",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "dismiss-label",
      "optional": false,
      "description": "Accessible label for the close button. Localize per the page locale."
    },
    {
      "name": "density",
      "type": "0 | -1 | -2 | -3 | -4",
      "default": "0",
      "defaultValue": 0,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "density",
      "optional": false,
      "description": "Local density rung. Drives the same `--md-sys-density-scale` signal that a\nglobal `data-density` ancestor sets, so a local value simply overrides the\ninherited one. 0 = default, -4 = ultra-compact."
    }
