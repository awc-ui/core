  "render": {
    "kind": "element",
    "tag": "Host",
    "attributes": [
      {
        "name": "class",
        "value": "{\n          'md-snackbar': true,\n          'md-snackbar--open': this.open,\n          'md-snackbar--stacked': this.stacked,\n          [`md-snackbar--${this.position}`]: true,\n          'md-snackbar--with-action': hasAction,\n          'md-snackbar--with-close': hasClose,\n        }"
      },
      {
        "name": "role",
        "value": "this.politeness === 'assertive' ? 'alert' : 'status'"
      },
      {
        "name": "aria-live",
        "value": "this.politeness"
      },
      {
        "name": "aria-atomic",
        "value": "true"
      }
    ],
    "children": [
      {
        "kind": "text",
        "value": ""
      },
      {
        "kind": "element",
        "tag": "div",
        "attributes": [
          {
            "name": "class",
            "value": "md-snackbar__surface"
          },
          {
            "name": "part",
            "value": "surface"
          },
          {
            "name": "onMouseEnter",
            "value": "this.pauseAutoHide"
          },
          {
            "name": "onMouseLeave",
            "value": "this.resumeAutoHide"
          },
          {
            "name": "onFocusin",
            "value": "this.pauseAutoHide"
          },
          {
            "name": "onFocusout",
            "value": "this.handleSurfaceFocusOut"
          }
        ],
        "children": [
          {
            "kind": "text",
            "value": ""
          },
          {
            "kind": "element",
            "tag": "span",
            "attributes": [
              {
                "name": "class",
