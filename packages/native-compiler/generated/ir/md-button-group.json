{
  "tag": "md-button-group",
  "className": "MdButtonGroup",
  "properties": [
    {
      "name": "variant",
      "type": "'standard' | 'connected'",
      "default": "'standard'",
      "defaultValue": "standard",
      "options": [
        "standard",
        "connected"
      ],
      "mutable": false,
      "reflect": false,
      "attribute": "variant",
      "optional": false,
      "description": "Standard groups add padding between buttons; connected groups fuse them together"
    },
    {
      "name": "size",
      "type": "'xs' | 'sm' | 'md' | 'lg' | 'xl'",
      "default": "'sm'",
      "defaultValue": "sm",
      "options": [
        "xs",
        "sm",
        "md",
        "lg",
        "xl"
      ],
      "mutable": false,
      "reflect": false,
      "attribute": "size",
      "optional": false,
      "description": "Button size — controls gap (standard) and inner corner radii (connected)"
    },
    {
      "name": "shape",
      "type": "'round' | 'square'",
      "default": "'round'",
      "defaultValue": "round",
      "options": [
        "round",
        "square"
      ],
      "mutable": false,
      "reflect": false,
      "attribute": "shape",
      "optional": false,
      "description": "Default shape applied to all child buttons"
    },
    {
      "name": "selectionMode",
      "type": "'single-select' | 'multi-select'",
      "default": "'single-select'",
      "defaultValue": "single-select",
      "options": [
        "single-select",
        "multi-select"
      ],
      "mutable": false,
      "reflect": false,
      "attribute": "selection-mode",
      "optional": false,
      "description": "Selection mode"
    },
    {
      "name": "required",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "required",
      "optional": false,
      "description": "When true, at least one button must remain selected"
    },
    {
      "name": "fullWidth",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "full-width",
      "optional": false,
      "description": "When `true` the group stretches to 100% of its container's inline-size\nand its children share that space equally (`flex: 1 1 0`). Combine with\nthe `--md-button-group-width` / `--md-button-group-max-width` CSS custom\nproperties for fine-grained control over the final size."
    },
    {
      "name": "density",
      "type": "0 | -1 | -2 | -3 | -4",
      "default": "0",
      "defaultValue": 0,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "density",
      "optional": false,
      "description": "Local density rung. Drives the same `--md-sys-density-scale` signal that a\nglobal `data-density` ancestor sets, so a local value simply overrides the\ninherited one. 0 = default, -4 = ultra-compact."
    }
  ],
  "state": [],
  "events": [
