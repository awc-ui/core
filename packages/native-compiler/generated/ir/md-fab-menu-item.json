      "attribute": "roving-focus-visible",
      "optional": false,
      "description": "When `true`, paints the keyboard-focus ring even if the item does not hold DOM focus\n(e.g. arrow-key navigation drove `focusItem()`). Set by `md-fab-menu` during\nprogrammatic roving — not on initial open."
    },
    {
      "name": "density",
      "type": "0 | -1 | -2 | -3 | -4",
      "default": "0",
      "defaultValue": 0,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "density",
      "optional": false,
      "description": "Local density rung. Drives the same `--md-sys-density-scale` signal that a\nglobal `data-density` ancestor sets, so a local value simply overrides the\ninherited one. 0 = default, -4 = ultra-compact."
