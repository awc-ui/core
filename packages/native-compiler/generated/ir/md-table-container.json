{
  "tag": "md-table-container",
  "className": "MdTableContainer",
  "properties": [
    {
      "name": "variant",
      "type": "'elevated' | 'outlined' | 'filled' | 'flat'",
      "default": "'elevated'",
      "defaultValue": "elevated",
      "options": [
        "elevated",
        "outlined",
        "filled",
        "flat"
      ],
      "mutable": false,
      "reflect": true,
      "attribute": "variant",
      "optional": false,
      "description": "Visual surface variant.\n- `elevated` — surface-container-low + box-shadow\n- `outlined` — surface + 1px outline\n- `filled`   — surface-container-low, no shadow / outline\n- `flat`     — transparent (use when nesting inside another surface)"
    },
    {
      "name": "shape",
      "type": "'extra-large' | 'large' | 'medium' | 'small' | 'none'",
      "default": "'large'",
      "defaultValue": "large",
      "options": [
        "extra-large",
        "large",
        "medium",
        "small",
        "none"
      ],
      "mutable": false,
      "reflect": true,
      "attribute": "shape",
      "optional": false,
      "description": "Container shape — large for dashboards, medium for dense, small for compact.\nMaps to MD3 `--md-sys-shape-corner-{size}` tokens."
    },
    {
      "name": "maxHeight",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "max-height",
      "optional": false,
      "description": "If set, the table area becomes scrollable up to this max-height\n(e.g. `\"480px\"`, `\"60vh\"`). Required for sticky header / column."
    },
    {
      "name": "minHeight",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "min-height",
      "optional": false,
      "description": "If set, the table area becomes scrollable up to this min-height\n(useful to keep an empty-state visible)."
    },
    {
      "name": "vibrant",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "vibrant",
      "optional": false,
      "description": "Vibrant tonality: tints the whole table with primary/tertiary container\ntones (coloured header, primary hover, tertiary selection, primary-tinted\nsurface). Cascades to the contained md-table via CSS custom properties."
    },
    {
      "name": "elevation",
      "type": "0 | 1 | 2 | 3 | 4 | 5",
      "default": "",
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "elevation",
      "optional": true,
      "description": "Explicit MD3 elevation level (0–5), overriding the variant's default\nshadow. Handy to raise/flatten the surface without changing `variant`\n(e.g. `variant=\"outlined\" elevation=\"2\"`). Also settable via\n`--md-table-container-elevation`."
    }
