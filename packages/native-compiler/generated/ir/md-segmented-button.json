  "render": {
    "kind": "element",
    "tag": "Host",
    "attributes": [
      {
        "name": "class",
        "value": "{\n          'md-segmented-button': true,\n          'md-segmented-button--selected': this.selected,\n          'md-segmented-button--disabled': this.isDisabled,\n          'md-segmented-button--with-icon': hasIcon || showCheckmark,\n          'md-segmented-button--first': isFirst,\n          'md-segmented-button--last': isLast,\n          [`md-segmented-button--density-${Math.abs(density)}`]: density !== 0,\n        }"
      },
      {
        "name": "role",
        "value": "this.segmentMultiselect ? 'checkbox' : 'radio'"
      },
      {
        "name": "aria-checked",
        "value": "String(this.selected)"
      },
      {
        "name": "aria-disabled",
        "value": "this.isDisabled ? 'true' : 'false'"
      },
      {
        "name": "tabindex",
        "value": "this.disabled ? '-1' : '0'"
      },
      {
        "name": "onClick",
        "value": "this.handleClick"
      },
      {
        "name": "onKeyDown",
        "value": "this.handleKeyDown"
      }
    ],
    "children": [
      {
        "kind": "text",
        "value": ""
      },
      {
        "kind": "expression",
        "source": "this.ripple && <md-ripple disabled={this.isDisabled}></md-ripple>"
      },
      {
        "kind": "text",
        "value": ""
      },
      {
        "kind": "element",
        "tag": "span",
        "attributes": [
          {
            "name": "class",
            "value": "md-segmented-button__state-layer"
          },
          {
            "name": "part",
            "value": "state-layer"
          },
          {
            "name": "aria-hidden",
            "value": "true"
          }
        ],
        "children": []
      },
      {
        "kind": "text",
        "value": ""
      },
      {
        "kind": "element",
        "tag": "span",
        "attributes": [
          {
            "name": "class",
            "value": "md-segmented-button__outline"
          },
          {
            "name": "aria-hidden",
            "value": "true"
          }
        ],
        "children": []
      },
      {
        "kind": "text",
        "value": ""
      },
      {
        "kind": "element",
        "tag": "span",
        "attributes": [
          {
            "name": "class",
            "value": "md-segmented-button__content"
          }
        ],
        "children": [
          {
            "kind": "text",
            "value": ""
          },
          {
            "kind": "expression",
            "source": "hasIcon ? (\n            // Icon segments: single element swaps icon ↔ checkmark in-place\n            <span class=\"md-segmented-button__graphic material-symbols-outlined\"\n              part={showCheckmark ? 'checkmark' : 'icon'}\n              aria-hidden=\"true\"\n            >{showCheckmark ? 'check' : this.icon}</span>\n          ) : !this.noCheckmark ? (\n            // Text-only: always reserve leading graphic space so segments\n            // pre-account for the checkmark width and never cramp.\n            <span class={{\n                'md-segmented-button__graphic': true,\n                'material-symbols-outlined': true,\n                'md-segmented-button__graphic--hidden': !this.selected,\n              }}\n              part={this.selected ? 'checkmark' : undefined}\n              aria-hidden=\"true\"\n            >{this.selected ? 'check' : ''}</span>\n          ) : null"
          },
          {
            "kind": "text",
            "value": ""
          },
          {
            "kind": "element",
            "tag": "slot",
            "attributes": [
              {
                "name": "name",
                "value": "icon"
              }
            ],
            "children": []
          },
          {
            "kind": "text",
            "value": ""
          },
          {
            "kind": "text",
            "value": ""
          },
          {
            "kind": "text",
            "value": ""
          },
          {
            "kind": "expression",
            "source": "hasLabel ? (\n            <span class=\"md-segmented-button__label\" part=\"label\">\n              {this.label ? this.label : <slot />}\n            </span>\n          ) : (\n            <slot />\n          )"
          },
          {
            "kind": "text",
            "value": ""
          },
          {
            "kind": "text",
            "value": ""
          },
          {
            "kind": "expression",
            "source": "!hasIcon && !this.noCheckmark && (\n            <span class=\"md-segmented-button__spacer\" aria-hidden=\"true\"></span>\n          )"
          },
          {
            "kind": "text",
            "value": ""
          }
        ]
      },
      {
        "kind": "text",
        "value": ""
      }
    ]
  },
