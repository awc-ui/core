{
  "tag": "md-list",
  "className": "MdList",
  "properties": [
    {
      "name": "listStyle",
      "type": "MdListStyle",
      "default": "'standard'",
      "defaultValue": "standard",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "list-style",
      "optional": false,
      "description": "Visual style of the list.\n\n- `standard` (default, M3 Expressive): rows share a single rounded\n  chassis with **no gap** between them. The first row rounds its\n  top corners, the last rounds its bottom corners, and middle rows\n  are square so the stack reads as one continuous shape — the M3\n  \"connected\" pattern. Best for settings panels, option groups,\n  and iOS-style sectioned tables. To add hairline separators\n  between rows, interleave `<md-divider>` elements.\n- `segmented` (M3 Expressive): rows are individually rounded \"tiles\"\n  separated by a small gap. Each tile rounds all four corners. Best\n  for action sets, quick-action menus, and card-like sections where\n  each row should read as its own affordance."
    },
    {
      "name": "selectionMode",
      "type": "MdListSelectionMode",
      "default": "'none'",
      "defaultValue": "none",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "selection-mode",
      "optional": false,
      "description": "Selection coordination across child rows.\n\n- `none` (default): each row stands alone and the container is always\n  `role=\"list\"` (rows are `listitem`s). Interactive rows (`type=\"button\"` /\n  `type=\"link\"`) expose their widget role on an inner primary element, so\n  the list validly owns only `listitem`s while still providing the same\n  roving-tabindex + arrow-key navigation. `type=\"text\"` rows stay\n  non-focusable.\n- `single-select`: the container behaves as `role=\"listbox\"`, items\n  become `role=\"option\"`, and exactly one item carries `aria-selected`.\n- `multi-select`: same as above plus `aria-multiselectable=\"true\"`.\n\nSwitching to a selection mode also auto-promotes plain `type=\"text\"`\nrows to focusable so users can pick from a list of label-only rows\nwithout authoring extra props."
    },
    {
      "name": "interactionMode",
      "type": "MdListInteractionMode",
      "default": "'single-action'",
      "defaultValue": "single-action",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "interaction-mode",
      "optional": false,
      "description": "Row interaction pattern for the whole list. A list uses exactly one\ninteraction mode at a time (per the M3 Lists spec).\n\n- `single-action` (default): each row is one tappable area — leading\n  icon + label activate together. Use `type=\"button\"` (or selection\n  mode) on items.\n- `multi-action`: rows expose a primary action (the row body) plus\n  optional secondary actions in `slot=\"trailing\"` (e.g. `md-icon-button`).\n  Clicks on trailing controls do not activate the primary row action;\n  each secondary control keeps its own focus stop and keyboard behavior."
    },
    {
      "name": "reorderable",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "reorderable",
      "optional": false,
      "description": ""
    },
    {
      "name": "label",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "label",
      "optional": false,
      "description": "Optional aria-label for the container."
    },
    {
      "name": "labelledby",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "labelledby",
      "optional": false,
      "description": "Optional aria-labelledby for the container."
    },
    {
      "name": "roleOverride",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "role-override",
      "optional": false,
      "description": "Override the auto-computed ARIA role. Useful when wiring the list\ninto a wider widget pattern (e.g. `role=\"menu\"` for a dropdown).\nLeave empty to use the role implied by `selectionMode`."
    },
    {
      "name": "density",
      "type": "0 | -1 | -2 | -3 | -4",
      "default": "0",
      "defaultValue": 0,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "density",
      "optional": false,
      "description": "Local density rung. Drives the same `--md-sys-density-scale` signal that a\nglobal `data-density` ancestor sets, so a local value simply overrides the\ninherited one. 0 = default, -4 = ultra-compact."
    }
  ],
