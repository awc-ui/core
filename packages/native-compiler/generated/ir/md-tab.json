    "attributes": [
      {
        "name": "class",
        "value": "{\n          'md-tab': true,\n          [`md-tab--${this.variant}`]: true,\n          'md-tab--active': this.active,\n          'md-tab--disabled': this.disabled,\n          'md-tab--inline-icon': isInline,\n          'md-tab--stacked': isStacked,\n          'md-tab--icon-only': hasIcon && !hasLabel,\n        }"
      },
      {
        "name": "role",
        "value": "tab"
      },
      {
        "name": "aria-selected",
        "value": "this.active ? 'true' : 'false'"
      },
      {
        "name": "aria-disabled",
        "value": "this.disabled ? 'true' : null"
      },
      {
        "name": "aria-controls",
        "value": "this.controls || null"
      },
      {
        "name": "onClick",
        "value": "this.handleClick"
      },
      {
        "name": "onKeyDown",
        "value": "this.handleKeyDown"
