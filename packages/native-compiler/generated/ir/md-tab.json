            "tag": "span",
            "attributes": [
              {
                "name": "class",
                "value": "{\n              'md-tab__content': true,\n              'md-tab__content--inline': isInline,\n            }"
              },
              {
                "name": "part",
                "value": "content"
              }
            ],
            "children": [
              {
                "kind": "text",
                "value": ""
              },
              {
                "kind": "expression",
                "source": "hasIcon && (\n              <span class=\"md-tab__icon-wrapper\">\n                <slot name=\"icon\">\n                  <span class=\"md-tab__icon material-symbols-outlined\" part=\"icon\" aria-hidden=\"true\">\n                    {this.icon}\n                  </span>\n                </slot>\n                <slot name=\"badge\">\n                  {hasBadge && (\n                    <span class=\"md-tab__badge\" aria-label={this.badge || 'notification'}>\n                      {this.badge}\n                    </span>\n                  )}\n                </slot>\n              </span>\n            )"
              },
              {
                "kind": "text",
                "value": ""
              },
              {
                "kind": "expression",
                "source": "hasLabel && (\n              <span class=\"md-tab__label\" part=\"label\">\n                <span class=\"md-tab__label-text\">{this.label}</span>\n                {!hasIcon && (\n                  <slot name=\"badge\">\n                    {hasBadge && (\n                      <span class=\"md-tab__badge md-tab__badge--inline\" aria-label={this.badge || 'notification'}>\n                        {this.badge}\n                      </span>\n                    )}\n                  </slot>\n                )}\n              </span>\n            )"
              },
              {
                "kind": "text",
                "value": ""
              }
            ]
          },
          {
            "kind": "text",
            "value": ""
          },
          {
            "kind": "expression",
            "source": "this.variant === 'primary' ? (\n            <span\n              class={{\n                'md-tab__indicator': true,\n                'md-tab__indicator--active': this.active,\n              }}\n              part=\"indicator\"\n              aria-hidden=\"true\"\n            ></span>\n          ) : null"
          },
          {
            "kind": "text",
            "value": ""
          }
        ]
      },
      {
        "kind": "text",
        "value": ""
      },
      {
        "kind": "expression",
        "source": "this.variant === 'secondary' ? (\n          <span\n            class={{\n              'md-tab__indicator': true,\n              'md-tab__indicator--active': this.active,\n            }}\n            part=\"indicator\"\n            aria-hidden=\"true\"\n          ></span>\n        ) : null"
      },
