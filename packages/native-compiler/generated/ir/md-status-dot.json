      "description": "Halo outline (default surface)"
    },
    {
      "name": "--md-status-dot-outline-width",
      "description": "Halo outline width (default 2px)"
    },
    {
      "name": "--md-status-dot-inset-end",
      "description": "inline-end anchor offset (default -2px)"
    },
    {
      "name": "--md-status-dot-inset-block-end",
      "description": "block-end anchor offset (default -2px)"
    },
    {
      "name": "--md-status-dot-pulse-duration",
      "description": "Pulse animation period (default 1.6s)"
    }
  ],
  "render": {
    "kind": "element",
    "tag": "Host",
    "attributes": [
      {
        "name": "class",
        "value": "{\n          'md-status-dot': true,\n          [`md-status-dot--${this.state}`]: true,\n          [`md-status-dot--${this.size}`]: true,\n          // Only the circular case gets a class: `rect` is the default anchor\n          // the base rule already implements, so a `--rect` class would be a\n          // second name for \"nothing\".\n          'md-status-dot--circle': this.shape === 'circle',\n          'md-status-dot--live': this.live,\n          'md-status-dot--labelled': labelled,\n        }"
      },
      {
        "name": "role",
        "value": "role"
      },
      {
        "name": "aria-label",
        "value": "labelled ? this.label : null"
      },
      {
        "name": "aria-hidden",
        "value": "labelled ? null : 'true'"
      }
    ],
    "children": []
  },
