      "cancelable": true,
      "bubbles": true,
      "composed": true
    },
    {
      "name": "mdDragEnd",
      "detail": "MdCardDragDetail",
      "cancelable": true,
      "bubbles": true,
      "composed": true
    }
  ],
  "methods": [],
  "slots": [
    {
      "name": ""
    }
  ],
  "cssParts": [
    {
      "name": "state-layer",
      "description": "Hover/press overlay (interactive only)"
    },
    {
