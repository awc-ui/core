{
  "tag": "md-card",
  "className": "MdCard",
  "properties": [
    {
      "name": "variant",
      "type": "'elevated' | 'filled' | 'outlined'",
      "default": "'elevated'",
      "defaultValue": "elevated",
      "options": [
        "elevated",
        "filled",
        "outlined"
      ],
      "mutable": false,
      "reflect": false,
      "attribute": "variant",
      "optional": false,
      "description": "Visual style variant"
    },
    {
      "name": "interactive",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "interactive",
      "optional": false,
      "description": "Makes the card interactive (clickable, with ripple and state layers).\n\nWhen the card's own content has no focusable controls the host exposes\n`role=\"button\"` + `tabindex` and is keyboard-activatable. If the content\n*does* include its own focusable controls (buttons, links, form fields,\ninteractive `md-*` components) the host does not claim `role=\"button\"` —\nthat would be a `nested-interactive` a11y violation — and instead stays a\nplain container that is still mouse-clickable (emits `mdClick`) while the\ninner controls remain the keyboard tab stops."
    },
    {
      "name": "dragEnabled",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "drag-enabled",
      "optional": false,
      "description": "Enables pointer-event-based drag on the card"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "disabled",
      "optional": false,
      "description": "Disables the card — only meaningful when interactive"
    },
    {
      "name": "softDisabled",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "soft-disabled",
      "optional": false,
      "description": "Soft-disabled: disabled visuals but remains focusable — only meaningful when interactive"
    },
    {
      "name": "ripple",
      "type": "boolean",
      "default": "true",
      "defaultValue": true,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "ripple",
      "optional": false,
      "description": "Whether the ripple effect is enabled when interactive"
    },
    {
      "name": "fullWidth",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "full-width",
      "optional": false,
      "description": "When `true` the card stretches to 100% of its container's inline-size.\nPair with the `--md-card-max-width` custom property to cap the fluid\nwidth (useful inside dashboards and responsive grids)."
    },
    {
      "name": "fullHeight",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "full-height",
      "optional": false,
      "description": "When `true` the card stretches to 100% of its container's block-size.\nThe parent must have a definite block-size (e.g. a fixed height row in\na CSS grid, or a flex item with `align-items: stretch`) for `100%` to\nresolve."
    },
    {
      "name": "density",
      "type": "0 | -1 | -2 | -3 | -4",
      "default": "0",
      "defaultValue": 0,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "density",
      "optional": false,
      "description": "Local density rung. Drives the same `--md-sys-density-scale` signal that a\nglobal `data-density` ancestor sets, so a local value simply overrides the\ninherited one. 0 = default, -4 = ultra-compact."
    }
  ],
  "state": [
    {
      "name": "dragging",
      "type": "inferred",
      "initializer": "false"
    },
    {
      "name": "hasInteractiveContent",
      "type": "inferred",
      "initializer": "false"
    }
  ],
  "events": [
    {
      "name": "mdClick",
      "detail": "MouseEvent",
      "cancelable": true,
      "bubbles": true,
      "composed": true
    },
    {
      "name": "mdDragStart",
