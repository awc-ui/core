    }
  ],
  "render": {
    "kind": "element",
    "tag": "Host",
    "attributes": [
      {
        "name": "class",
        "value": "{\n          'md-skeleton': true,\n          [`md-skeleton--${this.variant}`]: true,\n          [`md-skeleton--anim-${effectiveAnimation}`]: true,\n        }"
      },
      {
        "name": "role",
        "value": "this.announce ? 'status' : undefined"
      },
      {
        "name": "aria-busy",
        "value": "this.announce ? 'true' : undefined"
      },
      {
        "name": "aria-live",
        "value": "this.announce ? 'polite' : undefined"
      },
      {
        "name": "aria-label",
        "value": "this.announce ? this.ariaLabelProp : undefined"
      },
      {
        "name": "aria-hidden",
        "value": "this.announce ? undefined : 'true'"
      },
      {
        "name": "style",
        "value": "inlineStyle"
      }
    ],
    "children": [
      {
        "kind": "text",
        "value": ""
      },
      {
        "kind": "expression",
        "source": "this.variant === 'text' ? (\n          this.renderTextLines()\n        ) : (\n          <span\n            class=\"md-skeleton__shape\"\n            part=\"shape\"\n            aria-hidden=\"true\"\n          ></span>\n        )"
      },
      {
        "kind": "text",
        "value": ""
      }
    ]
  },
