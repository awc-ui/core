{
  "tag": "md-skeleton",
  "className": "MdSkeleton",
  "properties": [
    {
      "name": "variant",
      "type": "'text' | 'rectangular' | 'rounded' | 'circular'",
      "default": "'text'",
      "defaultValue": "text",
      "options": [
        "text",
        "rectangular",
        "rounded",
        "circular"
      ],
      "mutable": false,
      "reflect": true,
      "attribute": "variant",
      "optional": false,
      "description": "Shape of the skeleton placeholder.\n- `text` — single short rectangle the height of a body line. With\n  `lines > 1` the last line gets a tapered width so it reads as a\n  \"last line of a paragraph\".\n- `rectangular` — fills the inline + block sizes you give it; no\n  border-radius unless you set `--md-skeleton-radius`.\n- `rounded` — same as `rectangular` but with the MD3 medium corner\n  radius (or your override). Good for cards / images.\n- `circular` — perfect circle (1:1 aspect). Use for avatar / icon\n  placeholders; set `--md-skeleton-size` or `width`+`height`."
    },
    {
      "name": "animation",
      "type": "'pulse' | 'wave' | 'none'",
      "default": "'pulse'",
      "defaultValue": "pulse",
      "options": [
        "pulse",
        "wave",
        "none"
      ],
      "mutable": false,
      "reflect": true,
      "attribute": "animation",
      "optional": false,
      "description": "Animation style:\n- `pulse` (default) — gentle opacity fade in and out.\n- `wave` — shimmer gradient sweeps across the surface.\n- `none` — static block; useful in `prefers-reduced-motion` opt-outs\n  or when the skeleton is purely decorative."
    },
    {
      "name": "lines",
      "type": "number",
      "default": "1",
      "defaultValue": 1,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "lines",
      "optional": false,
      "description": "Number of text rows to render. Only meaningful for `variant=\"text\"`.\nThe last row is tapered to ~60 % width so it reads as the final\nline of a paragraph."
    },
    {
      "name": "width",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "width",
      "optional": false,
      "description": "Inline size (CSS length). Overrides any `--md-skeleton-width`.\nExamples: `\"100%\"`, `\"240px\"`, `\"60ch\"`."
    },
    {
      "name": "height",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "height",
      "optional": false,
      "description": "Block size (CSS length). Defaults are `1em` for text, `120px` for\nrectangular/rounded, and `40px` for circular."
    },
    {
      "name": "fullWidth",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "full-width",
      "optional": false,
      "description": "Stretch to fill the parent's inline size, overriding `width` /\n`--md-skeleton-width`. (The skeleton is already 100%-wide by default; this\nmakes it explicit and wins over a fixed width — handy in responsive grids.)"
    },
    {
      "name": "fullHeight",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "full-height",
      "optional": false,
      "description": "Stretch to fill the parent's block size — the placeholder fills its\ncontainer's height (which must be definite, e.g. a flex/grid cell). Best\nwith the shape variants (`rectangular` / `rounded` / `circular`); pairs with\n`full-width` for a fully responsive block."
    },
    {
      "name": "ariaLabelProp",
      "type": "string",
      "default": "'Loading'",
      "defaultValue": "Loading",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "aria-label",
      "optional": false,
      "description": "Accessible label. Defaults to \"Loading…\". Pass a more specific\nlabel when the skeleton represents a recognisable region\n(\"Loading article\") for better screen-reader context."
    },
    {
      "name": "announce",
      "type": "boolean",
      "default": "true",
      "defaultValue": true,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "announce",
      "optional": false,
      "description": "Whether to expose the skeleton to assistive tech at all. Set to\n`false` when the surrounding region already announces its own\nbusy state — duplicate announcements get noisy."
    },
    {
      "name": "density",
      "type": "0 | -1 | -2 | -3 | -4",
      "default": "0",
      "defaultValue": 0,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "density",
      "optional": false,
      "description": "Local density rung. Drives the same `--md-sys-density-scale` signal that a\nglobal `data-density` ancestor sets, so a local value simply overrides the\ninherited one. 0 = default, -4 = ultra-compact."
    }
  ],
  "state": [
    {
      "name": "prefersReducedMotion",
      "type": "boolean",
      "initializer": "false"
    }
  ],
  "events": [],
  "methods": [],
  "slots": [],
  "cssParts": [
