{
  "tag": "md-avatar",
  "className": "MdAvatar",
  "properties": [
    {
      "name": "src",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "src",
      "optional": false,
      "description": "Image URL. When set, the avatar renders as an `<img>` element."
    },
    {
      "name": "alt",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "alt",
      "optional": false,
      "description": "Alternative text for the image. When empty, the image is exposed to\nAT as decorative (`aria-hidden`); the host carries the accessible\nlabel instead (see `label`)."
    },
    {
      "name": "name",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "name",
      "optional": false,
      "description": "Full name. The component derives initials automatically:\n  - `\"Ada Lovelace\"` → `\"AL\"`\n  - `\"Cher\"`         → `\"C\"`\n  - `\"  john   doe\"` → `\"JD\"`\n\nHonored only when `src` is not set (or fails to load) and\n`initials` is empty."
    },
    {
      "name": "initials",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "initials",
      "optional": false,
      "description": "Explicit initials override. Bypasses the `name` parsing entirely.\nTruncated to the first 3 grapheme clusters at render time so a\nstray \"WXYZ\" can't blow out the layout."
    },
    {
      "name": "size",
      "type": "MdAvatarSize",
      "default": "'medium'",
      "defaultValue": "medium",
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "size",
      "optional": false,
      "description": "Avatar size. Accepts either a named preset or any CSS length.\n\nPresets:\n- `small`   — 24×24 (typography: label-medium)\n- `medium`  — 40×40 (typography: title-medium)  [default]\n- `large`   — 56×56 (typography: title-large)\n\nCustom values:\n- Unitless number → pixels (`size=\"72\"` → 72px)\n- Any CSS length  → passes through (`size=\"4rem\"`, `size=\"10vw\"`,\n  `size=\"clamp(28px, 4vw, 72px)\"`)\n\nCustom values are wired through the existing `--md-avatar-size` CSS\ncustom property, so per-instance overrides via `style` / class still\nwin when set."
    },
    {
      "name": "shape",
      "type": "MdAvatarShape",
      "default": "'circle'",
      "defaultValue": "circle",
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "shape",
      "optional": false,
      "description": "Container shape.\n- `circle`  — fully rounded (`50%`)             [default]\n- `rounded` — `--md-sys-shape-corner-medium` (12px)\n- `square`  — sharp corners (`0`)"
    },
    {
      "name": "label",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "label",
      "optional": false,
      "description": "Accessible label for the avatar. When empty:\n  - if `alt` is set, that is exposed instead\n  - if `name` is set, that is exposed instead\n  - otherwise the avatar is hidden from AT (`role=\"presentation\"`)\n    so it doesn't add noise next to a labelled control."
    },
    {
      "name": "colorFromName",
      "type": "boolean",
      "default": "true",
      "defaultValue": true,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "color-from-name",
      "optional": false,
      "description": "When `true` the avatar background is deterministically picked from a\ntonal palette using the initials/name as a hash seed. When `false`,\nthe avatar uses the neutral on-surface tone."
    },
    {
      "name": "loading",
      "type": "'eager' | 'lazy'",
      "default": "'lazy'",
      "defaultValue": "lazy",
      "options": [
        "eager",
        "lazy"
      ],
      "mutable": false,
      "reflect": false,
      "attribute": "loading",
      "optional": false,
      "description": "`<img>` `loading` attribute."
    },
    {
      "name": "crossorigin",
      "type": "'' | 'anonymous' | 'use-credentials'",
      "default": "''",
      "defaultValue": "",
      "options": [
        "",
        "anonymous",
        "use-credentials"
      ],
      "mutable": false,
      "reflect": false,
      "attribute": "crossorigin",
      "optional": false,
      "description": "`<img>` `crossorigin` attribute (forwarded only when set)."
    },
    {
      "name": "density",
      "type": "0 | -1 | -2 | -3 | -4",
      "default": "0",
      "defaultValue": 0,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "density",
      "optional": false,
      "description": "Local density rung. Drives the same `--md-sys-density-scale` signal that a\nglobal `data-density` ancestor sets, so a local value simply overrides the\ninherited one. 0 = default, -4 = ultra-compact."
    }
  ],
  "state": [
