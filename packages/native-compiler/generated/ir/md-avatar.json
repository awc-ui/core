  "render": {
    "kind": "element",
    "tag": "Host",
    "attributes": [
      {
        "name": "class",
        "value": "{\n          'md-avatar': true,\n          [`md-avatar--${this.size}`]: isPresetSize,\n          'md-avatar--custom-size': !isPresetSize && !!customSize,\n          [`md-avatar--${this.shape}`]: true,\n          [`md-avatar--mode-${fallbackMode}`]: true,\n          [`md-avatar--palette-${palette}`]: palette > 0 && fallbackMode !== 'image',\n          'md-avatar--has-image': hasImage,\n        }"
      },
      {
        "name": "style",
        "value": "hostStyle"
      },
      {
        "name": "role",
        "value": "a11yLabel ? 'img' : 'presentation'"
      },
      {
        "name": "aria-label",
        "value": "a11yLabel"
      },
      {
        "name": "aria-hidden",
        "value": "a11yLabel ? null : 'true'"
      }
    ],
    "children": [
      {
        "kind": "text",
        "value": ""
      },
      {
        "kind": "expression",
        "source": "fallbackMode === 'image' && (\n          <img\n            class=\"md-avatar__image\"\n            part=\"image\"\n            src={this.src}\n            alt={this.alt || ''}\n            loading={this.loading}\n            crossorigin={this.crossorigin || undefined}\n            aria-hidden=\"true\"\n            draggable={false}\n            onLoad={this.handleImageLoad}\n            onError={this.handleImageError}\n          />\n        )"
      },
      {
        "kind": "text",
        "value": ""
      },
      {
        "kind": "expression",
        "source": "fallbackMode === 'initials' && (\n          <span class=\"md-avatar__initials\" part=\"initials\" aria-hidden=\"true\">\n            {computedInitials}\n          </span>\n        )"
      },
      {
        "kind": "text",
        "value": ""
      },
      {
        "kind": "expression",
        "source": "fallbackMode === 'slot' && (\n          <slot>\n            <span class=\"md-avatar__icon material-symbols-outlined\" part=\"icon\" aria-hidden=\"true\">\n              person\n            </span>\n          </slot>\n        )"
      },
      {
        "kind": "text",
        "value": ""
      }
    ]
  },
