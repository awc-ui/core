{
  "tag": "md-stepper",
  "className": "MdStepper",
  "properties": [
    {
      "name": "orientation",
      "type": "'horizontal' | 'vertical'",
      "default": "'horizontal'",
      "defaultValue": "horizontal",
      "options": [
        "horizontal",
        "vertical"
      ],
      "mutable": false,
      "reflect": true,
      "attribute": "orientation",
      "optional": false,
      "description": "Layout orientation."
    },
    {
      "name": "indicator",
      "type": "'numbered' | 'dot'",
      "default": "'numbered'",
      "defaultValue": "numbered",
      "options": [
        "numbered",
        "dot"
      ],
      "mutable": false,
      "reflect": true,
      "attribute": "indicator",
      "optional": false,
      "description": "Indicator style: `numbered` circles or minimal `dot`s."
    },
    {
      "name": "variant",
      "type": "'default' | 'mobile'",
      "default": "'default'",
      "defaultValue": "default",
      "options": [
        "default",
        "mobile"
      ],
      "mutable": false,
      "reflect": true,
      "attribute": "variant",
      "optional": false,
      "description": "Layout variant:\n- `default` — the full step row (headers + connectors).\n- `mobile` — a compact MUI-style bar for narrow screens: **Back**, a centered\n  progress (dots for `indicator=\"dot\"`, else a \"Step N of M\" caption), and\n  **Continue / Finish**. The step headers are hidden; put the active step's\n  panel in the `content` slot and swap it on `mdStepChange`."
    },
    {
      "name": "mode",
      "type": "'linear' | 'non-linear'",
      "default": "'linear'",
      "defaultValue": "linear",
      "options": [
        "linear",
        "non-linear"
      ],
      "mutable": false,
      "reflect": true,
      "attribute": "mode",
      "optional": false,
      "description": "- `linear` (default) — steps must be completed in order; future steps are\n  not reachable until the prior ones are done or optional (an `editable`\n  completed step can always be revisited).\n- `non-linear` — any step can be selected."
    },
    {
      "name": "active",
      "type": "number",
      "default": "0",
      "defaultValue": 0,
      "options": [],
      "mutable": true,
      "reflect": true,
      "attribute": "active",
      "optional": false,
      "description": "Index of the active step. Two-way bindable. Out-of-range values clamp."
    },
    {
      "name": "autoComplete",
      "type": "boolean",
      "default": "true",
      "defaultValue": true,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "auto-complete",
      "optional": false,
      "description": "When advancing (via `next()` or a step's built-in Continue button), mark the\nstep being left as `completed`. Default `true`. Turn off to fully control\ncompletion yourself."
    },
    {
      "name": "nav",
      "type": "boolean",
      "default": "true",
      "defaultValue": true,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "nav",
      "optional": false,
      "description": "Show the built-in **Back / Continue** navigation (default `true`) so users\nalways have a clear way to move through the flow:\n- vertical → the buttons sit under each active step (Material wizard style),\n- horizontal → a single button bar below the stepper.\nSet `nav=\"false\"` to drive navigation entirely yourself (clicking steps,\n`next()` / `prev()`, or your own controls)."
    },
    {
      "name": "readonly",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "readonly",
      "optional": false,
      "description": "Render the stepper as a **status trail**: something to read, not to drive.\nEvery step header stops being a button — no click, no keyboard activation,\nno ripple, no hover state layer, no tab stop, no `role=\"button\"` — while\n`aria-current` still says which stage it is on. Not the same as\n`nav=\"false\"`, which only hides the Back / Continue bar."
    },
    {
      "name": "nextDisabled",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "next-disabled",
      "optional": false,
      "description": "Disable the built-in **Continue / Finish** button without disabling Back or\nthe whole step. Bind this to your current step's form validity to gate\nadvancement declaratively (the most common wizard need). Step clicks and the\n`next()`/`goTo()` methods are unaffected — use `mode=\"linear\"` and/or\n`mdBeforeChange` for those."
    },
    {
      "name": "loading",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "loading",
      "optional": false,
      "description": "Put the built-in **Continue / Finish** button into a loading state (spinner +\ninteractive-disabled) and disable **Back**, for async submit-on-Continue\n(prevents double-submit). Toggle it around your `await` — typically inside an\n`mdBeforeChange` handler that `preventDefault()`s, does async work, then\ncommits by setting `active`."
    },
    {
      "name": "lazy",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "lazy",
      "optional": false,
      "description": "Only mount the **active** vertical step's content panel; inactive panels are\nremoved from layout and the a11y tree (no collapse animation). Use for\nwizards with heavy per-step content. Note: slotted custom elements stay\n*connected* in the light DOM — for full teardown, conditionally render the\ncontent in your framework."
    },
    {
      "name": "label",
      "type": "string",
      "default": "'Progress'",
      "defaultValue": "Progress",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "label",
      "optional": false,
      "description": "Accessible name for the navigation landmark."
    },
    {
      "name": "stepWord",
      "type": "string",
      "default": "'Step'",
      "defaultValue": "Step",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "step-word",
      "optional": false,
      "description": "Localized word for \"Step\" in each step's announced name (\"Step 2 of 4\")."
    },
    {
      "name": "ofWord",
      "type": "string",
      "default": "'of'",
      "defaultValue": "of",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "of-word",
      "optional": false,
      "description": "Localized word for \"of\" in each step's announced name (\"Step 2 of 4\")."
    },
    {
      "name": "completedWord",
      "type": "string",
      "default": "'completed'",
      "defaultValue": "completed",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "completed-word",
      "optional": false,
      "description": "Localized word announced for a completed step (\"…, completed\")."
    },
    {
      "name": "currentWord",
      "type": "string",
      "default": "'current'",
      "defaultValue": "current",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "current-word",
      "optional": false,
      "description": "Localized word announced for the current step (\"…, current\")."
    },
    {
      "name": "errorWord",
      "type": "string",
      "default": "'error'",
      "defaultValue": "error",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "error-word",
      "optional": false,
      "description": "Localized word announced for a step in error (\"…, error: message\")."
    },
    {
      "name": "optionalWord",
      "type": "string",
      "default": "'Optional'",
      "defaultValue": "Optional",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "optional-word",
      "optional": false,
      "description": "Caption + announced word for optional steps."
    },
    {
      "name": "nextLabel",
      "type": "string",
      "default": "'Continue'",
      "defaultValue": "Continue",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "next-label",
      "optional": false,
      "description": "Label for the built-in Continue button."
    },
    {
      "name": "backLabel",
      "type": "string",
      "default": "'Back'",
      "defaultValue": "Back",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "back-label",
      "optional": false,
      "description": "Label for the built-in Back button."
    },
    {
      "name": "finishLabel",
      "type": "string",
      "default": "'Finish'",
      "defaultValue": "Finish",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "finish-label",
      "optional": false,
      "description": "Label for the built-in Continue button on the last step."
    },
    {
      "name": "density",
      "type": "0 | -1 | -2 | -3 | -4",
      "default": "0",
      "defaultValue": 0,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "density",
      "optional": false,
      "description": "Local density rung. Drives the same `--md-sys-density-scale` signal that a\nglobal `data-density` ancestor sets, so a local value simply overrides the\ninherited one. 0 = default, -4 = ultra-compact."
    }
  ],
  "state": [
    {
      "name": "stepCount",
      "type": "inferred",
      "initializer": "0"
    },
