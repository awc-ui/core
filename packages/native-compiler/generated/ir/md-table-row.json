    "kind": "element",
    "tag": "Host",
    "attributes": [
      {
        "name": "class",
        "value": "{\n          'md-table-row': true,\n          [`md-table-row--${this.rowgroup}`]: true,\n          'md-table-row--selected': this.selected,\n          'md-table-row--disabled': this.disabled,\n          'md-table-row--clickable': this.clickable,\n          'md-table-row--highlight': this.highlight,\n          'md-table-row--expandable': this.expandable,\n          'md-table-row--expanded': this.expanded,\n        }"
      },
      {
        "name": "role",
        "value": "row"
      },
      {
        "name": "aria-disabled",
        "value": "this.disabled ? 'true' : null"
      },
      {
        "name": "aria-expanded",
        "value": "this.expandable ? (this.expanded ? 'true' : 'false') : null"
      },
      {
        "name": "tabindex",
        "value": "this.clickable && !this.disabled ? '0' : null"
      },
      {
        "name": "onClick",
        "value": "this.handleClick"
      },
      {
        "name": "onKeyDown",
        "value": "this.handleKeyDown"
      }
    ],
    "children": [
      {
        "kind": "text",
        "value": ""
      },
      {
        "kind": "element",
        "tag": "slot",
        "attributes": [
          {
            "name": "onSlotchange",
            "value": "() =>\n            // Cells slot into the ROW's shadow — cell additions/removals (e.g.\n            // a checkbox column appearing when selection turns on) are\n            // invisible to md-table without this relay (same non-composed\n            // slotchange rule as the rowgroups).\n            this.el.dispatchEvent(new CustomEvent('mdRowgroupSlotChange', { bubbles: true }))"
          }
        ],
        "children": []
      },
      {
        "kind": "text",
        "value": ""
      },
      {
        "kind": "expression",
        "source": "this.expandable && (\n          <div\n            class={{\n              'md-table-row__expanded': true,\n              'md-table-row__expanded--open': this.expanded,\n            }}\n            part=\"expanded\"\n            // A row may only own cells/headers — expose the detail panel as a\n            // full-width CELL (role=region here was an axe-confirmed content\n            // model violation once the panel opened).\n            role=\"cell\"\n            aria-colspan={String(\n              Array.from(this.el.children).filter((c) => c.tagName === 'MD-TABLE-CELL').length || 1,\n            )}\n            aria-hidden={!this.expanded ? 'true' : null}\n            // inert while collapsed: the height animation only clips the\n            // panel visually — without inert, focusable content inside stays\n            // tab-reachable while invisible.\n            inert={!this.expanded}\n          >\n            <div class=\"md-table-row__expanded-sizer\">\n              <div class=\"md-table-row__expanded-inner\">\n                <slot name=\"expanded\" />\n              </div>\n            </div>\n          </div>\n        )"
      },
      {
        "kind": "text",
        "value": ""
      }
    ]
  },
