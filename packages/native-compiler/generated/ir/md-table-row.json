{
  "tag": "md-table-row",
  "className": "MdTableRow",
  "properties": [
    {
      "name": "rowgroup",
      "type": "'head' | 'body' | 'foot'",
      "default": "'body'",
      "defaultValue": "body",
      "options": [
        "head",
        "body",
        "foot"
      ],
      "mutable": false,
      "reflect": true,
      "attribute": "rowgroup",
      "optional": false,
      "description": "Which rowgroup this row belongs to. Stamped automatically by the parent\n`<md-table>` (head / body / foot) — set it manually only when using rows\noutside a table."
    },
    {
      "name": "selected",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": true,
      "reflect": true,
      "attribute": "selected",
      "optional": false,
      "description": "Selected (highlighted) state. Reflected."
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "disabled",
      "optional": false,
      "description": "Disabled — row receives no hover/click handlers."
    },
    {
      "name": "selectable",
      "type": "boolean",
      "default": "true",
      "defaultValue": true,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "selectable",
      "optional": false,
      "description": "Whether this row counts as selectable (used by `<md-table>` selection coordination)."
    },
    {
      "name": "clickable",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "clickable",
      "optional": false,
      "description": "When true, treat the entire row as a button (Enter/Space activates `mdRowClick`)."
    },
    {
      "name": "value",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "value",
      "optional": false,
      "description": "Identifier attached to selection / click events. Defaults to row index."
    },
    {
      "name": "expandable",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "expandable",
      "optional": false,
      "description": "Render an \"expandable details\" zone toggleable via `toggle()`."
    },
    {
