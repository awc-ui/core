        "DOM_GLOBAL": {
          "status": "implemented",
          "api": "AWCFabMenuScope / authored id and anchor properties",
          "description": "A scoped native registry resolves authored anchor identity, pointer modality, focus and nonmodal outside activation.",
          "limitations": [
            "The scope is the native viewport; global document lookup is not exposed."
          ]
        },
        "DOM_LAYOUT": {
          "status": "implemented",
          "api": "Compose LayoutCoordinates",
          "description": "Actual transformed anchor bounds are tracked while open and drive logical-edge positioning and auto placement.",
          "limitations": [
            "Native dp replaces browser CSS pixels."
          ]
        },
        "DOM_QUERY": {
          "status": "implemented",
          "api": "Native authored layout-tree traversal / AWCSlotText / AWCSearchableLabelScope",
          "description": "Registered item descendants retain authored order for roving focus and typeahead. Explicit native text registration replaces DOM textContent.",
          "limitations": [
            "An arbitrary Compose content lambda cannot be introspected for text; use the supplied native searchable-label equivalent."
          ]
        },
        "SHADOW_DOM": {
          "status": "implemented",
          "api": "Composable default slot and nonmodal overlay layer",
          "description": "The retained native layer separates menu flow layout from authored items and anchor.",
