        "ANIMATION_FRAME": {
          "status": "implemented",
          "api": "AWCFabMenuController / Compose frame clock",
          "description": "Initial paint readiness, cancelable pending opens, delayed close commit and retained cycle completion follow native frame lifecycle.",
          "limitations": [
