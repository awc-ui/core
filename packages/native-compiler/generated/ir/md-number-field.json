    {
      "name": "value",
      "type": "number | null",
      "default": "null",
      "defaultValue": null,
      "options": [],
      "mutable": true,
      "reflect": false,
      "attribute": "value",
      "optional": false,
      "description": "The raw numeric value (`null` = empty). Never the formatted string —\nthe display text is derived via `Intl.NumberFormat`."
    },
    {
      "name": "locale",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "locale",
      "optional": false,
      "description": "BCP-47 locale for `Intl.NumberFormat` display/parsing ONLY (an\nIntl-computed value — translatable copy stays in the `*-label` props).\nEmpty = the runtime locale."
    },
    {
      "name": "formatOptions",
      "type": "Intl.NumberFormatOptions | string",
      "default": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "format-options",
      "optional": true,
      "description": "`Intl.NumberFormat` options for display formatting (currency, percent,\nunit, fraction digits…). Percent keeps Intl semantics: displayed 50% ⇔\nvalue 0.5.\n\nTakes either form, so a plain-HTML page needs no script:\n  - property — `el.formatOptions = { style: 'currency', currency: 'EUR' }`\n  - attribute — `format-options='{\"style\":\"currency\",\"currency\":\"EUR\"}'`\n\nMalformed JSON warns once and falls back to plain number formatting rather\nthan throwing: a broken attribute must not take the whole field down."
    },
    {
      "name": "min",
      "type": "number",
      "default": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "min",
      "optional": true,
      "description": "Lower bound. Interactive stepping always clamps to it."
    },
    {
      "name": "max",
      "type": "number",
      "default": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "max",
      "optional": true,
      "description": "Upper bound. Interactive stepping always clamps to it."
    },
    {
      "name": "step",
      "type": "number",
      "default": "1",
      "defaultValue": 1,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "step",
      "optional": false,
      "description": "Step for arrows / steppers / wheel."
    },
    {
      "name": "smallStep",
      "type": "number",
      "default": "0.1",
      "defaultValue": 0.1,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "small-step",
      "optional": false,
      "description": "Step while **Alt** is held."
    },
    {
      "name": "largeStep",
      "type": "number",
      "default": "10",
      "defaultValue": 10,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "large-step",
      "optional": false,
      "description": "Step while **Shift** is held."
    },
    {
      "name": "snapOnStep",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "snap-on-step",
      "optional": false,
      "description": "Snap stepped values to multiples of the active step (base = `min` when\ndefined, else 0). Snapping happens BEFORE clamping, so non-aligned\nbounds stay reachable. Regular steps snap directionally; Alt\n(`smallStep`) snaps to the nearest multiple."
    },
    {
      "name": "allowOutOfRange",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "allow-out-of-range",
      "optional": false,
      "description": "Let TYPED text exceed `min`/`max` unclamped (blur does not clamp).\nStep-based interactions (keys, buttons, wheel) always clamp."
    },
    {
      "name": "allowWheelScrub",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "allow-wheel-scrub",
      "optional": false,
      "description": "Enable wheel stepping while the inner input has focus."
    },
    {
      "name": "steppers",
      "type": "'inline' | 'split' | 'none'",
      "default": "'inline'",
      "defaultValue": "inline",
      "options": [
        "inline",
        "split",
        "none"
      ],
      "mutable": false,
      "reflect": false,
      "attribute": "steppers",
      "optional": false,
      "description": "Which stepper buttons render: inside the field, split around it, or none."
    },
    {
      "name": "incrementLabel",
      "type": "string",
      "default": "'Increment'",
      "defaultValue": "Increment",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "increment-label",
      "optional": false,
      "description": "Accessible name of the increment stepper (localizable)."
    },
    {
      "name": "decrementLabel",
      "type": "string",
      "default": "'Decrement'",
      "defaultValue": "Decrement",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "decrement-label",
      "optional": false,
      "description": "Accessible name of the decrement stepper (localizable)."
    },
    {
      "name": "valueMissingLabel",
      "type": "string",
      "default": "'Please enter a number.'",
      "defaultValue": "Please enter a number.",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "value-missing-label",
      "optional": false,
      "description": "Localized constraint-validation message shown when `required` is unmet.\n`errorText` still wins when set, so an app-supplied inline message and\nthe native bubble stay in agreement."
    },
    {
      "name": "reserveSupportingSpace",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "reserve-supporting-space",
      "optional": false,
      "description": "Always occupy the supporting-text line, even when there is no message, so\na validation error does not push the content below it down. Forwarded to\nthe embedded md-text-field."
    }
