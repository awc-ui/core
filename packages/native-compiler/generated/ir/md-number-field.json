      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "name",
      "optional": false,
      "description": "Form name. The raw numeric value submits as `String(value)`."
    },
    {
      "name": "density",
      "type": "0 | -1 | -2 | -3 | -4",
      "default": "0",
      "defaultValue": 0,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "density",
      "optional": false,
      "description": "Density forwarded to the text-field and applied to the steppers."
