{
  "tag": "md-toolbar",
  "className": "MdToolbar",
  "properties": [
    {
      "name": "variant",
      "type": "'docked' | 'floating'",
      "default": "'docked'",
      "defaultValue": "docked",
      "options": [
        "docked",
        "floating"
      ],
      "mutable": false,
      "reflect": true,
      "attribute": "variant",
      "optional": false,
      "description": "Toolbar type: docked (anchored to bottom) or floating (free-placed)"
    },
    {
      "name": "color",
      "type": "'standard' | 'vibrant'",
      "default": "'standard'",
      "defaultValue": "standard",
      "options": [
        "standard",
        "vibrant"
      ],
      "mutable": false,
      "reflect": true,
      "attribute": "color",
      "optional": false,
      "description": "Toolbar color scheme (bar chrome). Also applies the MD3 expressive **toolbar-only**\ntoken map to slotted `md-icon-button` — does not change standalone icon buttons elsewhere."
    },
    {
      "name": "layout",
      "type": "'horizontal' | 'vertical'",
      "default": "'horizontal'",
      "defaultValue": "horizontal",
      "options": [
        "horizontal",
        "vertical"
      ],
      "mutable": false,
      "reflect": true,
      "attribute": "layout",
      "optional": false,
      "description": "Layout direction for floating toolbar"
    },
    {
      "name": "alignment",
      "type": "'start' | 'center' | 'end' | 'space-between'",
      "default": "'start'",
      "defaultValue": "start",
      "options": [
        "start",
        "center",
        "end",
        "space-between"
      ],
      "mutable": false,
      "reflect": true,
      "attribute": "alignment",
      "optional": false,
      "description": "Alignment of items within the container"
    },
    {
      "name": "containerSemantics",
      "type": "'toolbar' | 'generic'",
      "default": "'toolbar'",
      "defaultValue": "toolbar",
      "options": [
        "toolbar",
        "generic"
      ],
      "mutable": false,
      "reflect": true,
      "attribute": "container-semantics",
      "optional": false,
      "description": "`toolbar` (default): `role=\"toolbar\"`, adaptive roving tabindex, and toolbar ARIA on the\nhost for web. `generic`: no toolbar role — plain container, no roving/arrow navigation.\nA generic container cannot be named (ARIA name-prohibited): an author-set `aria-label`/\n`aria-labelledby` is left in place but ignored by assistive tech, and a dev-mode\nwarning is logged."
    },
    {
      "name": "ariaLabelProp",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "aria-label",
      "optional": false,
      "description": "Accessible name for the toolbar (`containerSemantics=\"toolbar\"`). Provide a meaningful\nlabel describing the toolbar's purpose (e.g. \"Text formatting\"); prefer `aria-labelledby`\nwhen a visible label exists. When neither is set the toolbar is left unnamed (valid ARIA)\nand a dev-mode warning is logged."
    },
    {
      "name": "ariaLabelledby",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "aria-labelledby",
      "optional": false,
      "description": "ID(s) of visible label element(s); takes precedence over `aria-label` for the accessible name"
    },
    {
      "name": "density",
      "type": "0 | -1 | -2 | -3 | -4",
      "default": "0",
      "defaultValue": 0,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "density",
      "optional": false,
      "description": "Local density rung. Drives the same `--md-sys-density-scale` signal that a\nglobal `data-density` ancestor sets, so a local value simply overrides the\ninherited one. 0 = default, -4 = ultra-compact."
    }
  ],
