{
  "tag": "md-meter",
  "className": "MdMeter",
  "properties": [
    {
      "name": "value",
      "type": "number",
      "default": "0",
      "defaultValue": 0,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "value",
      "optional": false,
      "description": "Current value. Clamped into `[min, max]` for ARIA, geometry and formatting."
    },
    {
      "name": "min",
      "type": "number",
      "default": "0",
      "defaultValue": 0,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "min",
      "optional": false,
      "description": "Lower bound of the range."
    },
    {
      "name": "max",
      "type": "number",
      "default": "100",
      "defaultValue": 100,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "max",
      "optional": false,
      "description": "Upper bound of the range."
    },
    {
      "name": "label",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "label",
      "optional": false,
      "description": "Accessible name (`aria-label`) of the meter. Also the visible header label\nwhen `show-label` is set. Pass already-localized text."
    },
    {
      "name": "showLabel",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "show-label",
      "optional": false,
      "description": "Renders the `label` text in a header row above the track."
    },
    {
      "name": "showValue",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "show-value",
      "optional": false,
      "description": "Renders the formatted value in the header row above the track,\nend-aligned. The visible span is `aria-hidden` — screen readers announce\nthe same string via `aria-valuetext` on the host instead."
    },
    {
      "name": "valueText",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "value-text",
      "optional": false,
      "description": "Overrides the formatted value text entirely — both `aria-valuetext` and\nthe visible header value (when `show-value` is set). Use it when neither\nthe default percent format nor `formatOptions` can express the reading\n(e.g. \"3 of 10 seats\")."
    },
    {
      "name": "locale",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "locale",
      "optional": false,
      "description": "BCP-47 locale for `Intl.NumberFormat` output (the formatted value text).\nEmpty string = the runtime's default locale. This prop exists ONLY for\nIntl-computed output; translatable copy (`label`) is a plain text prop."
    },
    {
      "name": "formatOptions",
      "type": "Intl.NumberFormatOptions",
      "default": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "format-options",
      "optional": true,
      "description": "`Intl.NumberFormatOptions` for the value text (JS-only object prop — set\nit as a property, not an attribute). When provided, the CLAMPED value is\nformatted with it (`{ style: 'unit', unit: 'gigabyte' }`, currency, plain\nnumber…). When omitted, the value's position in the range is formatted as\na locale-aware percentage — the default, because a meter answers \"how\nfull\", which a bare number cannot say without its bounds alongside it."
    },
    {
      "name": "color",
      "type": "| 'primary'\n    | 'secondary'\n    | 'tertiary'\n    | 'error'\n    | 'success'\n    | 'warning'\n    | 'info'\n    | (string & {})",
      "default": "'primary'",
      "defaultValue": "primary",
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "color",
      "optional": false,
      "description": "Colour role applied to the fill and track. Any role name the THEME defines\nis accepted, not just the listed ones — the meter resolves `<name>` to the\n`--md-sys-color-<name>` / `-<name>-container` pair at runtime, so\n`color=\"brand\"` works as soon as a theme ships those tokens.\n\nThe default (`primary`) keeps md-progress-indicator's neutral look:\nprimary fill on a secondary-container track. Every other role paints\n`<role>` fill on a `<role>-container` track."
    },
    {
      "name": "variant",
      "type": "'linear' | 'circular'",
      "default": "'linear'",
      "defaultValue": "linear",
      "options": [
        "linear",
        "circular"
      ],
      "mutable": false,
      "reflect": true,
      "attribute": "variant",
      "optional": false,
      "description": "Shape of the reading.\n\n- `linear` (default) — a horizontal bar, full width of its container.\n- `circular` — a ring. `show-value` puts the value in the middle of it and\n  `show-label` captions it underneath, instead of the bar's header row.\n\nThe ring does NOT mirror under `dir=\"rtl\"`: it fills clockwise in every\nlocale, matching Material's circular progress (and a clock face)."
    },
    {
      "name": "size",
      "type": "number",
      "default": "48",
      "defaultValue": 48,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "size",
      "optional": false,
      "description": "Ring diameter in dp — circular only, ignored by the bar. Clamped to\n24…240 like md-progress-indicator, and tapered by density through the\n`--md-meter-size` hook."
    },
    {
      "name": "thickness",
      "type": "number",
      "default": "4",
      "defaultValue": 4,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "thickness",
      "optional": false,
      "description": "Track thickness in dp. Density-scaled (0.5px per rung), floored at 2px."
    },
    {
      "name": "density",
      "type": "0 | -1 | -2 | -3 | -4",
      "default": "0",
      "defaultValue": 0,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "density",
      "optional": false,
      "description": "Local density rung. Drives the same `--md-sys-density-scale` signal that a\nglobal `data-density` ancestor sets, so a local value simply overrides the\ninherited one. 0 = default, -4 = ultra-compact."
    }
  ],
  "state": [],
  "events": [],
  "methods": [],
  "slots": [],
  "cssParts": [
    {
      "name": "circular",
      "description": "The ring's box (circular variant only)"
    },
    {
      "name": "track",
      "description": "Background track / ring (the full range)"
    },
    {
      "name": "indicator",
      "description": "Value fill inside the track / the value arc"
    },
    {
      "name": "value",
      "description": "Header value text (rendered when `show-value`)"
    },
    {
      "name": "label",
      "description": "Header label text (rendered when `show-label`)"
    }
  ],
  "cssProperties": [
    {
      "name": "--md-meter-indicator-color",
      "description": "Fill colour (defaults to the `color` role)"
    },
    {
      "name": "--md-meter-track-color",
      "description": "Track background (defaults to the role's container)"
    },
    {
      "name": "--md-meter-track-shape",
      "description": "Track + fill corner radius (default corner-full pill)"
    },
    {
      "name": "--md-meter-height",
      "description": "Track thickness (overrides the `thickness` prop)"
    },
    {
      "name": "--md-meter-label-color",
      "description": "Header label text colour"
    },
    {
      "name": "--md-meter-value-color",
      "description": "Header value text colour"
    },
    {
      "name": "--md-meter-size",
      "description": "Ring diameter (circular variant)"
    }
  ],
  "render": {
    "kind": "element",
    "tag": "Host",
    "attributes": [
      {
        "name": "class",
        "value": "{\n          'md-meter': true,\n          'md-meter--with-header': withHeader,\n          'md-meter--circular': circular,\n        }"
      },
      {
        "name": "role",
        "value": "meter"
      },
      {
        "name": "aria-label",
        "value": "this.label || undefined"
      },
      {
        "name": "aria-valuemin",
        "value": "String(this.saneMin)"
      },
      {
        "name": "aria-valuemax",
        "value": "String(this.saneMax)"
      },
      {
        "name": "aria-valuenow",
        "value": "String(this.clampedValue)"
      },
      {
        "name": "aria-valuetext",
        "value": "text"
      },
      {
        "name": "style",
        "value": "this.hostStyle"
      }
    ],
    "children": [
      {
        "kind": "text",
        "value": ""
      },
      {
        "kind": "expression",
        "source": "circular && this.renderCircular(text)"
      },
      {
        "kind": "text",
        "value": ""
      },
      {
        "kind": "expression",
        "source": "withHeader && (\n          <div class=\"md-meter__header\" aria-hidden=\"true\">\n            {this.showLabel && (\n              <span class=\"md-meter__label\" part=\"label\">\n                {this.label}\n              </span>\n            )}\n            {this.showValue && (\n              <span class=\"md-meter__value\" part=\"value\">\n                {text}\n              </span>\n            )}\n          </div>\n        )"
      },
      {
        "kind": "text",
        "value": ""
      },
      {
        "kind": "expression",
        "source": "!circular && (\n          <div class=\"md-meter__track\" part=\"track\" aria-hidden=\"true\">\n            <div\n              class=\"md-meter__indicator\"\n              part=\"indicator\"\n              style={{ '--_fill-pct': `${this.percentage}%` }}\n            />\n          </div>\n        )"
      },
      {
        "kind": "text",
        "value": ""
      }
    ]
  },
