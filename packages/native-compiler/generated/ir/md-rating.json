          }
        ],
        "children": [
          {
            "kind": "text",
            "value": ""
          },
          {
            "kind": "expression",
            "source": "Array.from({ length: this.max }, (_, i) => this.renderItem(i))"
          },
          {
            "kind": "text",
            "value": ""
          }
        ]
      },
      {
        "kind": "text",
        "value": ""
      },
      {
        "kind": "expression",
        "source": "this.showValueLabel && (\n          <span class=\"md-rating__value-label\" part=\"value-label\" aria-hidden=\"true\">\n            {/* Hidden sizers reserve the widest label's width so the visible text\n                swapping on hover doesn't reflow the row (see valueLabelVariants). */}\n            {this.valueLabelVariants().map((t) => (\n              <span key={t} class=\"md-rating__value-label-sizer\" aria-hidden=\"true\">\n                {t}\n              </span>\n            ))}\n            <span class=\"md-rating__value-label-text\">\n              {this.resolveLabel(this.displayValue)}\n            </span>\n          </span>\n        )"
      },
      {
        "kind": "text",
        "value": ""
      }
