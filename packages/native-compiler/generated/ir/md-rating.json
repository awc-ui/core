      "type": "string",
      "default": "'star'",
      "defaultValue": "star",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "icon",
      "optional": false,
      "description": "Material Symbols glyph used for *filled* items."
    },
    {
      "name": "emptyIcon",
      "type": "string",
      "default": "'star'",
      "defaultValue": "star",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "empty-icon",
      "optional": false,
      "description": "Material Symbols glyph used for *empty* items."
    },
    {
      "name": "outlineEmpty",
      "type": "boolean",
      "default": "true",
      "defaultValue": true,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "outline-empty",
      "optional": false,
      "description": "Use the *filled* glyph for empty items as well, drawn with the\noutline-only color treatment — a solid silhouette outline behind\nthe fill."
    },
    {
      "name": "getLabel",
      "type": "(value: number) => string",
      "default": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "get-label",
      "optional": true,
      "description": "Optional label provider — `el.getLabel = (v) => \"${v} Stars\"`. Used\nby the hidden screen-reader text and the visible value label\nwhen `show-value-label` is set."
    },
    {
      "name": "showValueLabel",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "show-value-label",
      "optional": false,
      "description": "When true, render the current numeric value beside the items."
    },
    {
      "name": "ratingLabel",
      "type": "string",
      "default": "'Rating'",
      "defaultValue": "Rating",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "rating-label",
      "optional": false,
      "description": "Accessible name for the rating control.\n\nThe attribute is `rating-label`, NOT `aria-label-rating`. Anything starting\nwith `aria-` is parsed as an ARIA attribute, and `aria-label-rating` is not\none — so the previous name made axe report a CRITICAL `aria-valid-attr`\nviolation on every consumer that used the documented API. The value still\nends up as the host's accessible name; only the attribute spelling changed."
    },
    {
      "name": "name",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "name",
      "optional": false,
      "description": "Form name for native form participation."
    },
    {
      "name": "hover",
      "type": "'preview' | 'off'",
      "default": "'preview'",
      "defaultValue": "preview",
      "options": [
        "preview",
        "off"
      ],
      "mutable": false,
      "reflect": true,
      "attribute": "hover",
      "optional": false,
      "description": "Hover-preview behaviour:\n  - `'preview'` (default) — display the hovered value over the live one.\n  - `'off'` — no hover preview; `value` is the only signal."
    },
    {
      "name": "density",
      "type": "0 | -1 | -2 | -3 | -4",
      "default": "0",
      "defaultValue": 0,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "density",
      "optional": false,
      "description": "Local density rung. Drives the same `--md-sys-density-scale` signal that a\nglobal `data-density` ancestor sets, so a local value simply overrides the\ninherited one. 0 = default, -4 = ultra-compact."
    }
