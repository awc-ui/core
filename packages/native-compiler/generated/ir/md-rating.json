      "optional": false,
      "description": "Read-only — purely decorative; no interaction, no focus."
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": true,
