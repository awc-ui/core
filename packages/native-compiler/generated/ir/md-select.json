    },
    {
      "name": "supportingText",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "supporting-text",
      "optional": false,
      "description": "Supporting / helper text rendered below the field."
    },
    {
      "name": "density",
      "type": "0 | -1 | -2 | -3 | -4",
      "default": "0",
      "defaultValue": 0,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "density",
      "optional": false,
      "description": "Density forwarded to the inner field (0 = comfortable … -3 = compact)."
    },
    {
      "name": "clearable",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "clearable",
      "optional": false,
      "description": "Show a clear (✕) button in the trigger when a value is selected."
    },
    {
      "name": "matchTriggerWidth",
      "type": "boolean",
      "default": "true",
      "defaultValue": true,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "match-trigger-width",
      "optional": false,
      "description": "Match the dropdown width to the trigger width. When `false` the menu\nsizes to its content (down to its own min-width). Maps to `md-menu`'s\n`match-anchor-width`. Default `true` — the expected select behaviour."
    },
    {
      "name": "placement",
      "type": "'bottom-start' | 'bottom-end' | 'top-start' | 'top-end'",
      "default": "'bottom-start'",
      "defaultValue": "bottom-start",
      "options": [
        "bottom-start",
        "bottom-end",
        "top-start",
        "top-end"
      ],
      "mutable": false,
      "reflect": false,
      "attribute": "placement",
      "optional": false,
      "description": "Menu placement relative to the trigger — forwarded to `md-menu`."
    },
    {
      "name": "maxHeight",
      "type": "number | string",
      "default": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "max-height",
      "optional": true,
      "description": "Cap the dropdown height. When the options exceed it the list scrolls\nvertically with top/bottom edge shadows. A number is pixels; any CSS\nlength is passed through (e.g. `'50vh'`). Forwarded to `md-menu`'s\n`max-height`."
    },
    {
      "name": "options",
      "type": "SelectOptionInit[] | string",
      "default": "[]",
      "defaultValue": [],
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "options",
      "optional": false,
      "description": "Programmatic options. Slotted `md-select-option` children take precedence.\n\nAccepts the array (property) or a **JSON string** (attribute), so a\nplain-HTML page can declare its data inline instead of reaching for a\nscript. Malformed JSON degrades to an empty list with a console warning."
    },
    {
      "name": "virtualize",
      "type": "'auto' | 'always' | 'never'",
      "default": "'auto'",
      "defaultValue": "auto",
      "options": [
        "auto",
        "always",
        "never"
      ],
      "mutable": false,
      "reflect": false,
      "attribute": "virtualize",
      "optional": false,
      "description": "Virtualization mode for large option lists (backed by a WASM data engine):\n  - `'auto'` (default): virtualize only above `VIRTUALIZE_THRESHOLD` rows.\n  - `'always'`: always virtualize the `options` / `loadOptions` dataset.\n  - `'never'`: keep the classic DOM rendering regardless of size.\nVirtualized rows render label + selection only (no per-row icon /\nsupporting text) and assume a uniform row height."
    },
    {
      "name": "filterable",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "filterable",
      "optional": false,
      "description": "Show a search field in the menu header.\n\nA plain list filters client-side on label / supporting text; a virtualized\none filters inside the WASM engine. Closing the menu clears the query."
    },
    {
      "name": "filterMode",
      "type": "FilterMode",
      "default": "'substring'",
      "defaultValue": "substring",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "filter-mode",
      "optional": false,
      "description": "Filter strategy used by `filterable` / `setQuery`."
    },
    {
      "name": "rowHeight",
      "type": "number",
      "default": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "row-height",
      "optional": true,
      "description": "Fixed virtualized row height (px). Auto-measured from the first row if unset."
    },
    {
      "name": "name",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "name",
      "optional": false,
      "description": "Form field name. The selected value is submitted under this name."
    },
    {
      "name": "searchPlaceholder",
      "type": "string",
      "default": "'Search…'",
      "defaultValue": "Search…",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "search-placeholder",
      "optional": false,
      "description": "Placeholder for the in-menu filter field (`filterable`)."
    },
    {
      "name": "filterLabel",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "filter-label",
      "optional": false,
      "description": "Accessible name for the filter field. Falls back to `Filter <label>`."
    },
    {
      "name": "noResultsText",
      "type": "string",
      "default": "'No results'",
