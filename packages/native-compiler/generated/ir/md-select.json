{
  "tag": "md-select",
  "className": "MdSelect",
  "properties": [
    {
      "name": "valueMissingLabel",
      "type": "string",
      "default": "'Please select an item in the list.'",
      "defaultValue": "Please select an item in the list.",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "value-missing-label",
      "optional": false,
      "description": "Localized constraint-validation message shown when `required` is unmet.\n\nA prop rather than a hardcoded string, matching md-time-picker's\n`value-missing-label`: components stay i18n-engine-agnostic and the\nconsumer localizes through its own dictionary. Native inputs get their\nmessage from the browser's locale for free; a form-associated custom\nelement supplies its own, so leaving this hardcoded would ship an\nEnglish-only form to every locale."
    },
    {
      "name": "reserveSupportingSpace",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "reserve-supporting-space",
      "optional": false,
      "description": "Always occupy the supporting-text line, even when there is no message, so a\nvalidation error does not push the content below it down. Forwarded to the\nembedded md-text-field. See that component for why it is opt-in."
    },
    {
      "name": "variant",
      "type": "'filled' | 'outlined'",
      "default": "'outlined'",
      "defaultValue": "outlined",
      "options": [
        "filled",
        "outlined"
      ],
      "mutable": false,
      "reflect": true,
      "attribute": "variant",
      "optional": false,
      "description": "Visual variant — forwarded to the inner `md-text-field`."
    },
    {
      "name": "label",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "label",
      "optional": false,
      "description": "Floating label / accessible name."
