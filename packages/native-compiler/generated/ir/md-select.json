      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "placeholder",
      "optional": false,
      "description": "Placeholder shown when no value is selected."
    },
    {
      "name": "value",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": true,
      "reflect": true,
      "attribute": "value",
      "optional": false,
      "description": "Selected option value. Empty string = nothing selected."
