{
  "tag": "md-accordion",
  "className": "MdAccordion",
  "properties": [
    {
      "name": "variant",
      "type": "'filled' | 'outlined'",
      "default": "'filled'",
      "defaultValue": "filled",
      "options": [
        "filled",
        "outlined"
      ],
      "mutable": false,
      "reflect": true,
      "attribute": "variant",
      "optional": false,
      "description": "Visual variant. Both share the same expand/collapse mechanics.\n- `filled` (default) — each item is a tonal surface tile.\n- `outlined` — items share a single rounded chassis with an outline."
    },
    {
      "name": "density",
      "type": "0 | -1 | -2 | -3 | -4",
      "default": "0",
      "defaultValue": 0,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "density",
      "optional": false,
      "description": "Density scale from `0` (default, 64 px minimum header) through `-4`\n(48 px). Each rung reduces the minimum by 4 px; content may be taller."
    },
    {
      "name": "elevation",
      "type": "0 | 1 | 2 | 3 | 4 | 5",
      "default": "0",
      "defaultValue": 0,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "elevation",
      "optional": false,
      "description": "MD3 elevation level applied to the surface — `0` (default, flat)\nthrough `5` (highest). In the `filled` variant each item gets its\nown shadow; in the `outlined` variant the shadow is drawn on the\nshared chassis. Expanded items lift to the next elevation level\nfor an expressive \"lift off the page\" affordance."
    },
    {
      "name": "reorderable",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "reorderable",
      "optional": false,
      "description": "Allow drag-to-reorder of items via the leading drag handles. Items\ncan also be reordered with `Alt + ArrowUp / ArrowDown` while the\nheader is focused. Disabled items can't be moved."
    },
    {
      "name": "floating",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "floating",
      "optional": false,
      "description": "Render the accordion as a free-floating panel that can be dragged\nanywhere on the screen via the top drag-bar. The panel uses\n`position: fixed` and translates via CSS transform, so it lifts\nout of normal document flow."
    },
    {
      "name": "initialX",
      "type": "number",
      "default": "24",
      "defaultValue": 24,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "initial-x",
      "optional": false,
      "description": "Initial X translation (px) for floating panels — measured in\nPHYSICAL viewport coordinates from the top-left corner of the\nviewport, so a positive value always moves the panel to the\nright regardless of writing direction (LTR or RTL). Default: 24."
    },
    {
      "name": "initialY",
      "type": "number",
      "default": "24",
      "defaultValue": 24,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "initial-y",
      "optional": false,
      "description": "Initial Y translation (px) for floating panels — measured in\nphysical viewport coordinates from the top-left corner. Default: 24."
    },
    {
      "name": "bringToFront",
      "type": "boolean",
      "default": "true",
      "defaultValue": true,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "bring-to-front",
      "optional": false,
      "description": "When a floating accordion starts being dragged, bring it to the\nfront by bumping `z-index`. Disable if you manage stacking\nyourself."
    },
    {
      "name": "exclusive",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "exclusive",
      "optional": false,
      "description": "Whether only one item may be expanded at a time. When `true`,\nexpanding an item collapses any other expanded item."
    },
    {
      "name": "keepOneExpanded",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "keep-one-expanded",
      "optional": false,
      "description": "Require at least one item to remain expanded. APG variant: the\nimplementation does not permit the currently-open panel to be\ncollapsed when doing so would leave zero panels open. The locked-\nopen button advertises `aria-disabled=\"true\"`. Pairs naturally\nwith `exclusive` to enforce \"exactly one panel is always open\"."
    },
    {
      "name": "headingLevel",
      "type": "1 | 2 | 3 | 4 | 5 | 6",
      "default": "3",
      "defaultValue": 3,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "heading-level",
      "optional": false,
      "description": "ARIA heading level for each item's heading wrapper (`<h1>`–`<h6>`).\nPick the value matching the page's information architecture — e.g.\n`2` inside a top-level page section, `4` deep inside a card. APG:\n\"aria-level that is appropriate for the information architecture\nof the page\". Default `3`."
    },
    {
      "name": "region",
      "type": "'auto' | 'always' | 'never'",
      "default": "'auto'",
      "defaultValue": "auto",
      "options": [
        "auto",
        "always",
        "never"
      ],
      "mutable": false,
      "reflect": true,
      "attribute": "region",
      "optional": false,
      "description": "Region-role policy for panels:\n- `auto` (default) — applies `role=\"region\"` only when the item\n  count is at or below `region-threshold`, otherwise downgrades\n  to `role=\"group\"` to avoid landmark proliferation (per APG\n  recommendation for accordions with more than ~6 panels).\n- `always` — every panel is a landmark region.\n- `never` — no panel carries a region role (still labelled via\n  `aria-labelledby` though)."
    },
    {
      "name": "regionThreshold",
      "type": "number",
      "default": "6",
      "defaultValue": 6,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "region-threshold",
      "optional": false,
      "description": "Threshold above which `region=\"auto\"` downgrades panel roles\nfrom `region` to `group`. APG suggests ~6."
    },
    {
      "name": "transition",
      "type": "'expressive' | 'standard' | 'fade' | 'collapse' | 'none'",
      "default": "'expressive'",
      "defaultValue": "expressive",
      "options": [
        "expressive",
        "standard",
        "fade",
        "collapse",
        "none"
      ],
      "mutable": false,
      "reflect": true,
      "attribute": "transition",
      "optional": false,
      "description": "Motion preset applied when items expand and collapse. The prop\nis reflected so the item CSS can pick it up via\ndirect-owner presentation attributes on each item.\n\n- `expressive` (default) — coordinated emphasized height and corner\n   motion (350ms open / 250ms close), with spring-spatial chevron\n   rotation and a leading-icon FILL-axis swap. Surface tone,\n   opacity and elevation use shorter, non-overshooting effects.\n   Content is revealed in place.\n- `standard` — MD3 standard easing (symmetric `emphasized`) with\n   no spring overshoot. Container morph still happens. The\n   \"neutral\" preset — good default for dense product UI.\n- `fade` — content fades in/out alongside the height animation\n   using shorter `standard` easing. Chevron rotates without a\n   spring. Best for content-heavy panels (forms, long copy)\n   where the motion should be unobtrusive.\n- `collapse` — height-led disclosure with `ease-out` on open and\n   `ease-in` on close. Corners follow the same timing; no spring\n   overshoot or content fade.\n- `none` — disables every transition (instant snap). Useful for\n   automated tests, screenshot harnesses, or environments where\n   motion is undesirable."
    },
    {
      "name": "defaultExpanded",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "default-expanded",
      "optional": false,
      "description": "Comma-separated list of item indexes that should be expanded on\nfirst render. Items with `expanded` set in their own attribute\nalso count."
    }
  ],
  "state": [
    {
      "name": "chassisX",
      "type": "inferred",
      "initializer": "0"
    },
    {
      "name": "chassisY",
      "type": "inferred",
      "initializer": "0"
    },
    {
      "name": "chassisDragging",
      "type": "inferred",
      "initializer": "false"
    },
    {
      "name": "dropPlaceholder",
      "type": "{ top: number; height: number } | null",
      "initializer": "null"
    }
  ],
  "events": [
    {
      "name": "mdToggle",
      "detail": "{\n    index: number;\n    expanded: boolean;\n    expandedIndices: number[];\n  }",
      "cancelable": true,
      "bubbles": true,
      "composed": true
    },
    {
      "name": "mdReorder",
