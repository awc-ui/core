      "mutable": false,
      "reflect": false,
      "attribute": "gradient",
      "optional": false,
      "description": "Fill each slice with a gradient running outward from the centre, for depth.\nPurely decorative — it changes nothing about what a slice means, which is\nwhy it is off by default."
