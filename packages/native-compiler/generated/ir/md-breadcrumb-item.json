      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "collapsed",
      "optional": false,
      "description": "Marks this item as part of the collapsed middle section. Usually\nset by the parent `md-breadcrumbs` when `max-items` is exceeded.\nDeclared as a public prop (instead of just a `data-*` attribute) so\nStencil re-renders the item when the parent toggles its visibility."
    },
