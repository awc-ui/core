      "defaultValue": 0,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "item-index",
      "optional": false,
      "description": "Position in the trail (0-indexed). Set automatically by the parent\n`md-breadcrumbs`. Exposed as a reactive prop so children re-render\nthe leading separator when their position changes."
    },
    {
      "name": "itemTotal",
