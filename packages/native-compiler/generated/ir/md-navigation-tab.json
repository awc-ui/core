{
  "tag": "md-navigation-tab",
  "className": "MdNavigationTab",
  "properties": [
    {
      "name": "active",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": true,
      "reflect": true,
      "attribute": "active",
      "optional": false,
      "description": "Whether this destination is currently selected."
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "disabled",
      "optional": false,
      "description": "Disable interaction. Disabled tabs are skipped by keyboard nav."
    },
    {
      "name": "softDisabled",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "soft-disabled",
      "optional": false,
      "description": "Soft-disable the destination: it cannot be activated or selected and is\nannounced as `aria-disabled`, but — unlike `disabled` — it stays\nkeyboard-reachable (the bar's arrow-key tour still lands on it) so\nscreen-reader users can discover a temporarily-unavailable destination."
    },
    {
      "name": "label",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "label",
      "optional": false,
      "description": "Destination label rendered below the icon."
    },
    {
      "name": "icon",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "icon",
      "optional": false,
      "description": "Material Symbols / Material Icons name shown when inactive.\nPer M3 spec, inactive destinations use the outlined variant."
    },
    {
      "name": "activeIcon",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "active-icon",
      "optional": false,
      "description": "Material Symbols / Material Icons name shown when active.\nPer M3 spec, active destinations use the filled variant.\nDefaults to `icon` when empty (the same glyph in both states)."
    },
    {
      "name": "badge",
      "type": "boolean",
      "default": "false",
      "defaultValue": false,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "badge",
      "optional": false,
      "description": "Show a small \"notification dot\" badge in the top-right of the icon.\nUse when there are new items but no count is needed."
    },
    {
      "name": "badgeValue",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "badge-value",
      "optional": false,
      "description": "Numeric / textual badge value (e.g. `\"3\"`, `\"99+\"`, `\"New\"`).\nWhen set, the badge expands to a pill that accommodates the value\n(M3 calls this the \"large badge\" variant)."
    },
    {
      "name": "badgeMax",
      "type": "number",
      "default": "999",
      "defaultValue": 999,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "badge-max",
      "optional": false,
      "description": "Maximum value rendered when `badgeValue` is purely numeric. Values\ngreater than this render as `\"{max}+\"` (e.g. `99+`). Set to `0` to\ndisable the cap."
    },
    {
      "name": "href",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "href",
      "optional": false,
      "description": "When set, activating the tab also navigates to the URL — useful when\neach destination is a full route. For SPA routing, intercept the native\n`click` (call `preventDefault()`) or listen to the bar's `mdChange`;\nnavigation only occurs when `href` is truthy and the click isn't prevented."
    },
    {
      "name": "target",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "target",
      "optional": false,
      "description": "Link target (forwarded only when `href` is set)."
    },
    {
      "name": "labelBehavior",
      "type": "MdNavigationTabLabelBehavior",
      "default": "'always'",
      "defaultValue": "always",
      "options": [],
      "mutable": true,
      "reflect": false,
      "attribute": "label-behavior",
      "optional": false,
      "description": "Label visibility for this tab. Inherits from the parent\n`md-navigation-bar`'s `label-behavior` when not set.\n\nNot reflected as an attribute — the parent bar uses\n`getAttribute('label-behavior')` to detect *explicit* author\noverrides, so reflecting the default would defeat that signal."
    },
    {
      "name": "density",
      "type": "0 | -1 | -2 | -3 | -4",
      "default": "0",
      "defaultValue": 0,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "density",
      "optional": false,
      "description": "Local density rung. Drives the same `--md-sys-density-scale` signal that a\nglobal `data-density` ancestor sets, so a local value simply overrides the\ninherited one. 0 = default, -4 = ultra-compact."
    }
  ],
