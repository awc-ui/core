{
  "tag": "md-badge",
  "className": "MdBadge",
  "properties": [
    {
      "name": "variant",
      "type": "'small' | 'large'",
      "default": "'large'",
      "defaultValue": "large",
      "options": [
        "small",
        "large"
      ],
