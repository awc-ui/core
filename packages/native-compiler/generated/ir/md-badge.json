    "tag": "Host",
    "attributes": [
      {
        "name": "class",
        "value": "{\n          'md-badge': true,\n          'md-badge--small': isSmall,\n          'md-badge--large': !isSmall,\n          // Only the circular case gets a class — `rect` is the corner anchor\n          // the base rule already is, so a `--rect` class would name nothing.\n          'md-badge--circle': this.shape === 'circle',\n          'md-badge--has-content': hasContent,\n        }"
      },
      {
        "name": "role",
        "value": "status"
      },
      {
        "name": "aria-label",
        "value": "this.accessibleLabel"
      }
    ],
    "children": [
      {
        "kind": "text",
        "value": ""
      },
      {
        "kind": "expression",
        "source": "!isSmall && (\n          <slot name=\"icon\" onSlotchange={this.readSlottedIcon}>\n            {this.icon ? (\n              <span class=\"md-badge__icon material-symbols-outlined\" part=\"icon\" aria-hidden=\"true\">\n                {this.icon}\n              </span>\n            ) : null}\n          </slot>\n        )"
      },
      {
        "kind": "text",
        "value": ""
      },
      {
        "kind": "expression",
        "source": "hasLabel && (\n          <span class=\"md-badge__label\" part=\"label\">\n            {display}\n          </span>\n        )"
      },
      {
        "kind": "text",
        "value": ""
      }
    ]
  },
