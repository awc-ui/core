      "optional": false,
      "description": "Text or number to display (large variant only, max 4 visible characters)"
    },
    {
      "name": "max",
      "type": "number",
      "default": "999",
      "defaultValue": 999,
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "max",
      "optional": false,
      "description": "Numeric threshold. When the parsed value exceeds this, the badge\nshows `{max}+` (e.g. `999+`). Ignored for non-numeric values."
    },
    {
      "name": "icon",
      "type": "string",
      "default": "''",
      "defaultValue": "",
      "options": [],
      "mutable": false,
      "reflect": false,
      "attribute": "icon",
      "optional": false,
      "description": "Material Symbols icon name (large variant only, e.g. `\"error\"`)"
    },
    {
      "name": "shape",
      "type": "'rect' | 'circle'",
      "default": "'rect'",
      "defaultValue": "rect",
      "options": [
        "rect",
        "circle"
      ],
      "mutable": false,
      "reflect": true,
      "attribute": "shape",
      "optional": false,
      "description": "The SHAPE of the thing the badge is anchored to.\n\nThe badge pins to its containing block's top-inline-end CORNER and\ntranslates itself onto it, which is right for a `rect` host — a button, a\ntab, a tile. On a `circle` it is wrong for the same reason it is wrong for\n`md-status-dot`: a circle's bounding-box corner lies outside the visible\nshape, so the badge floats clear of the avatar with nothing behind it.\n\n`circle` anchors it to the 45° point on the rim instead — the top-trailing\narc, where a count badge on an avatar belongs. Percentage insets, so it is\ncorrect at every avatar size without being told the size, and it needs no\nhand-tuned offsets at the call site.\n\n`rect` stays the default: changing it would move every badge already\nsitting on a button or a tab."
    },
    {
      "name": "density",
      "type": "0 | -1 | -2 | -3 | -4",
      "default": "0",
      "defaultValue": 0,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "density",
      "optional": false,
      "description": "Local density rung. Drives the same `--md-sys-density-scale` signal that a\nglobal `data-density` ancestor sets, so a local value simply overrides the\ninherited one. 0 = default, -4 = ultra-compact."
    }
  ],
