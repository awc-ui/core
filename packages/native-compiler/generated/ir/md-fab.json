    {
      "name": "extended",
      "type": "boolean",
      "default": "",
      "options": [],
      "mutable": true,
      "reflect": true,
      "attribute": "extended",
      "optional": true,
      "description": "Whether the FAB shows its label (extended) or collapses to an icon-only\ncircle. Leave unset for the default behaviour (extended whenever a `label`\nis provided). Set explicitly — e.g. by `<md-navigation-rail>` on\ncollapse — to morph between extended and icon-only: the label width/opacity\nsprings closed and the container shrinks to a 56px circle, while the label\nstays available as the accessible name."
    },
    {
      "name": "density",
      "type": "0 | -1 | -2 | -3 | -4",
      "default": "0",
      "defaultValue": 0,
      "options": [],
      "mutable": false,
      "reflect": true,
      "attribute": "density",
      "optional": false,
      "description": "Local density rung. Drives the same `--md-sys-density-scale` signal that a\nglobal `data-density` ancestor sets, so a local value simply overrides the\ninherited one. 0 = default, -4 = ultra-compact."
    }
  ],
