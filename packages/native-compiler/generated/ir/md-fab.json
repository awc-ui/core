    "kind": "element",
    "tag": "Host",
    "attributes": [
      {
        "name": "class",
        "value": "{\n          'md-fab': true,\n          [`md-fab--${this.variant}`]: true,\n          // Fixed circular sizes apply only to FABs that never carry a label.\n          [`md-fab--${this.size}`]: !hasLabel,\n          'md-fab--extended': hasLabel && isExtended,\n          'md-fab--collapsed': hasLabel && !isExtended,\n          'md-fab--with-icon': hasIcon || this.hasSlottedIcon,\n          'md-fab--lowered': this.lowered,\n          'md-fab--menu-icon': overridesSlottedIcon,\n          'md-fab--disabled': this.disabled || this.softDisabled,\n        }"
      },
      {
        "name": "role",
        "value": "button"
      },
      {
        "name": "aria-label",
        "value": "hasLabel && !hasExplicitAriaLabel ? this.label : undefined"
      },
      {
        "name": "aria-disabled",
        "value": "isEffectivelyDisabled ? 'true' : 'false'"
      },
      {
        "name": "tabindex",
        "value": "this.disabled ? '-1' : '0'"
      },
      {
        "name": "onClick",
        "value": "this.handleClick"
      },
      {
        "name": "onKeyDown",
        "value": "this.handleKeyDown"
      }
    ],
    "children": [
      {
        "kind": "text",
        "value": ""
      },
      {
        "kind": "expression",
        "source": "this.ripple && <md-ripple disabled={isEffectivelyDisabled}></md-ripple>"
      },
      {
        "kind": "text",
        "value": ""
      },
      {
        "kind": "element",
        "tag": "span",
        "attributes": [
          {
            "name": "class",
            "value": "md-fab__state-layer"
          },
          {
            "name": "part",
            "value": "state-layer"
          },
          {
            "name": "aria-hidden",
            "value": "true"
          }
        ],
        "children": []
      },
      {
        "kind": "text",
        "value": ""
      },
      {
        "kind": "element",
        "tag": "slot",
        "attributes": [
          {
            "name": "name",
            "value": "icon"
          }
        ],
        "children": [
          {
            "kind": "text",
            "value": ""
          },
          {
            "kind": "expression",
            "source": "hasIcon && <span class=\"md-fab__icon material-symbols-outlined\" part=\"icon\" aria-hidden=\"true\">{this.menuIcon || this.icon}</span>"
          },
          {
            "kind": "text",
            "value": ""
          }
        ]
      },
      {
        "kind": "text",
        "value": ""
      },
      {
        "kind": "expression",
        "source": "overridesSlottedIcon && <span class=\"md-fab__icon material-symbols-outlined\" part=\"icon\" aria-hidden=\"true\">{this.menuIcon}</span>"
      },
      {
        "kind": "text",
        "value": ""
      },
      {
        "kind": "expression",
        "source": "hasLabel && <span class=\"md-fab__label\" part=\"label\" aria-hidden={!isExtended ? 'true' : undefined}>{this.label}</span>"
      },
      {
        "kind": "text",
        "value": ""
      }
    ]
  },
