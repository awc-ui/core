  "name": "FAB",
  "category": "Actions",
  "parent": null,
  "description": "The single most prominent action on a screen. Floats above the UI in seven color mappings and three sizes, and morphs between an icon-only circle and an extended pill that carries a label.",
  "swiftPath": "packages/native-ios/Sources/AWCUI/Generated/Components.swift",
  "kotlinPath": "packages/native-android/src/main/java/dev/awc/nativeui/generated/Components.kt",
  "irPath": "packages/native-compiler/generated/ir/md-fab.json",
  "sources": {
    "stencil": "packages/core/src/components/md-fab/md-fab.tsx",
    "css": "packages/core/src/components/md-fab/md-fab.css",
    "swift": "packages/native-ios/Sources/AWCUI/Generated/Components.swift",
    "kotlin": "packages/native-android/src/main/java/dev/awc/nativeui/generated/Components.kt",
    "swiftImplementation": "packages/native-ios/Sources/AWCUI/AWCNativeView.swift",
    "kotlinImplementation": "packages/native-android/src/main/java/dev/awc/nativeui/AWCComponent.kt"
  },
