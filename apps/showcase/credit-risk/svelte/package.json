{
  "name": "@awc-ui/showcase-credit-risk-svelte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Credit Risk Console \u2014 SvelteKit build (prerendered, hydrating, locale switched in place)",
  "scripts": {
    "sync-runtime": "node scripts/sync-runtime.mjs",
