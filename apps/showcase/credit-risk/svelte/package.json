{
  "name": "@awc-ui/showcase-credit-risk-svelte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Credit Risk Console — Svelte build (a single-page application: Vite, a hand-rolled client router, no meta-framework)",
  "scripts": {
    "sync-runtime": "node scripts/sync-runtime.mjs",
    "dev": "pnpm sync-runtime && vite",
    "build": "pnpm sync-runtime && vite build && node scripts/fan-out-routes.mjs",
    "preview": "vite preview",
    "serve": "node scripts/serve-dist.mjs",
    "lint": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "verify": "node scripts/verify-browser.mjs"
  },
  "dependencies": {
    "@awc-ui/core": "workspace:*",
    "@awc-ui/showcase-kit": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@types/node": "^20.14.0",
    "puppeteer": "^24.0.0",
    "svelte": "^4.2.19",
    "svelte-check": "^3.8.6",
    "typescript": "^5.4.0",
    "vite": "^5.4.11"
  }
}
