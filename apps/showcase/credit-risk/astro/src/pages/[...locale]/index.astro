---
/**
 * The overview, at `/astro/` and `/astro/{ro,ar}/`.
 *
 * `[...locale]` is a REST parameter, which is how Astro expresses "this segment
 * may be absent". `localeParams()` returns one entry with `locale: undefined` —
 * the unprefixed default — plus one per prefixed locale, so the same file
 * produces all three trees.
 */
import { getPortfolioTotals, REPORTING_DATE } from '@awc-ui/showcase-kit/data';
import { localeParams, resolveLocale, useT } from '../../lib/i18n';
import { route } from '@awc-ui/showcase-kit/credit-risk';
import { localeHref } from '../../lib/i18n';
import Base from '../../layouts/Base.astro';
import Shell from '../../components/Shell.astro';
import Overview from '../../components/screens/Overview.astro';

export function getStaticPaths() {
  return localeParams();
}

const locale = resolveLocale(Astro.params.locale);
const t = useT(locale);
const totals = getPortfolioTotals();
---

<Base locale={locale}>
  <Shell
    locale={locale}
    title={t('screen.overview.title')}
    subtitle={t('screen.overview.subtitle', { date: t.formatDate(REPORTING_DATE, 'long') })}
  >
    <Fragment slot="aside">
      <md-chip
        variant="assist"
        appearance="outlined"
        icon="account_balance"
        label={t('common.of', { count: totals.counterpartyCount, total: totals.facilityCount })}
        title={`${t('kpi.counterparties')} / ${t('kpi.facilities')}`}></md-chip>
      {/* The badge is a SIBLING of the button, not slotted into it. md-badge
          anchors absolutely and translates itself past its host's corner;
          md-button sets `overflow: hidden` with no accommodation for that, so
          a slotted badge is sliced in half. (md-icon-button has a `--has-badge`
          hook that switches overflow to visible; md-button has none — reported
          upstream.) The trailing-icon slot would also force it into the 18px
          icon box.

          With the badge outside, the button no longer contains the count, so it
          needs an explicit accessible name that does. */}
      <span class="badge-anchor">
        <md-button
          variant="tonal"
          size="sm"
          icon="warning"
          href={localeHref(locale, route.watchlist())}
          aria-label={`${t('kpi.watchlist')}, ${totals.watchlistCount}`}
        >
          {t('kpi.watchlist')}
        </md-button>
        <md-badge value={String(totals.watchlistCount)}></md-badge>
      </span>
    </Fragment>

    <Overview locale={locale} />
  </Shell>
</Base>
