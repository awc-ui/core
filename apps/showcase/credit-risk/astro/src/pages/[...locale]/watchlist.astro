---
import { getWatchlist } from '@awc-ui/showcase-kit/data';
import { route } from '@awc-ui/showcase-kit/credit-risk';
import { localeParams, resolveLocale, useT } from '../../lib/i18n';
import Base from '../../layouts/Base.astro';
import Shell from '../../components/Shell.astro';
import WatchlistScreen from '../../components/screens/Watchlist.astro';

export function getStaticPaths() {
  return localeParams();
}

const locale = resolveLocale(Astro.params.locale);
const t = useT(locale);
const signals = getWatchlist();

/**
 * The count chip's text is rebuilt client-side as filters change, so the
 * template travels with it rather than being reassembled from a translated
 * string the script would have to parse back apart.
 */
const countTemplate = t('common.showing', { shown: '%shown%', total: signals.length });
---

<Base locale={locale}>
  <Shell
    locale={locale}
    title={t('screen.watchlist.title')}
    subtitle={t('screen.watchlist.subtitle', {
      signals: signals.length,
      counterparties: new Set(signals.map((s) => s.counterpartyId)).size,
    })}
  >
    <Fragment slot="aside">
      <md-chip
        data-count
        data-count-template={countTemplate}
        variant="assist"
        appearance="filled"
        color="error"
        icon="crisis_alert"
        label={t('common.showing', { shown: signals.length, total: signals.length })}></md-chip>
    </Fragment>

    <WatchlistScreen locale={locale} />
  </Shell>
</Base>
