---
/**
 * The counterparty table — the overview's book, and every sector screen's.
 *
 * NO PAGINATION HERE, unlike the React build, and that is a decision rather
 * than a gap. React pages because paging is cheap when you re-render: it keeps
 * the DOM small and the readout honest. This build renders once, on the server,
 * and the whole book is twenty-four rows. Server-rendering all of them and then
 * hiding twenty behind a control that needs JavaScript to work would make the
 * page WORSE with JavaScript off, which is backwards for a static build. The
 * table scrolls; every row is in the HTML; every row is findable with the
 * browser's own text search.
 *
 * SORTING IS PROGRESSIVE. Rows arrive sorted by exposure descending — the order
 * a credit officer wants first — and that survives with JavaScript off. When
 * the runtime lands, `mdSortChange` reorders the rows that are already there.
 * The comparison uses the `data-sort-*` attributes rather than the cell text,
 * because the text is localised and compacted ("€1.2 md" in Romanian) and
 * sorting that lexically would produce nonsense.
 *
 * DRILLING. The legal name is a real anchor, not a row click: reachable by
 * keyboard, has a URL you can copy, works before JavaScript arrives. Legal
 * names are proper nouns and are never translated.
 */
import {
  getCounterparties,
  type CounterpartySortKey,
  type SectorId,
} from '@awc-ui/showcase-kit/data';
import { route, utilisationColor } from '@awc-ui/showcase-kit/credit-risk';
import type { LocaleCode } from '@awc-ui/showcase-kit/i18n';
import { localeHref, useT } from '../lib/i18n';
import { ratingChip, watchDotProps } from '../lib/bits';

interface Props {
  locale: LocaleCode;
  sectorId?: SectorId;
  showSector?: boolean;
}

const { locale, sectorId, showSector = true } = Astro.props;
const t = useT(locale);
const href = (p: string) => localeHref(locale, p);

const rows = getCounterparties({ sectorId, sortBy: 'ead', sortDir: 'desc' });

const NUMERIC_KEYS: CounterpartySortKey[] = [
  'ead',
  'pd',
  'expectedLoss',
  'rwa',
  'utilisation',
  'grade',
];

const columns: { key: CounterpartySortKey | null; label: string; numeric?: boolean }[] = [
  { key: 'legalName', label: t('table.counterparty') },
  ...(showSector ? [{ key: null, label: t('table.sector') }] : []),
  { key: null, label: t('table.country') },
  { key: 'grade', label: t('table.rating') },
  { key: 'pd', label: t('table.pd'), numeric: true },
  { key: null, label: t('table.lgd'), numeric: true },
  { key: 'ead', label: t('table.ead'), numeric: true },
  { key: 'expectedLoss', label: t('table.expectedLoss'), numeric: true },
  { key: 'rwa', label: t('table.rwa'), numeric: true },
  { key: 'utilisation', label: t('table.utilisation'), numeric: true },
];

const columnTemplate = [
  'minmax(200px, 2fr)',
  showSector ? 'minmax(120px, 1fr)' : '',
  'minmax(120px, 1fr)',
  '108px',
  '88px',
  '76px',
  '132px',
  '132px',
  '132px',
  '104px',
]
  .filter(Boolean)
  .join(' ');
---

{
  rows.length === 0 ? (
    <div class="empty">
      <p>{t('empty.counterparties')}</p>
      <p>{t('empty.hint')}</p>
    </div>
  ) : (
    <md-table-container variant="outlined">
      <md-table
        data-sortable
        label={t('screen.counterparties.title')}
        column-template={columnTemplate}
        min-width="1180px"
        sticky-header
        keep-height="false"
        striped
        sort-by="ead"
        sort-order="desc"
      >
        <md-table-head>
          <md-table-row rowgroup="head">
            {columns.map((column) => (
              <md-table-cell head scope="col" numeric={column.numeric || undefined}>
                {column.key ? (
                  <md-table-sort-label
                    column={column.key}
                    active={column.key === 'ead' || undefined}
                    order={column.key === 'ead' ? 'desc' : 'none'}
                    default-order={NUMERIC_KEYS.includes(column.key) ? 'desc' : 'asc'}
                  >
                    {column.label}
                  </md-table-sort-label>
                ) : (
                  column.label
                )}
              </md-table-cell>
            ))}
          </md-table-row>
        </md-table-head>
        <md-table-body>
          {rows.map((cp) => (
            <md-table-row
              value={cp.id}
              data-sort-legalname={cp.legalName}
              data-sort-grade={cp.grade}
              data-sort-pd={cp.pd}
              data-sort-ead={cp.ead}
              data-sort-expectedloss={cp.expectedLoss}
              data-sort-rwa={cp.rwa}
              data-sort-utilisation={cp.utilisation}
            >
              <md-table-cell>
                <span class="row" style="gap: var(--md-sys-spacing-gap-xs, 4px)">
                  <md-status-dot {...watchDotProps(t, cp.watchlist)} />
                  <a class="drill" href={href(route.counterparty(cp.id))}>
                    {cp.legalName}
                  </a>
                </span>
              </md-table-cell>
              {showSector && (
                <md-table-cell>
                  <a class="drill" href={href(route.sector(cp.sectorId))}>
                    {t(`sector.${cp.sectorId}`)}
                  </a>
                </md-table-cell>
              )}
              <md-table-cell>{t(`country.${cp.country}`)}</md-table-cell>
              <md-table-cell>
                <md-chip {...ratingChip(t, cp.ratingLabel, cp.ratingBand, cp.grade)} />
              </md-table-cell>
              <md-table-cell numeric>{t.formatPercent(cp.pd, { maximumFractionDigits: 2 })}</md-table-cell>
              <md-table-cell numeric>{t.formatPercent(cp.lgd, { maximumFractionDigits: 0 })}</md-table-cell>
              <md-table-cell numeric>{t.formatCurrency(cp.ead, { notation: 'compact' })}</md-table-cell>
              <md-table-cell numeric>
                {t.formatCurrency(cp.expectedLoss, { notation: 'compact' })}
              </md-table-cell>
              <md-table-cell numeric>{t.formatCurrency(cp.rwa, { notation: 'compact' })}</md-table-cell>
              <md-table-cell numeric>
                <span style={`color: var(--md-sys-color-${utilisationColor(cp.utilisation)})`}>
                  {t.formatPercent(cp.utilisation, { maximumFractionDigits: 0 })}
                </span>
              </md-table-cell>
            </md-table-row>
          ))}
        </md-table-body>
      </md-table>
    </md-table-container>
  )
}

<script>
  import { enhanceSortableTables } from '../lib/sortable';
  enhanceSortableTables();
</script>
