---
/**
 * The counterparty table — the overview's book, and every sector screen's.
 *
 * PAGED, exactly like the React build — same ten rows, same
 * `md-table-pagination`, same `row-offset` / `row-count`. The six builds are
 * meant to be one application, so a screen that renders twenty-four rows here
 * and ten there is a difference in the APP, not in the framework, and that is
 * the one kind of difference this showcase must not have.
 *
 * The other rows still ship in the HTML, inside a `<template>` the parser keeps
 * out of the document tree — so the live page holds exactly the ten rows
 * React's does, while the client script has the whole book to page and sort
 * through without refetching anything. With JavaScript off you get page one,
 * which is precisely what React's static export gives you with JavaScript off.
 *
 * SORTING AND PAGING ARE BOTH PROGRESSIVE. Rows arrive sorted by exposure
 * descending — the order a credit officer wants first. The comparison uses the
 * `data-sort-*` attributes rather than the cell text, because the text is
 * localised and compacted ("€1.2 md" in Romanian) and sorting that lexically
 * would produce nonsense.
 *
 * DRILLING. The legal name is a real anchor, not a row click: reachable by
 * keyboard, has a URL you can copy, works before JavaScript arrives. Legal
 * names are proper nouns and are never translated.
 */
import {
  getCounterparties,
  type CounterpartySortKey,
  type SectorId,
} from '@awc-ui/showcase-kit/data';
import { route, TABLES, utilisationColor } from '@awc-ui/showcase-kit/credit-risk';
import type { LocaleCode } from '@awc-ui/showcase-kit/i18n';
import { localeHref, useT } from '../lib/i18n';
import CounterpartyRow from './CounterpartyRow.astro';

interface Props {
  locale: LocaleCode;
  sectorId?: SectorId;
  showSector?: boolean;
}

const { locale, sectorId, showSector = true } = Astro.props;
const t = useT(locale);

const rows = getCounterparties({ sectorId, sortBy: 'ead', sortDir: 'desc' });

/** Rows shown per page before the reader changes it. Matches the React build. */
const PAGE_SIZE = 10;

const NUMERIC_KEYS: CounterpartySortKey[] = [
  'ead',
  'pd',
  'expectedLoss',
  'rwa',
  'utilisation',
  'grade',
];

const columns: { key: CounterpartySortKey | null; label: string; numeric?: boolean }[] = [
  { key: 'legalName', label: t('table.counterparty') },
  ...(showSector ? [{ key: null, label: t('table.sector') }] : []),
  { key: null, label: t('table.country') },
  { key: 'grade', label: t('table.rating') },
  { key: 'pd', label: t('table.pd'), numeric: true },
  { key: null, label: t('table.lgd'), numeric: true },
  { key: 'ead', label: t('table.ead'), numeric: true },
  { key: 'expectedLoss', label: t('table.expectedLoss'), numeric: true },
  { key: 'rwa', label: t('table.rwa'), numeric: true },
  { key: 'utilisation', label: t('table.utilisation'), numeric: true },
];

const layout = TABLES.counterparties(showSector);
---

{
  rows.length === 0 ? (
    <div class="empty">
      <p>{t('empty.counterparties')}</p>
      <p>{t('empty.hint')}</p>
    </div>
  ) : (
    <Fragment>
      <md-table-container variant="outlined">
        <md-table
          data-paged
          label={t('screen.counterparties.title')}
          column-template={layout.columns}
          min-width={layout.minWidth}
          keep-height="false"
          striped
          sort-by="ead"
          sort-order="desc"
          row-offset="0"
          row-count={rows.length}
        >
          <md-table-head>
            {/* The sort labels carry no active / order: md-table already
                declares sort-by / sort-order above and pushes both down into
                every label on sync, so anything written here could only ever
                disagree with it. */}
            <md-table-row rowgroup="head">
              {columns.map((column) => (
                <md-table-cell head scope="col" numeric={column.numeric || undefined}>
                  {column.key ? (
                    <md-table-sort-label
                      column={column.key}
                      default-order={NUMERIC_KEYS.includes(column.key) ? 'desc' : 'asc'}
                      icon-position={column.numeric ? 'start' : 'end'}
                    >
                      {column.label}
                    </md-table-sort-label>
                  ) : (
                    column.label
                  )}
                </md-table-cell>
              ))}
            </md-table-row>
          </md-table-head>
          <md-table-body>
            {rows.slice(0, PAGE_SIZE).map((cp) => (
              <CounterpartyRow locale={locale} cp={cp} showSector={showSector} />
            ))}
          </md-table-body>
        </md-table>
        <md-table-pagination
          slot="bottom"
          count={rows.length}
          page="0"
          rows-per-page={PAGE_SIZE}
          rows-per-page-options="10,25,all"
          show-first-last
          label-rows-per-page={t('table.rowsPerPage')}
          label-displayed-rows={t('table.displayedRows')}
          label-first-page={t('table.firstPage')}
          label-previous-page={t('table.previousPage')}
          label-next-page={t('table.nextPage')}
          label-last-page={t('table.lastPage')}
          label-all={t('table.all')}
        />
      </md-table-container>
      {/* The whole book, parked where the document tree cannot see it. A
          template's content is inert — not rendered, not matched by
          querySelectorAll, no upgraded custom elements — so this page holds
          exactly the ten live rows React's does, and the client script still
          has all of them to page and sort through. */}
      <template data-rows>
        {rows.map((cp) => (
          <CounterpartyRow locale={locale} cp={cp} showSector={showSector} />
        ))}
      </template>
    </Fragment>
  )
}

<script>
  import { enhancePagedTables } from '../lib/table';
  enhancePagedTables();
</script>
