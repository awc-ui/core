---
/**
 * Screen 5 — early-warning signals.
 *
 * `getWatchlist()` returns rows already denormalised with the counterparty
 * name, sector, grade and EAD, and already sorted highest severity first then
 * largest exposure — so the table needs no join and no comparator.
 *
 * FILTERS ARE PROGRESSIVE. Every signal is rendered, so with JavaScript off the
 * reader gets the complete watchlist rather than an empty table under three
 * dead controls. The controls DETACH the rows that do not match rather than
 * hiding them — the React build re-renders a shorter array, and a hidden row is
 * still a row to `querySelectorAll` and to a screen reader. See `lib/filters.ts`.
 *
 * `frozen-header`, NOT `sticky-header`. This is the only table here inside a
 * bounded container, so it is the only one that scrolls vertically, and the two
 * props give different architectures for that. `sticky-header` pins the header
 * inside the scroll port, which means the scroll port — and therefore the
 * scrollbar — spans the header too. `frozen-header` renders the header OUTSIDE
 * the scrolling area so the bar runs beside the rows only. md-table's readme:
 * "the header is rendered OUTSIDE the vertical scroll area, so the scrollbar
 * spans only the body and runs UNDER the head."
 */
import { getRatingGrade, getSectors, getWatchlist, type SignalSeverity } from '@awc-ui/showcase-kit/data';
import { route, TABLES } from '@awc-ui/showcase-kit/credit-risk';
import type { LocaleCode } from '@awc-ui/showcase-kit/i18n';
import { localeHref, useT } from '../../lib/i18n';
import { ratingChip, severityChip, severityDotProps } from '../../lib/bits';
import Panel from '../Panel.astro';

interface Props {
  locale: LocaleCode;
}

const SEVERITIES: SignalSeverity[] = ['high', 'medium', 'low'];

const { locale } = Astro.props;
const t = useT(locale);
const href = (p: string) => localeHref(locale, p);

const sectors = getSectors();
const signals = getWatchlist();
const counterpartyCount = new Set(signals.map((s) => s.counterpartyId)).size;

---

<Panel title={t('action.filter')} subtitle={t('table.severity')}>
  <div class="row">
    <md-segmented-button-set data-filter-severity multiselect aria-label={t('table.severity')}>
      {
        SEVERITIES.map((severity) => (
          <md-segmented-button value={severity} label={t(`severity.${severity}`)} />
        ))
      }
    </md-segmented-button-set>

    <md-select
      data-filter-sector
      label={t('table.sector')}
      placeholder={t('common.all')}
      clearable
      clear-label={t('action.clearFilters')}
    >
      {
        sectors.map((sector) => (
          <md-select-option value={sector.id} label={t(sector.nameKey)}>
            {t(sector.nameKey)}
          </md-select-option>
        ))
      }
    </md-select>

    <md-button data-filter-clear variant="text" size="sm" icon="filter_alt_off">
      {t('action.clearFilters')}
    </md-button>
  </div>
</Panel>

<Panel
  title={t('table.signal')}
  subtitle={t('common.of', { count: counterpartyCount, total: signals.length })}
>
  {/* The empty state is what the filter swaps the table for. React renders
      one or the other, never both, so this waits in a template rather than
      sitting in the document under `hidden`: a hidden element is still an
      element, and the six builds are compared on what they contain. */}
  <template data-empty>
    <div class="empty">
      <p>{t('empty.signals')}</p>
      <p>{t('empty.hint')}</p>
    </div>
  </template>

  <md-table-container variant="outlined" max-height="60vh">
    <md-table
      label={t('screen.watchlist.title')}
      column-template={TABLES.watchlist.columns}
      min-width={TABLES.watchlist.minWidth}
      frozen-header
      striped
    >
      <md-table-head>
        <md-table-row rowgroup="head">
          <md-table-cell head scope="col">{t('table.counterparty')}</md-table-cell>
          <md-table-cell head scope="col">{t('table.sector')}</md-table-cell>
          <md-table-cell head scope="col">{t('table.rating')}</md-table-cell>
          <md-table-cell head scope="col">{t('table.signal')}</md-table-cell>
          <md-table-cell head scope="col">{t('table.severity')}</md-table-cell>
          <md-table-cell head scope="col" numeric>{t('table.ead')}</md-table-cell>
          <md-table-cell head scope="col">{t('table.opened')}</md-table-cell>
          <md-table-cell head scope="col" numeric>{t('table.daysOpen')}</md-table-cell>
          <md-table-cell head scope="col">{t('table.owner')}</md-table-cell>
        </md-table-row>
      </md-table-head>
      <md-table-body>
        {
          signals.map((signal) => (
            <md-table-row
              value={signal.id}
              data-severity={signal.severity}
              data-sector={signal.sectorId}
            >
              <md-table-cell>
                {/* The severity marker leads the row, beside the obligor's
                    name — the same shape the counterparty table uses for its
                    watchlist dot, so a reader scanning the first column sees
                    the severity without crossing a nine-column table. */}
                <span class="row" style="gap: var(--md-sys-spacing-gap-xs, 4px)">
                  <md-status-dot {...severityDotProps(t, signal.severity)} />
                  <a class="drill" href={href(route.counterparty(signal.counterpartyId))}>
                    {signal.counterpartyName}
                  </a>
                </span>
              </md-table-cell>
              <md-table-cell>
                <a class="drill" href={href(route.sector(signal.sectorId))}>
                  {t(`sector.${signal.sectorId}`)}
                </a>
              </md-table-cell>
              <md-table-cell>
                {/* The signal row carries the grade but not the band, so the
                    band comes from the rating scale rather than from a second
                    set of thresholds invented here. */}
                <md-chip
                  {...ratingChip(
                    t,
                    signal.ratingLabel,
                    getRatingGrade(signal.grade)?.band ?? 'speculative',
                  )}
                />
              </md-table-cell>
              <md-table-cell>{t(signal.typeKey)}</md-table-cell>
              <md-table-cell>
                <md-chip {...severityChip(t, signal.severity)} />
              </md-table-cell>
              <md-table-cell numeric>
                {t.formatCurrency(signal.ead, { notation: 'compact' })}
              </md-table-cell>
              <md-table-cell>{t.formatDate(signal.openedDate, 'medium')}</md-table-cell>
              <md-table-cell numeric>
                <span title={t('signal.openFor', { days: signal.daysOpen })}>
                  {t.formatNumber(signal.daysOpen)}
                </span>
              </md-table-cell>
              <md-table-cell>{signal.owner}</md-table-cell>
            </md-table-row>
          ))
        }
      </md-table-body>
    </md-table>
  </md-table-container>
</Panel>

<script>
  import { enhanceWatchlistFilters } from '../../lib/filters';
  enhanceWatchlistFilters();
</script>
