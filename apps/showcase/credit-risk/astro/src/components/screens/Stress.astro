---
/**
 * Screen 6 — stress testing.
 *
 * Three scenarios, EAD invariant across all of them, EL and RWA strictly
 * monotone. The comparison charts always plot all three side by side rather
 * than only the selected one: the point of the screen is the SHAPE of the
 * deterioration, and a single-scenario chart hides it.
 *
 * ALL THREE DETAIL SECTIONS ARE RENDERED, two of them hidden, and the segmented
 * selector toggles between them. That is a different mechanism from the React
 * build — which re-renders one — but not a worse one here, because the control
 * itself needs JavaScript to be operable in ANY build. Making its BEHAVIOUR
 * JavaScript-dependent therefore costs nothing that was not already conditional
 * on the same thing, and it keeps the interface identical between the two
 * builds, which is what makes them worth comparing.
 *
 * Baseline's `expectedLossDelta` is exactly zero by construction — its EL
 * equals the portfolio EL — so the delta column reads `n/a` there rather than a
 * formatted `+0`, which would look like a rounded-away number.
 */
import { getSectors, getStressScenarios, type ScenarioId } from '@awc-ui/showcase-kit/data';
import { route, TABLES } from '@awc-ui/showcase-kit/credit-risk';
import type { LocaleCode } from '@awc-ui/showcase-kit/i18n';
import { localeHref, useT } from '../../lib/i18n';
import { props } from '../../lib/props';
import { chartConfig } from '../../lib/charts';
import Panel from '../Panel.astro';

interface Props {
  locale: LocaleCode;
}

const DEFAULT_SCENARIO: ScenarioId = 'adverse';

const { locale } = Astro.props;
const t = useT(locale);
const href = (p: string) => localeHref(locale, p);

const scenarios = getStressScenarios();
const sectors = getSectors();
const sectorLabels = sectors.map((s) => t(s.nameKey));


const describe = (id: ScenarioId) => {
  const s = scenarios.find((x) => x.id === id);
  if (!s) return '';
  return t(s.descriptionKey, {
    pd: t.formatNumber(s.pdMultiplier, { maximumFractionDigits: 2 }),
    lgd: t.formatPercent(s.lgdUplift, { maximumFractionDigits: 0 }),
  });
};

const money = (v: number) => t.formatCurrency(v, { notation: 'compact' });
/** Zero delta is structural for the baseline, not a rounded-away number. */
const delta = (v: number) => (v === 0 ? t('common.na') : money(v));
---

<div data-stress>
  {
    scenarios.map((scenario) => (
      <section data-scenario={scenario.id} hidden={scenario.id !== DEFAULT_SCENARIO}>
        <Panel title={t(scenario.nameKey)} subtitle={describe(scenario.id)}>
          <dl class="dl dl--numeric">
            <div>
              <dt>{t('table.pdMultiplier')}</dt>
              <dd>
                {t('unit.times', {
                  value: t.formatNumber(scenario.pdMultiplier, { maximumFractionDigits: 2 }),
                })}
              </dd>
            </div>
            <div>
              <dt>{t('table.lgdUplift')}</dt>
              <dd>
                {t.formatPercent(scenario.lgdUplift, {
                  maximumFractionDigits: 0,
                  signDisplay: 'exceptZero',
                })}
              </dd>
            </div>
            <div>
              <dt>{t('kpi.ead')}</dt>
              <dd>{money(scenario.totals.ead)}</dd>
            </div>
            <div>
              <dt>{t('kpi.expectedLoss')}</dt>
              <dd>{money(scenario.totals.expectedLoss)}</dd>
            </div>
            <div>
              <dt>{t('table.elDelta')}</dt>
              <dd>{delta(scenario.totals.expectedLossDelta)}</dd>
            </div>
            <div>
              <dt>{t('kpi.rwa')}</dt>
              <dd>{money(scenario.totals.rwa)}</dd>
            </div>
            <div>
              <dt>{t('table.rwaDelta')}</dt>
              <dd>{delta(scenario.totals.rwaDelta)}</dd>
            </div>
            <div>
              <dt>{t('kpi.weightedAvgPd')}</dt>
              <dd>{t.formatPercent(scenario.totals.weightedAvgPd, { maximumFractionDigits: 2 })}</dd>
            </div>
            <div>
              <dt>{t('kpi.rwaDensity')}</dt>
              <dd>{t.formatPercent(scenario.totals.rwaDensity, { maximumFractionDigits: 1 })}</dd>
            </div>
          </dl>
        </Panel>
      </section>
    ))
  }

  {/* Both charts carry their own header; the panels stay untitled so the
      heading is not printed twice. */}
  <section class="grid-2">
    <Panel>
      <md-bar-chart
        {...props({
          series: scenarios.map((s) => ({
            id: s.id,
            label: t(s.nameKey),
            data: s.bySector.map((row) => row.expectedLoss),
          })),
        })}
        data-chart={chartConfig({
          xAxis: { data: sectorLabels },
          yAxis: { label: t('kpi.expectedLoss'), min: 0 },
          format: 'currency',
        })}
        locale={locale}
        legend="top-end"
        axis-ticks
        height="340px"
        label={t('kpi.expectedLoss')}
        subtitle={t('scenario.compare')}></md-bar-chart>
    </Panel>

    <Panel>
      <md-bar-chart
        {...props({
          series: scenarios.map((s) => ({
            id: s.id,
            label: t(s.nameKey),
            data: s.bySector.map((row) => row.rwa),
          })),
        })}
        data-chart={chartConfig({
          xAxis: { data: sectorLabels },
          yAxis: { label: t('kpi.rwa'), min: 0 },
          format: 'currency',
        })}
        locale={locale}
        legend="top-end"
        axis-ticks
        height="340px"
        label={t('kpi.rwa')}
        subtitle={t('scenario.compare')}></md-bar-chart>
    </Panel>
  </section>

  {
    scenarios.map((scenario) => (
      <section data-scenario={scenario.id} hidden={scenario.id !== DEFAULT_SCENARIO}>
        <Panel
          title={t('table.sector')}
          subtitle={`${t(scenario.nameKey)} · ${t('scenario.vsBaseline')}`}
        >
          <md-table-container variant="outlined">
            <md-table
              label={t('screen.stress.title')}
              column-template={TABLES.stress.columns}
              min-width={TABLES.stress.minWidth}
              striped
            >
              <md-table-head>
                <md-table-row rowgroup="head">
                  <md-table-cell head scope="col">{t('table.sector')}</md-table-cell>
                  <md-table-cell head scope="col" numeric>{t('table.ead')}</md-table-cell>
                  <md-table-cell head scope="col" numeric>{t('table.pd')}</md-table-cell>
                  <md-table-cell head scope="col" numeric>{t('table.lgd')}</md-table-cell>
                  <md-table-cell head scope="col" numeric>{t('table.expectedLoss')}</md-table-cell>
                  <md-table-cell head scope="col" numeric>{t('table.elDelta')}</md-table-cell>
                  <md-table-cell head scope="col" numeric>{t('table.rwa')}</md-table-cell>
                  <md-table-cell head scope="col" numeric>{t('table.rwaDelta')}</md-table-cell>
                </md-table-row>
              </md-table-head>
              <md-table-body>
                {scenario.bySector.map((row) => (
                  <md-table-row value={row.sectorId}>
                    <md-table-cell>
                      <a class="drill" href={href(route.sector(row.sectorId))}>
                        {t(`sector.${row.sectorId}`)}
                      </a>
                    </md-table-cell>
                    <md-table-cell numeric>{money(row.ead)}</md-table-cell>
                    <md-table-cell numeric>
                      {t.formatPercent(row.weightedAvgPd, { maximumFractionDigits: 2 })}
                    </md-table-cell>
                    <md-table-cell numeric>
                      {t.formatPercent(row.weightedAvgLgd, { maximumFractionDigits: 1 })}
                    </md-table-cell>
                    <md-table-cell numeric>{money(row.expectedLoss)}</md-table-cell>
                    <md-table-cell numeric>
                      <span
                        style={
                          row.expectedLossDelta > 0 ? 'color: var(--md-sys-color-error)' : undefined
                        }
                      >
                        {delta(row.expectedLossDelta)}
                      </span>
                    </md-table-cell>
                    <md-table-cell numeric>{money(row.rwa)}</md-table-cell>
                    <md-table-cell numeric>
                      <span
                        style={row.rwaDelta > 0 ? 'color: var(--md-sys-color-warning)' : undefined}
                      >
                        {delta(row.rwaDelta)}
                      </span>
                    </md-table-cell>
                  </md-table-row>
                ))}
              </md-table-body>
            </md-table>
          </md-table-container>
        </Panel>
      </section>
    ))
  }
</div>

<script>
  import { enhanceScenarioSelector } from '../../lib/scenario';
  enhanceScenarioSelector();
</script>
