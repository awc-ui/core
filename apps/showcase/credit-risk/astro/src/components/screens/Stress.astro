---
/**
 * Screen 6 — stress testing.
 *
 * Three scenarios, EAD invariant across all of them, EL and RWA strictly
 * monotone. The comparison charts always plot all three side by side rather
 * than only the selected one: the point of the screen is the SHAPE of the
 * deterioration, and a single-scenario chart hides it.
 *
 * ONE SCENARIO IS LIVE, exactly like the React build — the same two panels in
 * the same two places. The other two ride along in `<template>` elements, whose
 * contents the parser keeps out of the document tree, and the selector swaps a
 * panel by cloning one in.
 *
 * An earlier version rendered all three and hid two with the `hidden`
 * attribute. Hiding is not the same as not rendering: a hidden panel is still
 * in `querySelectorAll`, still in the accessibility tree, and still three
 * copies of every table. The six builds are supposed to render the same
 * document, so "the same" has to mean the same elements.
 *
 * Baseline's `expectedLossDelta` is exactly zero by construction — its EL
 * equals the portfolio EL — so the delta column reads `n/a` there rather than a
 * formatted `+0`, which would look like a rounded-away number.
 */
import { getSectors, getStressScenarios, type ScenarioId } from '@awc-ui/showcase-kit/data';
import type { LocaleCode } from '@awc-ui/showcase-kit/i18n';
import { useT } from '../../lib/i18n';
import { props } from '../../lib/props';
import { chartConfig } from '../../lib/charts';
import Panel from '../Panel.astro';
import ScenarioFacts from '../ScenarioFacts.astro';
import ScenarioTable from '../ScenarioTable.astro';

interface Props {
  locale: LocaleCode;
}

const DEFAULT_SCENARIO: ScenarioId = 'adverse';

const { locale } = Astro.props;
const t = useT(locale);

const scenarios = getStressScenarios();
const sectors = getSectors();
const sectorLabels = sectors.map((s) => t(s.nameKey));

const initial = scenarios.find((s) => s.id === DEFAULT_SCENARIO) ?? scenarios[0];
---

<ScenarioFacts locale={locale} scenario={initial} live />

  {/* Both charts carry their own header; the panels stay untitled so the
      heading is not printed twice. */}
  <section class="grid-2">
    <Panel>
      <md-bar-chart
        {...props({
          series: scenarios.map((s) => ({
            id: s.id,
            label: t(s.nameKey),
            data: s.bySector.map((row) => row.expectedLoss),
          })),
        })}
        data-chart={chartConfig({
          xAxis: { data: sectorLabels },
          yAxis: { label: t('kpi.expectedLoss'), min: 0 },
          format: 'currency',
        })}
        locale={locale}
        legend="top-end"
        axis-ticks
        height="340px"
        label={t('kpi.expectedLoss')}
        subtitle={t('scenario.compare')}></md-bar-chart>
    </Panel>

    <Panel>
      <md-bar-chart
        {...props({
          series: scenarios.map((s) => ({
            id: s.id,
            label: t(s.nameKey),
            data: s.bySector.map((row) => row.rwa),
          })),
        })}
        data-chart={chartConfig({
          xAxis: { data: sectorLabels },
          yAxis: { label: t('kpi.rwa'), min: 0 },
          format: 'currency',
        })}
        locale={locale}
        legend="top-end"
        axis-ticks
        height="340px"
        label={t('kpi.rwa')}
        subtitle={t('scenario.compare')}></md-bar-chart>
    </Panel>
  </section>

  <ScenarioTable locale={locale} scenario={initial} live />

  {/* Every scenario's two panels, parked where the document tree cannot see
      them. A template's content is inert, so these add no cards, no tables and
      no rows to the page — the live DOM matches the React build exactly. The
      initial scenario is here too, so switching away and back is the same
      operation in both directions. */}
  {
    scenarios.map((scenario) => (
      <Fragment>
        <template data-scenario={scenario.id} data-slot="facts">
          <ScenarioFacts locale={locale} scenario={scenario} />
        </template>
        <template data-scenario={scenario.id} data-slot="table">
          <ScenarioTable locale={locale} scenario={scenario} />
        </template>
      </Fragment>
    ))
  }

<script>
  import { enhanceScenarioSelector } from '../../lib/scenario';
  enhanceScenarioSelector();
</script>
