---
/**
 * The document. Everything in `<head>` is ordered deliberately.
 *
 * 1. THE PREBOOT SCRIPT, first — 832 bytes of synchronous IIFE that stamps
 *    theme and density onto <html> before the first paint. Placed after a
 *    stylesheet it would still run before paint, but the browser blocks it on
 *    the CSS download first, so it goes first. On this build it does NOT touch
 *    `lang` or `dir`: `data-locale-route` below tells it the server already
 *    settled those, and a stale locale in localStorage must not overwrite the
 *    language the page is actually written in.
 *
 * 2. THE FONTS. The components render Material Symbols glyphs inside their own
 *    shadow roots. Font registration crosses shadow boundaries; class rules do
 *    not — so the faces must be registered at document level or every `icon=`
 *    prop renders as its ligature text.
 *
 * 3. THE COMPONENT RUNTIME, as a module script at an absolute URL under
 *    `public/`. Stencil's lazy build resolves its sibling chunks relative to
 *    its OWN location, so putting it through Vite makes it hunt for chunks in
 *    the dev server's module graph, which the export does not contain.
 *    `scripts/sync-runtime.mjs` carries the full post-mortem.
 *
 * Because `src/middleware.ts` server-renders the shadow roots, the runtime is
 * not what makes this page correct — the HTML already is. The runtime arrives
 * afterwards and gives the elements behaviour.
 */
import { PREBOOT_SCRIPT } from '@awc-ui/showcase-kit/preboot';
import { REPORTING_DATE } from '@awc-ui/showcase-kit/data';
import type { LocaleCode } from '@awc-ui/showcase-kit/i18n';
import {
  BASE_PATH,
  DEFAULT_LOCALE,
  LOCALE_CODES,
  dirFor,
  switchLocaleHref,
  useT,
} from '../lib/i18n';
import '@awc-ui/core/css/tokens.css';
import '@awc-ui/showcase-kit/credit-risk/app.css';

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const t = useT(locale);
const dir = dirFor(locale);
const runtimeUrl = `${BASE_PATH}/awc-runtime/md3/md3.esm.js`;
const runtimeImport = `import(${JSON.stringify(runtimeUrl)}).catch((e)=>console.error('[awc-ui] component registration failed',e));`;

/**
 * The same screen in the other two languages. Without these a crawler treats
 * the three locale trees as unrelated documents — or worse, as duplicates of
 * each other — rather than as translations of one page.
 */
const alternates = LOCALE_CODES.map((code) => ({
  code,
  href: switchLocaleHref(code, Astro.url.pathname),
}));
---

<html lang={locale} dir={dir} data-locale-route>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={PREBOOT_SCRIPT} />
    <title>{t('app.brand')} — {t('app.title')}</title>
    <meta name="description" content={t('app.subtitle')} />
    <meta name="awc-reporting-date" content={REPORTING_DATE} />
    {alternates.map(({ code, href }) => <link rel="alternate" hreflang={code} href={href} />)}
    <link
      rel="alternate"
      hreflang="x-default"
      href={switchLocaleHref(DEFAULT_LOCALE, Astro.url.pathname)}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&display=swap"
    />
    <script type="module" is:inline set:html={runtimeImport} />
  </head>
  <body>
    <slot />

    {/*
      Charts only. Every chart on the page gets the axes and value formatter
      that could not travel in an attribute — see `lib/charts.ts` for why that
      costs a canvas-backed component nothing. Deliberately NOT how the tables
      or any other content arrives: those are server-rendered.
    */}
    <script>
      import { configureCharts } from '../lib/charts.client';
      configureCharts();
    </script>
  </body>
</html>
