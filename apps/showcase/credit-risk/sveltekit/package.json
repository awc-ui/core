{
  "name": "@awc-ui/showcase-credit-risk-sveltekit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Credit Risk Console \u2014 SvelteKit build (rendered on the server, per request, with declarative shadow DOM)",
  "scripts": {
    "sync-runtime": "node scripts/sync-runtime.mjs",
    "dev": "pnpm sync-runtime && vite dev",
    "build": "pnpm sync-runtime && vite build",
    "build:netlify": "AWC_TARGET=netlify pnpm build",
    "start": "node server.mjs",
    "lint": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "verify": "node scripts/verify-browser.mjs"
  },
  "dependencies": {
    "@awc-ui/core": "workspace:*",
    "@awc-ui/showcase-kit": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-netlify": "^6.0.4",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.4.0",
    "vite": "^6.4.3",
    "puppeteer": "^25.11.0"
  }
}
