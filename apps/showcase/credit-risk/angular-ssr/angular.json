{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "credit-risk-angular-ssr": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "awc",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "ssr": { "entry": "src/server.ts" },
            "prerender": false,
            "baseHref": "/showcase/credit-risk/angular-ssr/",
            "deployUrl": "/showcase/credit-risk/angular-ssr/",
            "externalDependencies": ["@awc-ui/core/hydrate"],
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [{ "glob": "**/*", "input": "public", "output": "." }],
            "styles": [
              "node_modules/@awc-ui/core/dist/md3/md3.css",
              "node_modules/@awc-ui/showcase-kit/src/credit-risk/app.css"
            ],
            "optimization": true,
            "sourceMap": false,
            "extractLicenses": false
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": { "buildTarget": "credit-risk-angular-ssr:build" }
        }
      }
    }
  }
}
