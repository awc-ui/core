{
  "name": "@awc-ui/showcase-credit-risk-angular-ssr",
  "version": "0.1.0",
  "private": true,
  "description": "Credit Risk Console — Angular build (server-rendered per request, declarative shadow DOM, locale switched in place)",
  "scripts": {
    "sync-runtime": "node scripts/sync-runtime.mjs",
    "dev": "pnpm sync-runtime && ng serve",
    "build": "pnpm sync-runtime && ng build",
    "start": "node dist/server/server.mjs",
    "netlify:package": "node scripts/build-netlify.mjs",
    "build:netlify": "pnpm build && pnpm netlify:package",
    "verify:netlify": "node scripts/verify-netlify-function.mjs",
    "serve": "node scripts/serve-dist.mjs",
    "verify": "node scripts/verify-browser.mjs",
    "lint": "tsc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@angular/common": "~20.3.31",
    "@angular/compiler": "~20.3.31",
    "@angular/core": "~20.3.31",
    "@angular/platform-browser": "~20.3.31",
    "@angular/platform-server": "~20.3.31",
    "@angular/router": "~20.3.31",
    "@angular/ssr": "~20.3.37",
    "@awc-ui/core": "workspace:*",
    "@awc-ui/showcase-kit": "workspace:*",
    "express": "^4.18.2",
    "rxjs": "^7.8.0",
    "serverless-http": "^4.0.0",
    "zone.js": "~0.15.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~20.3.37",
    "@angular/cli": "~20.3.37",
    "@angular/compiler-cli": "~20.3.31",
    "@types/express": "^4.17.17",
    "@types/node": "^20.14.0",
    "puppeteer": "^25.11.0",
    "typescript": "~5.9.3"
  }
}
