{
  "name": "@awc-ui/showcase-community-vue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lyra \u2014 Photos & People, the Vue flavour of the AWC UI social showcase vertical: Vite, Vue 3 script-setup, a hand-rolled router, no meta-framework",
  "scripts": {
    "sync-runtime": "node scripts/sync-runtime.mjs",
