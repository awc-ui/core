    "preview": "vite preview",
    "serve": "node scripts/serve-dist.mjs",
    "lint": "vue-tsc --noEmit",
    "verify": "node scripts/verify-browser.mjs"
  },
  "dependencies": {
    "@awc-ui/core": "workspace:*",
    "@awc-ui/showcase-kit": "workspace:*",
    "@fontsource/roboto": "^5.3.0",
    "material-symbols": "^0.40.2",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "puppeteer": "^24.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.11",
    "vue-tsc": "^2.0.0"
  }
}
