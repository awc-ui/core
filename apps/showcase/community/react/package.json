{
  "name": "@awc-ui/showcase-community-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Corvus \u2014 Friends & Groups, the React flavour of the AWC UI community showcase vertical: a single-page app, no meta-framework",
  "scripts": {
