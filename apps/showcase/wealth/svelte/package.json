{
  "name": "@awc-ui/showcase-wealth-svelte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kestrel Private Bank \u2014 Wealth Management Console, the Svelte flavour of the AWC UI wealth showcase vertical: Vite, a hand-rolled client router, no meta-framework",
  "scripts": {
    "sync-runtime": "node scripts/sync-runtime.mjs",
    "dev": "pnpm sync-runtime && vite",
    "build": "pnpm sync-runtime && vite build && node scripts/fan-out-routes.mjs",
    "preview": "vite preview",
    "serve": "node scripts/serve-dist.mjs",
    "lint": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "verify": "node scripts/verify-browser.mjs"
  },
  "dependencies": {
    "@awc-ui/core": "workspace:*",
    "@awc-ui/showcase-kit": "workspace:*",
    "@fontsource/roboto": "^5.3.0",
    "material-symbols": "^0.40.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/node": "^20.14.0",
    "puppeteer": "^25.11.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.4.0",
    "vite": "^6.4.3"
  }
}
