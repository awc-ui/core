{
  "name": "@awc-ui/showcase-design-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pictor \u2014 Design & Image, the React flavour of the AWC UI design showcase vertical: a single-page app, no meta-framework",
  "scripts": {
    "sync-runtime": "node scripts/sync-runtime.mjs",
    "dev": "pnpm sync-runtime && vite",
    "build": "pnpm sync-runtime && vite build && node scripts/fan-out-routes.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "serve": "node scripts/serve-dist.mjs",
    "verify": "node ../shared/scripts/verify-browser.mjs react"
  },
  "dependencies": {
    "@awc-ui/core": "workspace:*",
    "@awc-ui/showcase-kit": "workspace:*",
    "@fontsource/roboto": "^5.3.0",
    "material-symbols": "^0.40.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@awc-ui/pictor-model": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.11"
  }
}
