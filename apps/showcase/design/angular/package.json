{
  "name": "@awc-ui/showcase-design-angular",
  "version": "0.1.0",
  "private": true,
  "description": "Pictor creative studio — native Angular standalone components",
  "scripts": {
    "sync-runtime": "node scripts/sync-runtime.mjs",
    "dev": "pnpm sync-runtime && ng serve",
    "build": "pnpm sync-runtime && ng build && node scripts/inject-head.mjs && node scripts/fan-out-routes.mjs",
    "serve": "node scripts/serve-dist.mjs",
    "lint": "ngc -p tsconfig.app.json --noEmit",
    "verify:browser": "node ../shared/scripts/verify-browser.mjs angular",
    "verify": "node ../shared/scripts/verify-browser.mjs angular",
    "verify:localization": "node scripts/verify-localization.mjs"
  },
  "dependencies": {
    "@angular/common": "~20.3.31",
    "@angular/compiler": "~20.3.31",
    "@angular/core": "~20.3.31",
    "@angular/platform-browser": "~20.3.31",
    "@angular/router": "~20.3.31",
    "@awc-ui/core": "workspace:*",
    "@awc-ui/showcase-kit": "workspace:*",
    "@fontsource/roboto": "^5.3.0",
    "material-symbols": "^0.40.2",
    "rxjs": "^7.8.0",
    "zone.js": "~0.15.0",
    "@awc-ui/pictor-model": "workspace:*",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~20.3.37",
    "@angular/cli": "~20.3.37",
    "@angular/compiler-cli": "~20.3.31",
    "@types/node": "^20.14.0",
    "puppeteer": "^25.11.0",
    "typescript": "~5.9.3"
  }
}
