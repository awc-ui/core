    "vue": "^3.5.0",
    "@awc-ui/pictor-model": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.11",
    "vue-tsc": "^2.0.0"
  }
