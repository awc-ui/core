{
  "name": "@awc-ui/showcase-design-html",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pictor in plain HTML and TypeScript using native AWC Web Components; no UI framework runtime.",
  "scripts": {
    "sync-runtime": "node scripts/sync-runtime.mjs",
    "dev": "pnpm sync-runtime && vite",
    "build": "pnpm sync-runtime && vite build && node scripts/fan-out-routes.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "serve": "node scripts/serve-dist.mjs",
    "verify": "node ../shared/scripts/verify-browser.mjs html",
    "test": "node scripts/verify-dom.cjs"
  },
  "dependencies": {
    "@awc-ui/core": "workspace:*",
    "@awc-ui/showcase-kit": "workspace:*",
    "@fontsource/roboto": "^5.3.0",
    "material-symbols": "^0.40.2",
    "@awc-ui/pictor-model": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.11"
  }
}
