{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "social-angular": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "awc",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "prerender": false,
            "ssr": false,
            "baseHref": "/showcase/music/angular/",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public",
                "output": "."
              }
            ],
            "styles": [
              "node_modules/@awc-ui/core/dist/md3/md3.css",
              "node_modules/@awc-ui/core/dist/md3/pre-upgrade.css",
              "node_modules/@awc-ui/showcase-kit/src/music/app.css",
              "src/app/screens/snackbar.css"
            ],
            "optimization": {
              "scripts": true,
              "styles": {
                "minify": true,
                "inlineCritical": false
              },
              "fonts": true
            },
            "sourceMap": false,
            "extractLicenses": false
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "social-angular:build",
            "port": 4381
          }
        }
      }
    }
  }
}
