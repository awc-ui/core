{
  "name": "@awc-ui/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev-docs.mjs",
    "generate-data": "node ../../scripts/generate-docs.mjs",
    "build": "pnpm test && pnpm sync-runtime && astro build && node ../../scripts/verify-standalone-showcases.mjs",
    "test": "node --experimental-strip-types --test ../../scripts/docs-runtime-preloads.test.mjs ../../scripts/check-docs-release.test.mjs",
    "preview": "astro preview",
    "sync-runtime": "node ../../scripts/sync-docs-runtime.mjs",
    "preview:prod": "node ../../scripts/serve-docs-prod.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/starlight": "^0.42.1",
    "@awc-ui/core": "workspace:*",
    "@awc-ui/theme": "workspace:*",
    "@awc-ui/tokens": "workspace:*",
    "@material/material-color-utilities": "^0.4.0",
    "@shikijs/themes": "^3.21.0",
    "astro": "^7.3.2",
    "marked": "^18.0.3",
    "shiki": "^3.21.0",
    "@awc-ui/react": "workspace:*"
  },
  "devDependencies": {
    "sharp": "^0.35.4"
  }
}
