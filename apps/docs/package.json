{
  "name": "@awc-ui/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev-docs.mjs",
    "generate-data": "node ../../scripts/generate-docs.mjs",
    "build": "pnpm test && pnpm sync-runtime && astro build && node ../../scripts/verify-standalone-showcases.mjs",
    "test": "node --experimental-strip-types --test ../../scripts/docs-runtime-preloads.test.mjs ../../scripts/check-docs-release.test.mjs src/lib/htmlToTechnology.test.mjs",
