{
  "tag": "md-list",
  "title": "List",
  "slug": "list",
  "category": "Containment",
  "subComponentOf": null,
  "storyId": "containment-list--playground",
  "props": [
    {
      "name": "listStyle",
      "attribute": "list-style",
      "type": "MdListStyle",
      "default": "'standard'",
      "reflect": false,
      "mutable": false
    },
    {
      "name": "selectionMode",
      "attribute": "selection-mode",
      "type": "MdListSelectionMode",
      "default": "'none'",
      "reflect": false,
      "mutable": false
    },
    {
      "name": "interactionMode",
      "attribute": "interaction-mode",
      "type": "MdListInteractionMode",
      "default": "'single-action'",
      "reflect": false,
      "mutable": false
    },
    {
      "name": "reorderable",
      "attribute": "reorderable",
      "type": "boolean",
      "default": "false",
      "reflect": true,
      "mutable": false
    },
    {
      "name": "label",
      "attribute": "label",
      "type": "string",
      "default": "''",
      "reflect": false,
      "mutable": false
    },
    {
      "name": "labelledby",
      "attribute": "labelledby",
      "type": "string",
      "default": "''",
      "reflect": false,
      "mutable": false
    },
    {
      "name": "roleOverride",
      "attribute": "role-override",
      "type": "string",
      "default": "''",
      "reflect": false,
      "mutable": false
    },
    {
      "name": "density",
      "attribute": "density",
      "type": "0 | -1 | -2 | -3 | -4",
      "default": "0",
      "reflect": true,
      "mutable": false
    }
