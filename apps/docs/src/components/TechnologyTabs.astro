---
import { codeToHtml, type BundledLanguage } from 'shiki';

interface Props {
  html?: string;
  react?: string;
  angular?: string;
  vue?: string;
  svelte?: string;
}

const { html = '', react = '', angular = '', vue = '', svelte = '' } = Astro.props;

const META: Record<string, { lang: BundledLanguage }> = {
  html: { lang: 'html' },
  react: { lang: 'tsx' },
  angular: { lang: 'typescript' },
  vue: { lang: 'vue' },
  svelte: { lang: 'svelte' },
};

// Authentic technology brand SVGs sourced from Simple Icons (CC0). Brand
// colours are baked into the path fills so the logos stay recognisable
// regardless of theme; the parent .technology-tabs__tab-icon controls
// sizing and opacity for hover/active state feedback.
const TECHNOLOGY_ICONS: Record<string, string> = {
  html: `<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="#E34F26" d="M1.5 0h21l-1.91 21.563L11.977 24l-8.565-2.438L1.5 0zm17.09 4.413L5.41 4.41l.213 2.622 10.125.002-.255 2.716h-6.64l.24 2.573h6.182l-.366 3.523-2.91.804-2.956-.81-.188-2.11h-2.61l.29 3.855L12 19.288l5.373-1.53L18.59 4.414z"/></svg>`,
  react: `<svg viewBox="-11.5 -10.232 23 20.463" width="20" height="20" aria-hidden="true"><circle r="2.05" fill="#61DAFB"/><g stroke="#61DAFB" stroke-width="1" fill="none"><ellipse rx="11" ry="4.2"/><ellipse rx="11" ry="4.2" transform="rotate(60)"/><ellipse rx="11" ry="4.2" transform="rotate(120)"/></g></svg>`,
  angular: `<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="#DD0031" d="M9.93 12.645h4.134L11.996 7.74zM11.996.009L.686 3.988l1.725 14.76 9.585 5.243 9.588-5.238L23.308 3.99 11.996.009zm7.058 18.297h-2.636l-1.42-3.501H8.995l-1.42 3.501H4.937L11.996 2.397l7.058 15.909z"/></svg>`,
  vue: `<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="#41B883" d="M24 1.61H14.06L12 5.16 9.94 1.61H0L12 22.39 24 1.61z"/><path class="technology-tabs__vue-inner" fill="#35495E" d="M14.06 1.61L12 5.16 9.94 1.61H6.04L12 11.93l5.96-10.32h-3.9z"/></svg>`,
  svelte: `<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="#FF3E00" d="M10.354 21.125a4.44 4.44 0 0 1-4.765-1.767 4.109 4.109 0 0 1-.703-3.107 3.898 3.898 0 0 1 .134-.522l.105-.321.286.21a7.21 7.21 0 0 0 2.184 1.092l.208.063-.02.208a1.253 1.253 0 0 0 .226.83 1.337 1.337 0 0 0 1.435.533 1.231 1.231 0 0 0 .343-.15l5.59-3.562a1.164 1.164 0 0 0 .524-.778 1.242 1.242 0 0 0-.211-.937 1.338 1.338 0 0 0-1.435-.533 1.23 1.23 0 0 0-.343.15l-2.133 1.36a4.078 4.078 0 0 1-1.135.499 4.44 4.44 0 0 1-4.765-1.766 4.108 4.108 0 0 1-.702-3.108 3.855 3.855 0 0 1 1.742-2.582l5.589-3.563a4.072 4.072 0 0 1 1.135-.499 4.44 4.44 0 0 1 4.765 1.767 4.109 4.109 0 0 1 .703 3.107 3.943 3.943 0 0 1-.134.522l-.105.321-.286-.21a7.204 7.204 0 0 0-2.184-1.092l-.208-.063.02-.208a1.253 1.253 0 0 0-.226-.83 1.337 1.337 0 0 0-1.435-.533 1.231 1.231 0 0 0-.343.15L8.62 9.368a1.162 1.162 0 0 0-.524.778 1.24 1.24 0 0 0 .211.937 1.338 1.338 0 0 0 1.435.533 1.235 1.235 0 0 0 .344-.15l2.132-1.36a4.067 4.067 0 0 1 1.135-.498 4.44 4.44 0 0 1 4.765 1.766 4.108 4.108 0 0 1 .702 3.108 3.857 3.857 0 0 1-1.742 2.583l-5.589 3.562a4.072 4.072 0 0 1-1.135.499"/></svg>`,
};

const rawTabs = [
  { id: 'html', label: 'HTML', code: html },
  { id: 'react', label: 'React', code: react },
  { id: 'angular', label: 'Angular', code: angular },
  { id: 'vue', label: 'Vue', code: vue },
  { id: 'svelte', label: 'Svelte', code: svelte },
]
  .filter((t) => t.code.trim())
  .map((t) => ({ ...t, ...META[t.id], iconSvg: TECHNOLOGY_ICONS[t.id] ?? '' }));

// Render each tab's code with Shiki at build time. Dual themes via CSS
// variables, swapped by Starlight's `data-theme` attribute (see styles).
const tabs = await Promise.all(
  rawTabs.map(async (t) => ({
    ...t,
    highlighted: await codeToHtml(t.code, {
      lang: t.lang,
      themes: { light: 'github-light', dark: 'github-dark' },
      defaultColor: false,
    }),
  })),
);
---

<div class="technology-tabs" data-technology-tabs>
  <div class="technology-tabs__nav" role="tablist" aria-label="Technology code examples">
    {tabs.map((tab, i) => (
      <button
        type="button"
        role="tab"
        id={`tab-${tab.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-controls={`panel-${tab.id}`}
        class:list={['technology-tabs__tab', { 'technology-tabs__tab--active': i === 0 }]}
        data-tab={tab.id}
        tabindex={i === 0 ? 0 : -1}
      >
        <span class="technology-tabs__tab-icon" aria-hidden="true" set:html={tab.iconSvg} />
        <span class="technology-tabs__tab-label">{tab.label}</span>
      </button>
    ))}
  </div>

  {tabs.map((tab, i) => (
    <div
      role="tabpanel"
      id={`panel-${tab.id}`}
      aria-labelledby={`tab-${tab.id}`}
      class:list={['technology-tabs__panel', { 'technology-tabs__panel--active': i === 0 }]}
      data-panel={tab.id}
      tabindex="0"
      hidden={i !== 0}
    >
      <div class="technology-tabs__code-wrapper">
        <button
          type="button"
          class="technology-tabs__copy"
          data-copy={tab.code}
          aria-label={`Copy ${tab.label} code`}
          title="Copy to clipboard"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
          </svg>
          <span class="technology-tabs__copy-label">Copy</span>
        </button>
        <div class="technology-tabs__code" set:html={tab.highlighted} />
      </div>
    </div>
  ))}
</div>

<script>
  // The tabs need to be wired up on *every* page load. Starlight does NOT
  // ship Astro's <ClientRouter> by default, so `astro:page-load` never
  // fires — using only that event leaves the tabs completely inert.
  //
  // Strategy: run setup once when the script is parsed (it's a defer-style
  // module, so the DOM is already parsed by then), and again on
  // `astro:page-load` for users who later opt into view-transitions.
  function setupTechnologyTabs() {
    const STORAGE_KEY = 'awc-ui-docs-technology';

    const activateTab = (container: Element, tabId: string) => {
      container.querySelectorAll<HTMLElement>('[role="tab"]').forEach((btn) => {
        const isActive = btn.getAttribute('data-tab') === tabId;
        btn.setAttribute('aria-selected', String(isActive));
        btn.classList.toggle('technology-tabs__tab--active', isActive);
        btn.tabIndex = isActive ? 0 : -1;
      });
      container.querySelectorAll<HTMLElement>('[role="tabpanel"]').forEach((panel) => {
        const isActive = panel.getAttribute('data-panel') === tabId;
        panel.classList.toggle('technology-tabs__panel--active', isActive);
        if (isActive) panel.removeAttribute('hidden');
        else panel.setAttribute('hidden', '');
      });
    };

    const saved = (() => {
      try {
        return localStorage.getItem(STORAGE_KEY);
      } catch {
        return null;
      }
    })();

    document.querySelectorAll<HTMLElement>('[data-technology-tabs]').forEach((container) => {
      if (container.dataset.technologyTabsBound === 'true') return;
      container.dataset.technologyTabsBound = 'true';

      if (saved && container.querySelector(`[data-tab="${saved}"]`)) {
        activateTab(container, saved);
      }

      container.querySelectorAll<HTMLButtonElement>('[role="tab"]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-tab');
          if (!id) return;
          try {
            localStorage.setItem(STORAGE_KEY, id);
          } catch {
            /* ignore — private mode / storage disabled */
          }
          document.querySelectorAll<HTMLElement>('[data-technology-tabs]').forEach((c) => {
            if (c.querySelector(`[data-tab="${id}"]`)) activateTab(c, id);
          });
        });

        btn.addEventListener('keydown', (event) => {
          const tabsInContainer = Array.from(
            container.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
          );
          const idx = tabsInContainer.indexOf(btn);
          let next = -1;
          if (event.key === 'ArrowRight') next = (idx + 1) % tabsInContainer.length;
          else if (event.key === 'ArrowLeft') next = (idx - 1 + tabsInContainer.length) % tabsInContainer.length;
          else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = tabsInContainer.length - 1;
          if (next >= 0) {
            event.preventDefault();
            tabsInContainer[next].click();
            tabsInContainer[next].focus();
          }
        });
      });

      container.querySelectorAll<HTMLButtonElement>('.technology-tabs__copy').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const code = btn.getAttribute('data-copy') || '';
          try {
            await navigator.clipboard.writeText(code);
          } catch {
            return;
          }
          btn.classList.add('technology-tabs__copy--copied');
          const label = btn.querySelector('.technology-tabs__copy-label');
          if (label) label.textContent = 'Copied!';
          window.setTimeout(() => {
            btn.classList.remove('technology-tabs__copy--copied');
            if (label) label.textContent = 'Copy';
          }, 1500);
        });
      });
    });
  }

  // Initial paint.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupTechnologyTabs, { once: true });
  } else {
    setupTechnologyTabs();
  }
  // Astro view-transitions (if/when enabled) — re-bind any new instances.
  document.addEventListener('astro:page-load', setupTechnologyTabs);
</script>

<style>
  /* ============================================================
     Technology tabs — visual parity with Expressive Code blocks.
     Outer frame, header strip, divider and code body all share
     the same M3 surface / outline-variant tokens used by the
     `.expressive-code` styling in `custom.css`, so a fenced
     EC block and a TechnologyTabs block read as one family.
     ============================================================ */
  .technology-tabs {
    margin-block: 1.75rem;
    border: 1px solid var(--md-sys-color-outline-variant, var(--sl-color-gray-5));
    border-radius: var(--md-sys-shape-corner-large, 16px);
    overflow: hidden;
    background: var(--md-sys-color-surface, var(--sl-color-bg));
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.04),
      0 4px 12px rgb(0 0 0 / 0.05);
  }

  .technology-tabs__nav {
    display: flex;
    gap: 0;
    border-block-end: 1px solid var(--md-sys-color-outline-variant, var(--sl-color-gray-5));
    background: var(--md-sys-color-surface-container-low, var(--sl-color-gray-7));
    overflow-x: auto;
    scrollbar-width: none;
  }
  .technology-tabs__nav::-webkit-scrollbar {
    display: none;
  }

  .technology-tabs__tab {
    all: unset;
    box-sizing: border-box;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.125rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--md-sys-color-on-surface-variant);
    border-block-end: 2px solid transparent;
    transition:
      color 150ms ease,
      background-color 150ms ease,
      border-color 150ms ease;
    white-space: nowrap;
    position: relative;
  }

  /* Brand-coloured SVG icons — fills are baked into the path data, so
     the surrounding label can change colour with state (hover / active)
     while the logo stays recognisable. We use opacity, not colour, to
     indicate the inactive-vs-active state on the icon itself. */
  .technology-tabs__tab-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 20px;
    block-size: 20px;
    line-height: 1;
    opacity: 0.85;
    transition: opacity 150ms ease, transform 150ms ease;
  }

  .technology-tabs__tab-icon svg {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  /* Vue's two-tone logo has a dark navy inner triangle (#35495E) that
     practically disappears on the dark theme's near-black tab strip.
     Repaint it to the active on-surface token so it stays legible in
     both modes without losing the two-tone identity in light mode. */
  :root[data-theme='dark'] .technology-tabs__tab-icon .technology-tabs__vue-inner {
    fill: var(--md-sys-color-on-surface-variant, #cfcfcf);
  }

  .technology-tabs__tab:hover {
    color: var(--md-sys-color-on-surface);
    background: color-mix(in srgb, var(--md-sys-color-on-surface) 6%, transparent);
  }
  .technology-tabs__tab:hover .technology-tabs__tab-icon {
    opacity: 1;
  }

  .technology-tabs__tab:focus-visible {
    outline: 2px solid var(--md-sys-color-primary);
    outline-offset: -2px;
    border-radius: 6px;
  }

  .technology-tabs__tab--active {
    color: var(--md-sys-color-primary);
    border-block-end-color: var(--md-sys-color-primary);
    background: var(--md-sys-color-surface, transparent);
  }
  /* Active icon is full opacity. We *don't* override the SVG fill —
     brand colours stay intact so the React atom is always cyan, the
     Vue triangle is always green, etc. */
  .technology-tabs__tab--active .technology-tabs__tab-icon {
    opacity: 1;
  }

  .technology-tabs__panel {
    display: none;
  }
  .technology-tabs__panel--active {
    display: block;
  }

  /* ----------------------------------------------------------
     Code body. Shiki rendered at build time with dual themes
     (`github-light` + `github-dark`). It emits raw CSS variables
     (`--shiki-light` / `--shiki-dark`) on every token span; we
     bind the swap to Starlight's `data-theme` attribute below
     so the highlighter follows the same light/dark mode as the
     rest of the docs. We only own the layout (padding, scroll,
     font, sizing) — token colors stay in Shiki's hands.
     ---------------------------------------------------------- */
  .technology-tabs__code-wrapper {
    position: relative;
  }

  /* Shiki paints its own `--shiki-light-bg` / `--shiki-dark-bg`
     (e.g. `#24292e` for github-dark) which has a faint green cast
     against our neutral M3 surface — it looks like a different
     family from the surrounding frame. We override the body
     background to the M3 surface token (mode-aware on its own)
     so the code area merges with the rest of the card; Shiki
     keeps full control of the token foregrounds. */
  .technology-tabs__code :global(pre.shiki) {
    margin: 0;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.7;
    font-family:
      var(--sl-font-system-mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace);
    border: 0;
    border-radius: 0;
    box-shadow: none;
    tab-size: 2;
    background-color: var(--md-sys-color-surface) !important;
    color: var(--shiki-light);
  }

  .technology-tabs__code :global(pre.shiki span) {
    color: var(--shiki-light);
    background-color: transparent !important;
  }

  :root[data-theme='dark'] .technology-tabs__code :global(pre.shiki) {
    color: var(--shiki-dark);
  }
  :root[data-theme='dark'] .technology-tabs__code :global(pre.shiki span) {
    color: var(--shiki-dark);
  }

  .technology-tabs__code :global(pre.shiki code) {
    background: transparent;
    padding: 0;
    font-family: inherit;
    font-size: inherit;
    color: inherit;
    border-radius: 0;
    border: 0;
  }

  /* Always show the copy button on touch devices. Desktop reveal on hover. */
  .technology-tabs__copy {
    position: absolute;
    inset-block-start: 0.75rem;
    inset-inline-end: 0.75rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3125rem 0.75rem;
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-small, 8px);
    background: var(--md-sys-color-surface-container);
    color: var(--md-sys-color-on-surface-variant);
    cursor: pointer;
    opacity: 0;
    transition: opacity 150ms ease, background-color 150ms ease, color 150ms ease;
    font-size: 0.6875rem;
    font-weight: 500;
    font-family: var(--sl-font, system-ui, sans-serif);
  }

  .technology-tabs__code-wrapper:hover .technology-tabs__copy,
  .technology-tabs__code-wrapper:focus-within .technology-tabs__copy,
  .technology-tabs__copy:focus-visible {
    opacity: 1;
  }

  .technology-tabs__copy:hover {
    background: var(--md-sys-color-surface-container-high);
    color: var(--md-sys-color-on-surface);
  }
  .technology-tabs__copy:focus-visible {
    outline: 2px solid var(--md-sys-color-primary);
    outline-offset: 2px;
  }
  .technology-tabs__copy--copied {
    opacity: 1;
    color: var(--md-sys-color-tertiary, #16a34a);
    border-color: currentColor;
  }
  .technology-tabs__copy-label {
    line-height: 1;
  }

  @media (hover: none) {
    .technology-tabs__copy {
      opacity: 1;
    }
  }

  @media (max-width: 40rem) {
    .technology-tabs {
      margin-block: 1.25rem;
      border-radius: 12px;
    }
    .technology-tabs__tab {
      padding: 0.625rem 0.75rem;
      font-size: 0.75rem;
      gap: 0.375rem;
    }
    .technology-tabs__tab-icon {
      inline-size: 16px;
      block-size: 16px;
    }
    .technology-tabs__code :global(pre.shiki) {
      padding: 1rem;
      font-size: 0.75rem;
      line-height: 1.6;
    }
    .technology-tabs__copy {
      opacity: 1;
      padding: 0.1875rem 0.5rem;
    }
    .technology-tabs__copy-label {
      display: none;
    }
  }
</style>
