---
/**
 * Starlight <Head> override — registers the AWC UI custom elements.
 *
 * WHY THIS EXISTS
 *
 * The docs site rendered every component as inert markup. `<md-bar-chart>`,
 * `<md-tooltip>`, `<md-fab-menu>` and `<md-split-button>` showed a blank box;
 * simpler components looked half-right only because their slotted text still
 * renders without an upgrade. Measured in the browser: the element was in the
 * DOM, `hydrated` was false, and its shadow root was never created.
 *
 * The cause was simply that nothing ever called the loader. Every
 * `defineCustomElements` in this repo's docs lives inside an MDX code fence —
 * instructions for the reader, never executed by the site itself. So no
 * component upgraded on any page, in dev or in the static build.
 *
 * Registering here (rather than inside ComponentDemo/ChartDemo) means any
 * page can drop a component into prose and have it work, not just pages that
 * happen to use a demo wrapper. Astro bundles this script once and reuses it
 * across the site.
 *
 * Getting the chunks to load took three attempts, recorded so nobody repeats
 * them:
 *   - `/loader` and `/define` (which wraps it) resolve each component's chunk
 *     at runtime by URL. Astro's static build does not emit Stencil's lazy
 *     entry chunks, so every one 404s (`/_astro/md-bar-chart.entry.js`).
 *   - `dist/components/index.js` looked like the answer (it is the
 *     `dist-custom-elements` output) but that index exports only utilities —
 *     it defines no elements. Only the individual `md-*.js` modules
 *     self-register, and importing 79 of them by hand rots immediately.
 *   - What works: copy Stencil's own lazy build to `public/awc-runtime` (see
 *     the `sync-runtime` script) and hand the loader that URL, so it fetches
 *     chunks that actually exist. Lazy loading is preserved — a page only
 *     pulls the components it uses.
 */
import Default from '@astrojs/starlight/components/Head.astro';

const { entry, head, lang } = Astro.locals.starlightRoute;
const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const isNotFound = pathname === '/404/';
const componentMatch = pathname.match(/^\/components\/([^/]+)\/$/);
const canonical = String(
  head.find(({ tag, attrs }) => tag === 'link' && attrs?.rel === 'canonical')?.attrs?.href ??
    new URL(pathname, 'https://awc-ui.dev'),
);
const description =
  entry.data.description ??
  'Accessible Material Design 3 Web Components for React, Angular, Vue, Svelte, and plain HTML.';
const markdownAlternate = componentMatch
  ? `${canonical}readme.md`
  : 'https://awc-ui.dev/llm/awc-ui.main-llm.md';
const markdownTitle = componentMatch
  ? `${entry.data.title} component reference in Markdown`
  : 'AWC UI LLM specification in Markdown';
const frameworkKeywords = pathname.startsWith('/frameworks/react/')
  ? ['React components', 'React Web Components', 'Next.js SSR', 'React SSR']
  : pathname.startsWith('/frameworks/angular/')
    ? ['Angular components', 'Angular Web Components', 'Angular SSR', 'Angular forms']
    : pathname.startsWith('/frameworks/vue/')
      ? ['Vue components', 'Vue Web Components', 'Nuxt SSR', 'Vue SSR']
      : pathname.startsWith('/frameworks/svelte/')
        ? ['Svelte components', 'Svelte Web Components', 'SvelteKit SSR', 'Svelte 5']
        : pathname.startsWith('/frameworks/ssr/')
          ? ['Web Components SSR', 'server-side rendering', 'Declarative Shadow DOM', 'Next.js', 'Nuxt', 'SvelteKit', 'Angular SSR']
          : pathname.startsWith('/frameworks/web-components/')
            ? ['Web Components', 'custom elements', 'Web Components library', 'Material Design 3']
            : [];
const articleKeywords = [
  ...new Set(['AWC UI', 'Material Design 3', 'Web Components', ...frameworkKeywords]),
];

// Each Starlight content route is a first-class technical article. The home
// page already carries its richer WebSite + SoftwareApplication graph in its
// frontmatter, and the 404 must never advertise itself as indexable content.
const articleJsonLd = !isHome && !isNotFound
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'TechArticle',
      '@id': `${canonical}#article`,
      headline: entry.data.title,
      description,
      url: canonical,
      mainEntityOfPage: canonical,
      inLanguage: lang,
      isPartOf: { '@id': 'https://awc-ui.dev/#website' },
      about: { '@id': 'https://awc-ui.dev/#software' },
      keywords: articleKeywords.join(', '),
      publisher: {
        '@type': 'Organization',
        name: 'AWC UI',
        url: 'https://awc-ui.dev/',
      },
    }).replace(/</g, '\\u003c')
  : null;
---

<Default><slot /></Default>

<meta
  name="robots"
  content={isNotFound
    ? 'noindex, follow'
    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
/>
<link rel="alternate" type="text/markdown" href={markdownAlternate} title={markdownTitle} />
<link
  rel="alternate"
  type="text/plain"
  href="https://awc-ui.dev/llms.txt"
  title="AWC UI machine-readable documentation map"
/>
{articleJsonLd && <script type="application/ld+json" set:html={articleJsonLd} />}

{/* is:inline + an absolute URL keeps Vite's hands off it. loader.js then
    resolves its sibling chunks relative to its OWN location under
    /awc-runtime/esm/, which is the whole point — bundling it makes Stencil
    look for chunks in /_astro/ where they do not exist. (loader/cdn.js is
    CJS and throws "module is not defined" in a module script.) */}
<script is:inline type="module">
  /* md3.esm.js is Stencil's MINIFIED lazy build and self-registers on import —
     it exports no defineCustomElements. The previous entry (esm/loader.js) was
     the unminified bundler output: same components, ~2x the bytes. */
  import('/awc-runtime/md3/md3.esm.js').catch((err) =>
    console.error('[awc-ui] component registration failed', err),
  );
</script>
