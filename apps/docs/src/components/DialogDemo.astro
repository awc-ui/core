  <p>5. <strong>Changes.</strong> These terms may change over time. We will post a notice in the repository's CHANGELOG when material changes occur. Continued use after a change constitutes acceptance.</p>
  <p>6. <strong>Governing law.</strong> These terms are governed by the laws of the jurisdiction in which the maintainers reside. Any disputes will be resolved in that jurisdiction's courts.</p>
  <md-button slot="actions" variant="text" data-dialog-close="demo-long-dialog">Decline</md-button>
  <md-button slot="actions" variant="filled" data-dialog-close="demo-long-dialog">Accept</md-button>
</md-dialog>

<md-dialog id="demo-choice-dialog" headline="Phone ringtone" data-dialog-instance>
  <fieldset class="dialog-demo__radio-group">
    <legend class="dialog-demo__sr-only">Phone ringtone</legend>
    <label class="dialog-demo__radio-row"><md-radio name="ringtone" value="none"></md-radio><span>None</span></label>
    <label class="dialog-demo__radio-row"><md-radio name="ringtone" value="callisto" checked></md-radio><span>Callisto</span></label>
    <label class="dialog-demo__radio-row"><md-radio name="ringtone" value="ganymede"></md-radio><span>Ganymede</span></label>
    <label class="dialog-demo__radio-row"><md-radio name="ringtone" value="luna"></md-radio><span>Luna</span></label>
    <label class="dialog-demo__radio-row"><md-radio name="ringtone" value="oberon"></md-radio><span>Oberon</span></label>
  </fieldset>
  <md-button slot="actions" variant="text" data-dialog-close="demo-choice-dialog">Cancel</md-button>
  <md-button slot="actions" variant="filled" data-dialog-close="demo-choice-dialog">OK</md-button>
</md-dialog>

<md-dialog id="demo-header-divider-dialog" headline="What's new in v1.4" icon="rocket_launch" header-divider divider data-dialog-instance>
  <ul style="margin: 0; padding-inline-start: 20px; line-height: 1.6;">
    <li>Fullscreen dialogs now span the full viewport on every breakpoint</li>
    <li>Auto-generated event-listener tabs on every component page</li>
    <li>Hierarchical (tri-state) checkbox helper</li>
    <li>Removable chips on every variant via the new <code>removable</code> prop</li>
    <li>Theme generator: Material You key-color extraction from images</li>
  </ul>
  <md-button slot="actions" variant="filled" data-dialog-close="demo-header-divider-dialog">Got it</md-button>
</md-dialog>`;

// ── Section 3: Layout variants ────────────────────────────────────
//
// Fullscreen takes over the viewport (mobile-first edit flows). Custom
// headline drops the `headline` prop entirely and replaces it with rich
// slotted content — useful when you need an avatar, an icon stack, or
// a multi-line title that the prop's single-line ellipsis can't host.
const layoutCodeHtml = `<md-dialog id="profile-dialog" headline="Edit profile" fullscreen header-divider>
  <md-button slot="header-action" variant="filled" size="sm">Save</md-button>
  <md-text-field variant="outlined" label="Display name" value="AWC Dev"></md-text-field>
  <md-text-field variant="outlined" label="Email" type="email" value="dev@awcui.io"></md-text-field>
  <md-text-field variant="outlined" label="Bio" value="Building MD3 components in the open."></md-text-field>
</md-dialog>

<md-dialog id="share-dialog">
  <div slot="headline">
    <span>AWC Dev shared a file</span>
    <span>design-tokens-v2.fig · 2 MB</span>
  </div>
  <span>Open the file to review the proposed token changes.</span>
  <md-button slot="actions" variant="text">Later</md-button>
  <md-button slot="actions" variant="filled">Review now</md-button>
</md-dialog>`;

const layoutHtml = `<md-button data-dialog-open="demo-fullscreen-dialog" variant="tonal">Fullscreen</md-button>
<md-button data-dialog-open="demo-custom-headline-dialog" variant="tonal">Custom headline slot</md-button>

<md-dialog id="demo-fullscreen-dialog" headline="Edit profile" fullscreen header-divider data-dialog-instance>
  <md-button slot="header-action" variant="filled" size="sm" data-dialog-close="demo-fullscreen-dialog">Save</md-button>
  <div class="dialog-demo__form">
    <md-text-field variant="outlined" label="Display name" value="AWC Dev"></md-text-field>
    <md-text-field variant="outlined" label="Email" type="email" value="dev@awcui.io"></md-text-field>
    <md-text-field variant="outlined" label="Bio" value="Building MD3 components in the open."></md-text-field>
  </div>
</md-dialog>

<md-dialog id="demo-custom-headline-dialog" data-dialog-instance>
  <div slot="headline" class="dialog-demo__rich-headline">
    <span class="dialog-demo__avatar" aria-hidden="true">AD</span>
    <span class="dialog-demo__rich-headline-stack">
      <span class="dialog-demo__rich-headline-title">AWC Dev shared a file</span>
      <span class="dialog-demo__rich-headline-sub">design-tokens-v2.fig · 2 MB</span>
    </span>
  </div>
  <span>Open the file to review the proposed token changes. You can comment on individual values inline or leave a single review summary.</span>
  <md-button slot="actions" variant="text" data-dialog-close="demo-custom-headline-dialog">Later</md-button>
  <md-button slot="actions" variant="filled" data-dialog-close="demo-custom-headline-dialog">Review now</md-button>
</md-dialog>`;

const sections: Section[] = [
  {
    id: "common",
    label: "Common patterns",
    html: commonHtml,
    codeHtml: commonCodeHtml,
  },
  {
    id: "content",
    label: "Content variants",
    html: contentHtml,
    codeHtml: contentCodeHtml,
  },
  {
    id: "layout",
    label: "Layout variants",
    html: layoutHtml,
    codeHtml: layoutCodeHtml,
  },
];
---

<div class="dialog-demo-host">
  {
    sections.map((section) => (
      <ComponentDemo
        label={section.label}
        html={section.html}
        htmlForCode={section.codeHtml}
        storyId="components-dialog--playground"
      />
    ))
  }
</div>

<script>
  // Each docs page that imports <DialogDemo /> gets this single global
  // wiring + portal script. It deliberately queries the document
  // (not a scoped container) so a future page that mixes DialogDemo
  // with hand-rolled <md-dialog> instances gets the same behaviour.

  type DialogEl = HTMLElement & {
    open: boolean;
    show: () => Promise<void>;
    close: () => Promise<void>;
  };

  // Portal each dialog to <body> on first run.
  //
  // `position: fixed` is only "fixed to the viewport" when no ancestor
  // creates a containing block. Starlight's article column has
  // ancestors that may apply transform/filter/contain/will-change
  // (page-in animations, scroll-reveal staggers, backdrop blurs). Any
  // of those traps the dialog inside the article box, leaving the
  // side-nav and TOC painting on top of it. Moving the dialog node to
  // <body> guarantees zero ancestors with those properties, so the
  // dialog reaches the actual viewport edges.
  function portalDialogs(): void {
    document
      .querySelectorAll<HTMLElement>("md-dialog[data-dialog-instance]")
      .forEach((dialog) => {
        if (dialog.dataset.dialogPortaled === "true") return;
        if (dialog.parentElement === document.body) {
          dialog.dataset.dialogPortaled = "true";
          return;
        }
        document.body.appendChild(dialog);
        dialog.dataset.dialogPortaled = "true";
      });
  }

  function teardownPortaledDialogs(): void {
    document
      .querySelectorAll<HTMLElement>("md-dialog[data-dialog-portaled]")
      .forEach((dialog) => {
        dialog.remove();
      });
  }

  // Resolve `data-dialog-open="foo"` to the actual <md-dialog id="foo">
  // by tag-scoping the lookup. We CAN'T use `getElementById` here:
  // the readme's "Variants" section emits headings like
  //   <h3 id="basic-dialog">Basic dialog</h3>
  // whose Starlight-generated slug collides with the live-demo dialog
  // ids. After `portalDialogs()` moves the dialog to the END of <body>
  // the heading wins tree order, so `getElementById` returned the
  // <h3> (no `.show()` method, no `open` setter that does anything)
  // and clicks silently no-oped. A `md-dialog#id` selector filters by
  // tag first, so headings can never match. `CSS.escape` guards
  // against future ids that contain selector-special characters.
  function findDialog(id: string): DialogEl | null {
    return document.querySelector<HTMLElement>(
      `md-dialog#${CSS.escape(id)}`,
    ) as DialogEl | null;
  }

  function wireDialogTriggers(): void {
    document
      .querySelectorAll<HTMLElement>("[data-dialog-open]")
      .forEach((trigger) => {
        if (trigger.dataset.dialogWired === "true") return;
        trigger.dataset.dialogWired = "true";
        trigger.addEventListener("click", () => {
          const id = trigger.dataset.dialogOpen;
          if (!id) return;
          const dialog = findDialog(id);
          if (!dialog) return;
          // Prefer the public method so internal focus / scrim wiring
          // runs; fall back to the property in case the component is
          // still hydrating on the very first click.
          if (typeof dialog.show === "function") {
            void dialog.show();
          } else {
            dialog.open = true;
          }
        });
      });

    document
      .querySelectorAll<HTMLElement>("[data-dialog-close]")
      .forEach((trigger) => {
        if (trigger.dataset.dialogWired === "true") return;
        trigger.dataset.dialogWired = "true";
        trigger.addEventListener("click", () => {
          const id = trigger.dataset.dialogClose;
          if (!id) return;
          const dialog = findDialog(id);
          if (!dialog) return;
          if (typeof dialog.close === "function") {
            void dialog.close();
          } else {
            dialog.open = false;
          }
        });
      });
  }

  function bootstrap(): void {
    portalDialogs();
    wireDialogTriggers();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bootstrap, { once: true });
  } else {
    bootstrap();
  }
  document.addEventListener("astro:page-load", bootstrap);
  // Strip portaled dialogs before the next page swap so they don't
  // leak into other docs pages.
  document.addEventListener("astro:before-preparation", teardownPortaledDialogs);
</script>

<style is:global>
  /* These styles must be `is:global` because the dialog markup is
     injected into <ComponentDemo> via `set:html` — Astro's default
     scoped styles don't reach `set:html`'d content. We namespace
     every selector under `.dialog-demo__*` so they don't leak into
     unrelated pages. */

  /* Form layout used by Form / Fullscreen dialog bodies. */
  .dialog-demo__form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-block: 8px;
  }

  /* Single-choice list (radio group) layout. */
  .dialog-demo__radio-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 0;
    border: none;
  }

  .dialog-demo__radio-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-block: 6px;
    cursor: pointer;
    color: var(--md-sys-color-on-surface, inherit);
  }

  .dialog-demo__sr-only {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Rich headline slot — small avatar circle + two-line title + sub. */
  .dialog-demo__rich-headline {
    display: flex;
    align-items: center;
    gap: 12px;
    inline-size: 100%;
  }

  .dialog-demo__avatar {
    flex: 0 0 auto;
    inline-size: 40px;
    block-size: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--md-sys-color-primary, #6750a4);
    color: var(--md-sys-color-on-primary, #ffffff);
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }

  .dialog-demo__rich-headline-stack {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-inline-size: 0;
  }

  .dialog-demo__rich-headline-title {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--md-sys-color-on-surface, inherit);
  }

  .dialog-demo__rich-headline-sub {
    font-size: 0.8125rem;
    color: var(--md-sys-color-on-surface-variant, var(--sl-color-gray-3));
  }
</style>
