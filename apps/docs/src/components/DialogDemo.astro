---
// DialogDemo.astro
//
// Multi-section live demo for `md-dialog`. Each section renders as its
// own `<ComponentDemo>` so the docs page reads like the Button page —
// a labelled preview surface above, a collapsible per-technology code
// strip (HTML / React / Angular / Vue / Svelte) below, auto-derived
// from the same HTML the live preview renders.
//
// `<ComponentDemo>` uses `set:html`, which does NOT execute inline
// script tags. So:
//   1. The dialog instances live inside each section's `html` prop
//      (alongside the trigger buttons) — `set:html` happily hydrates
//      custom-elements, the loader picks them up on intersection.
//   2. The wiring (open / close / portal-to-body) ships in a single
//      module-level script at the bottom of THIS file. It runs once
//      per page-load, queries every `[data-dialog-open]` /
//      `[data-dialog-instance]` on the page (regardless of which
//      section it's in) and binds listeners + portals dialogs to
//      `document.body` so they escape any ancestor stacking contexts
//      created by Starlight / Astro page-in animations.
//
// Adding a new section is two lines:
//   1. Append an entry to `sections` (label + html string).
//   2. The dialog code-tabs and the live preview both update from
//      that single source-of-truth.

import ComponentDemo from "./ComponentDemo.astro";

interface Section {
  id: string;
  label: string;
  /** Markup the live preview renders. Includes the demo-specific
   *  `data-dialog-open` / `data-dialog-close` / `data-dialog-instance`
   *  hooks the global wiring script binds to. */
  html: string;
  /** Idiomatic markup shown in the per-technology code tabs. Drops
   *  the demo-only `data-dialog-*` hooks in favour of the canonical
   *  `id` + `dialog.show()` / `dialog.close()` pattern a real app
   *  would use. */
  codeHtml: string;
}

// ── Section 1: Common patterns ─────────────────────────────────────
//
// The four most common confirmation-style dialogs. Each one demonstrates
// a single new prop layered on top of the previous: `headline` →
// `icon` → recolored destructive action → `scrim-dismissible="false"`.
const commonCodeHtml = `<md-button id="open-confirm" variant="filled">Basic</md-button>
<md-dialog id="confirm-dialog" headline="Reset settings?">
  <span>This will revert every preference back to factory defaults.</span>
  <md-button slot="actions" variant="text">Cancel</md-button>
  <md-button slot="actions" variant="filled">Reset</md-button>
</md-dialog>

<md-dialog id="permission-dialog" headline="Permission required" icon="lock">
  <span>AWC UI needs access to your camera to scan QR codes.</span>
  <md-button slot="actions" variant="text">Not now</md-button>
  <md-button slot="actions" variant="filled">Allow</md-button>
</md-dialog>

<md-dialog id="delete-dialog" headline="Delete this conversation?" icon="delete_forever" style="--md-dialog-icon-color: var(--md-sys-color-error);">
  <span>Once deleted, every message will be permanently removed.</span>
  <md-button slot="actions" variant="text">Cancel</md-button>
  <md-button slot="actions" variant="filled" style="--md-button-container-color: var(--md-sys-color-error); --md-button-label-color: var(--md-sys-color-on-error);">Delete</md-button>
</md-dialog>

<md-dialog id="purchase-dialog" headline="Confirm purchase" icon="shopping_cart" scrim-dismissible="false">
  <span>You're about to charge $24.99 to your card. The scrim is non-dismissible — choose an action.</span>
  <md-button slot="actions" variant="text">Cancel</md-button>
  <md-button slot="actions" variant="filled">Pay $24.99</md-button>
</md-dialog>`;

// Live-demo dialog ids are prefixed `demo-` so they can NEVER collide
// with Starlight-generated heading slugs in the readme (e.g. the
// "Variants" section emits <h3 id="basic-dialog">Basic dialog</h3>).
// The `htmlForCode` strings keep clean ids like `confirm-dialog`
// because that's what real apps would write — the prefix is purely
// a docs-site collision avoidance trick, not the documented pattern.
const commonHtml = `<md-button data-dialog-open="demo-basic-dialog" variant="filled">Basic</md-button>
<md-button data-dialog-open="demo-icon-dialog" variant="filled">With icon</md-button>
<md-button data-dialog-open="demo-destructive-dialog" variant="filled">Destructive</md-button>
<md-button data-dialog-open="demo-modal-dialog" variant="filled">Modal (no scrim dismiss)</md-button>

<md-dialog id="demo-basic-dialog" headline="Reset settings?" data-dialog-instance>
  <span>This will revert every preference back to factory defaults. You can re-apply your changes afterwards from the activity log.</span>
  <md-button slot="actions" variant="text" data-dialog-close="demo-basic-dialog">Cancel</md-button>
  <md-button slot="actions" variant="filled" data-dialog-close="demo-basic-dialog">Reset</md-button>
</md-dialog>

<md-dialog id="demo-icon-dialog" headline="Permission required" icon="lock" data-dialog-instance>
  <span>AWC UI needs access to your camera to scan QR codes. You can change this later in your browser settings.</span>
  <md-button slot="actions" variant="text" data-dialog-close="demo-icon-dialog">Not now</md-button>
  <md-button slot="actions" variant="filled" data-dialog-close="demo-icon-dialog">Allow</md-button>
</md-dialog>

<md-dialog id="demo-destructive-dialog" headline="Delete this conversation?" icon="delete_forever" data-dialog-instance style="--md-dialog-icon-color: var(--md-sys-color-error);">
  <span>Once deleted, every message in <strong>Project AWC</strong> will be permanently removed. This action cannot be undone.</span>
  <md-button slot="actions" variant="text" data-dialog-close="demo-destructive-dialog">Cancel</md-button>
  <md-button slot="actions" variant="filled" data-dialog-close="demo-destructive-dialog" style="--md-button-container-color: var(--md-sys-color-error); --md-button-label-color: var(--md-sys-color-on-error);">Delete</md-button>
</md-dialog>

<md-dialog id="demo-modal-dialog" headline="Confirm purchase" icon="shopping_cart" scrim-dismissible="false" data-dialog-instance>
  <span>You're about to charge <strong>$24.99</strong> to your card ending in <strong>•••• 4242</strong>. The scrim is non-dismissible — you must choose one of the actions below.</span>
  <md-button slot="actions" variant="text" data-dialog-close="demo-modal-dialog">Cancel</md-button>
  <md-button slot="actions" variant="filled" data-dialog-close="demo-modal-dialog">Pay $24.99</md-button>
</md-dialog>`;

// ── Section 2: Content variants ───────────────────────────────────
//
// Beyond a paragraph of copy: a form (text fields), long scrollable
// copy (with `divider` so the actions row gains a separator once
// content overflows), a single-choice list (radio group), and a
// release-notes layout that uses `header-divider` to mark the headline
// row off from a dense body.
const contentCodeHtml = `<md-dialog id="contact-dialog" headline="Add a contact">
  <md-text-field variant="outlined" label="Full name" required></md-text-field>
  <md-text-field variant="outlined" label="Email" type="email"></md-text-field>
  <md-text-field variant="outlined" label="Company"></md-text-field>
  <md-button slot="actions" variant="text">Cancel</md-button>
  <md-button slot="actions" variant="filled">Save contact</md-button>
</md-dialog>

<md-dialog id="terms-dialog" headline="Terms of service" icon="gavel" divider>
  <p><strong>Last updated: May 2026.</strong> Long body content scrolls inside the surface; the <code>divider</code> prop draws a rule between the body and the actions row once overflow kicks in.</p>
  <md-button slot="actions" variant="text">Decline</md-button>
  <md-button slot="actions" variant="filled">Accept</md-button>
</md-dialog>

<md-dialog id="ringtone-dialog" headline="Phone ringtone">
  <md-radio name="ringtone" value="callisto" checked></md-radio>
  <md-radio name="ringtone" value="ganymede"></md-radio>
  <md-radio name="ringtone" value="luna"></md-radio>
  <md-button slot="actions" variant="text">Cancel</md-button>
  <md-button slot="actions" variant="filled">OK</md-button>
</md-dialog>

<md-dialog id="release-dialog" headline="What's new in v1.4" icon="rocket_launch" header-divider divider>
  <ul>
    <li>Fullscreen dialogs span the full viewport on every breakpoint</li>
    <li>Hierarchical (tri-state) checkbox helper</li>
    <li>Removable chips on every variant</li>
  </ul>
  <md-button slot="actions" variant="filled">Got it</md-button>
</md-dialog>`;

const contentHtml = `<md-button data-dialog-open="demo-form-dialog" variant="outlined">Form</md-button>
<md-button data-dialog-open="demo-long-dialog" variant="outlined">Long content</md-button>
<md-button data-dialog-open="demo-choice-dialog" variant="outlined">Single-choice list</md-button>
<md-button data-dialog-open="demo-header-divider-dialog" variant="outlined">Header divider</md-button>

<md-dialog id="demo-form-dialog" headline="Add a contact" data-dialog-instance>
  <div class="dialog-demo__form">
    <md-text-field variant="outlined" label="Full name" required></md-text-field>
    <md-text-field variant="outlined" label="Email" type="email"></md-text-field>
    <md-text-field variant="outlined" label="Company"></md-text-field>
  </div>
  <md-button slot="actions" variant="text" data-dialog-close="demo-form-dialog">Cancel</md-button>
  <md-button slot="actions" variant="filled" data-dialog-close="demo-form-dialog">Save contact</md-button>
</md-dialog>

<md-dialog id="demo-long-dialog" headline="Terms of service" icon="gavel" divider data-dialog-instance>
  <p style="margin-block-start: 0;"><strong>Last updated: May 2026.</strong> Please read these terms carefully before using AWC UI in your project.</p>
  <p>1. <strong>Acceptable use.</strong> You may use the components in any commercial or non-commercial project, including products you sell. Attribution is appreciated but not required.</p>
