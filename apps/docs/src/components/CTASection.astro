---
import stats from "../data/stats.json";
---

<section class="awc-cta">
  <div class="awc-cta__bg" aria-hidden="true">
    <div class="awc-cta__shape awc-cta__shape--a"></div>
    <div class="awc-cta__shape awc-cta__shape--b"></div>
    <div class="awc-cta__shape awc-cta__shape--c"></div>
  </div>

  <div class="awc-cta__content" data-awc-reveal>
    <span class="awc-cta__eyebrow">
      <span class="material-symbols-outlined" aria-hidden="true">bolt</span>
      Get started
    </span>

    <h2 class="awc-cta__title">
      Start building<br/>
      <span class="awc-cta__title-accent">with AWC&nbsp;UI today.</span>
    </h2>

    <p class="awc-cta__lede">
      Install one package and build with any of the five supported technologies:
      {stats.componentCount}+&nbsp;components, {stats.unitTestCaseCount.toLocaleString("en-US")}&nbsp;unit
      tests, and WCAG&nbsp;2.1&nbsp;AA verification in CI.
    </p>

    <div class="awc-cta__actions">
      <a href="/getting-started/installation/" class="awc-cta__btn awc-cta__btn--filled">
        <span class="material-symbols-outlined" aria-hidden="true">terminal</span>
        Quick start guide
      </a>
      <a href="https://github.com/awc-ui/core" target="_blank" rel="noopener noreferrer" class="awc-cta__btn awc-cta__btn--outlined">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        Star on GitHub
      </a>
    </div>

    <div class="awc-cta__assurance">
      <span class="awc-cta__assurance-item">
        <span class="material-symbols-outlined" aria-hidden="true">verified</span>
        MIT licensed
      </span>
      <span class="awc-cta__assurance-item">
        <span class="material-symbols-outlined" aria-hidden="true">bolt</span>
        Zero config
      </span>
      <span class="awc-cta__assurance-item">
        <span class="material-symbols-outlined" aria-hidden="true">accessibility_new</span>
        WCAG&nbsp;2.1&nbsp;AA
      </span>
    </div>
  </div>
</section>

<style>
  .awc-cta {
    position: relative;
    overflow: hidden;
    background: var(--md-sys-color-surface);
    padding-block: clamp(4rem, 8vw, 7rem);
    padding-inline: clamp(1.5rem, 5vw, 4rem);
    text-align: center;
  }

  /* Expressive shape backdrop — three blurred tonal blobs in a triangle */
  .awc-cta__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .awc-cta__shape {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.5;
  }

  .awc-cta__shape--a {
    inset-block-start: -20%;
    inset-inline-start: -10%;
    inline-size: 50%;
    block-size: 80%;
    background: var(--md-sys-color-primary-container);
  }

  .awc-cta__shape--b {
    inset-block-end: -30%;
    inset-inline-end: -10%;
    inline-size: 55%;
    block-size: 80%;
    background: var(--md-sys-color-tertiary-container);
  }

  .awc-cta__shape--c {
    inset-block-start: 10%;
    inset-inline-start: 40%;
    inline-size: 30%;
    block-size: 50%;
    background: var(--md-sys-color-secondary-container);
    opacity: 0.35;
  }

  .awc-cta__content {
    position: relative;
    z-index: 1;
    max-inline-size: 720px;
    margin-inline: auto;
  }

  .awc-cta__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    padding-block: 0.375rem;
    padding-inline: 0.75rem 0.875rem;
    background: color-mix(in srgb, var(--md-sys-color-surface-container-high) 80%, transparent);
    border: 1px solid var(--md-sys-color-outline-variant);
    backdrop-filter: blur(10px);
    color: var(--md-sys-color-on-surface);
    border-radius: var(--md-sys-shape-corner-full, 9999px);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-block-end: 1.5rem;
  }

  .awc-cta__eyebrow .material-symbols-outlined {
    font-size: 16px;
    color: var(--md-sys-color-tertiary);
  }

  .awc-cta__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--md-sys-color-on-surface);
    margin: 0 0 1.25rem;
    text-wrap: balance;
  }

  .awc-cta__title-accent {
    background: linear-gradient(
      105deg,
      var(--md-sys-color-primary) 0%,
      var(--md-sys-color-tertiary) 60%,
      var(--md-sys-color-primary) 100%
    );
    background-size: 220% 100%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: awc-cta-shift 9s ease-in-out infinite;
  }

  @keyframes awc-cta-shift {
    0%, 100% { background-position: 0% 50%; }
    50%      { background-position: 100% 50%; }
  }

  .awc-cta__lede {
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--md-sys-color-on-surface-variant);
    margin: 0 0 2.25rem;
    text-wrap: pretty;
  }

  .awc-cta__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.875rem;
    flex-wrap: wrap;
    margin-block-end: 2rem;
  }

  .awc-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    block-size: 48px;
    padding-inline: 1.5rem;
    border-radius: var(--md-sys-shape-corner-full, 9999px);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition:
      transform var(--md-sys-motion-duration-medium2, 300ms) var(--awc-spring-spatial),
      box-shadow var(--md-sys-motion-duration-short4, 200ms) var(--awc-spring-effects),
      background var(--md-sys-motion-duration-short4, 200ms) var(--awc-spring-effects);
    will-change: transform;
  }

  .awc-cta__btn .material-symbols-outlined {
    font-size: 20px;
  }

  .awc-cta__btn--filled {
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
    box-shadow: var(--md-sys-elevation-2);
  }

  .awc-cta__btn--filled:hover {
    transform: translateY(-2px);
    box-shadow: var(--md-sys-elevation-4);
    color: var(--md-sys-color-on-primary);
    text-decoration: none;
  }

  .awc-cta__btn--outlined {
    background: var(--md-sys-color-surface-container-lowest);
    color: var(--md-sys-color-on-surface);
    border: 1px solid var(--md-sys-color-outline);
  }

  .awc-cta__btn--outlined:hover {
    background: var(--md-sys-color-surface-container-low);
    border-color: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-surface);
    text-decoration: none;
    transform: translateY(-1px);
  }

  .awc-cta__assurance {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .awc-cta__assurance-item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--md-sys-color-on-surface-variant);
  }

  .awc-cta__assurance-item .material-symbols-outlined {
    font-size: 16px;
    color: var(--md-sys-color-tertiary);
  }

  /* Responsive */
  @media (max-width: 40rem) {
    .awc-cta {
      padding-block: 3rem;
      padding-inline: 1rem;
    }

    .awc-cta__title {
      font-size: 1.875rem;
      line-height: 1.1;
    }

    .awc-cta__lede {
      font-size: 1rem;
      margin-block-end: 1.75rem;
    }

    .awc-cta__actions {
      flex-direction: column;
      gap: 0.75rem;
      align-items: stretch;
    }

    .awc-cta__btn {
      justify-content: center;
    }

    .awc-cta__assurance {
      gap: 0.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .awc-cta__title-accent {
      animation: none !important;
    }
  }
</style>
