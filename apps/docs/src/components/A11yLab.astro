---
// A11yLab.astro
//
// The live half of /showcase/a11y-lab/: a fenced demo region full of real
// AWC UI components, plus a "Run axe-core audit" button that dynamically
// imports axe-core (docs devDependency) IN THE READER'S BROWSER and runs it
// scoped to that region only. Results — rule passes, violations with rule
// ids, and needs-review items — render into an aria-live container below.
//
// axe-core is imported lazily inside the click handler, so it never touches
// the SSR build or the initial page payload. The custom-element loader
// follows the exact dev/build split ComponentDemo.astro uses (workspace
// package in dev, copied /awc-runtime bundle in production builds), and
// shares its `__awcUiLoaded` window flag so the two never double-load.
---

<section class="a11y-lab" data-a11y-lab>
  <div
    class="a11y-lab__region"
    data-lab-region
    role="group"
    aria-label="Accessibility lab demo region"
  >
    <p class="a11y-lab__region-caption">Demo region — everything inside this border is what the audit scans.</p>

    <div class="a11y-lab__row">
      <md-text-field
        label="Full name"
        supporting-text="As it appears on your ID"
        class="a11y-lab__field"
      ></md-text-field>
      <label class="a11y-lab__check">
        <md-checkbox></md-checkbox>
        Email me a copy of the report
      </label>
    </div>

    <md-tabs aria-label="Report sections" id="a11y-lab-tabs">
      <md-tab label="Summary"></md-tab>
      <md-tab label="Details"></md-tab>
      <md-tab label="History"></md-tab>
    </md-tabs>
    <md-tab-panels for="a11y-lab-tabs">
      <md-tab-panel>
        <p class="a11y-lab__panel-text">
          The summary panel. Arrow keys move between tabs; the panel content
          is wired to its tab with <code>aria-labelledby</code> automatically.
        </p>
      </md-tab-panel>
      <md-tab-panel>
        <p class="a11y-lab__panel-text">
          The details panel. Inactive panels are <code>inert</code>, so
          nothing in them is reachable by keyboard or screen reader.
        </p>
      </md-tab-panel>
      <md-tab-panel>
        <p class="a11y-lab__panel-text">
          The history panel. Three panels, one tab stop — the strip is a
          single <code>tablist</code>.
        </p>
      </md-tab-panel>
    </md-tab-panels>

    <div>
      <md-button variant="outlined" data-open-dialog>Open the sample dialog</md-button>
    </div>

    <md-table-container variant="outlined">
      <md-table column-template="2fr 1fr 1fr" label="Previous audit runs">
        <md-table-head>
          <md-table-row rowgroup="head">
            <md-table-cell head scope="col">Surface</md-table-cell>
            <md-table-cell head scope="col" numeric>Rules passed</md-table-cell>
            <md-table-cell head scope="col" numeric>Violations</md-table-cell>
          </md-table-row>
        </md-table-head>
        <md-table-body>
          <md-table-row value="run-1">
            <md-table-cell head scope="row">Button stories</md-table-cell>
            <md-table-cell numeric>34</md-table-cell>
            <md-table-cell numeric>0</md-table-cell>
          </md-table-row>
          <md-table-row value="run-2">
            <md-table-cell head scope="row">Form field stories</md-table-cell>
            <md-table-cell numeric>41</md-table-cell>
            <md-table-cell numeric>0</md-table-cell>
          </md-table-row>
          <md-table-row value="run-3">
            <md-table-cell head scope="row">Data table stories</md-table-cell>
            <md-table-cell numeric>38</md-table-cell>
            <md-table-cell numeric>0</md-table-cell>
          </md-table-row>
        </md-table-body>
      </md-table>
    </md-table-container>

    <md-dialog data-lab-dialog headline="Focus is trapped here">
      <p class="a11y-lab__panel-text">
        While this dialog is open, Tab cycles through its contents only, the
        page behind it is inert, and Escape or the button below returns focus
        to the trigger.
      </p>
      <md-button slot="action" variant="text" data-close-dialog>Close</md-button>
    </md-dialog>
  </div>

  <div class="a11y-lab__controls">
    <md-button variant="filled" data-run-audit>Run axe-core audit</md-button>
    <p class="a11y-lab__note">
      Loads axe-core on demand and audits the demo region above — in your
      browser, on this page, right now. Three document-level rules
      (<code>region</code>, <code>landmark-one-main</code>,
      <code>page-has-heading-one</code>) are excluded because the target is a
      page fragment, not a document.
    </p>
  </div>

  <div class="a11y-lab__results" data-results aria-live="polite"></div>
</section>

<style>
  .a11y-lab {
    display: grid;
    gap: 1.25rem;
    margin-block: 1.5rem;
  }
  .a11y-lab__region {
    display: grid;
    gap: 1.25rem;
    padding: 1.25rem;
    border: 2px dashed var(--sl-color-hairline, rgba(128, 128, 128, 0.4));
    border-radius: 12px;
  }
  .a11y-lab__region-caption {
    margin: 0;
    font-size: var(--sl-text-xs, 0.8125rem);
    color: var(--sl-color-gray-3, #666);
  }
  .a11y-lab__row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
  }
  .a11y-lab__field {
    flex: 1;
    min-width: 220px;
  }
  .a11y-lab__check {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    cursor: pointer;
  }
  .a11y-lab__panel-text {
    margin: 0.75rem 0 0;
  }
  .a11y-lab__controls {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }
  .a11y-lab__note {
    margin: 0;
    font-size: var(--sl-text-sm, 0.875rem);
    color: var(--sl-color-gray-3, #666);
  }
  .a11y-lab__results {
    display: grid;
    gap: 0.5rem;
  }
  .a11y-lab__results :global(.a11y-lab__summary) {
    font-weight: 600;
    margin: 0;
  }
  .a11y-lab__results :global(.a11y-lab__summary--clean) {
    color: var(--sl-color-green, #2f9e44);
  }
  .a11y-lab__results :global(.a11y-lab__summary--violations) {
    color: var(--sl-color-red, #d64545);
  }
  .a11y-lab__results :global(ul) {
    margin: 0;
    padding-inline-start: 1.25rem;
  }
  .a11y-lab__results :global(.a11y-lab__meta) {
    margin: 0;
    font-size: var(--sl-text-sm, 0.875rem);
    color: var(--sl-color-gray-3, #666);
  }
</style>

<script>
  // Same dev/build loader split as ComponentDemo.astro, sharing its
  // once-per-page flag so a page mixing both never loads the runtime twice.
  type WithLoaderFlag = typeof window & { __awcUiLoaded?: boolean };

  const loadElements = async () => {
    const w = window as WithLoaderFlag;
    if (w.__awcUiLoaded) return;
    w.__awcUiLoaded = true;
    try {
      if (import.meta.env.DEV) {
        const mod = await import("@awc-ui/core/loader");
        await mod.defineCustomElements(window);
      } else {
        const runtimeUrl = "/awc-runtime/md3/md3.esm.js";
        await import(/* @vite-ignore */ runtimeUrl);
        await customElements.whenDefined("md-button");
      }
    } catch (err) {
      console.warn("[AWC UI] Component loader failed:", err);
    }
  };

  type AxeNodeResult = { target: unknown[] };
  type AxeRuleResult = {
    id: string;
    impact?: string | null;
    description: string;
    nodes: AxeNodeResult[];
  };
  type AxeResults = {
    passes: AxeRuleResult[];
    violations: AxeRuleResult[];
    incomplete: AxeRuleResult[];
    testEngine?: { name?: string; version?: string };
  };

  const renderResults = (container: HTMLElement, results: AxeResults) => {
    container.textContent = "";

    const summary = document.createElement("p");
    const clean = results.violations.length === 0;
    summary.className =
      "a11y-lab__summary " +
      (clean ? "a11y-lab__summary--clean" : "a11y-lab__summary--violations");
    summary.textContent = clean
      ? "✓ " +
        results.passes.length +
        " rules passed, 0 violations in the demo region."
      : "✗ " +
        results.passes.length +
        " rules passed, " +
        results.violations.length +
        (results.violations.length === 1 ? " violation" : " violations") +
        " in the demo region.";
    container.appendChild(summary);

    if (!clean) {
      const list = document.createElement("ul");
      for (const v of results.violations) {
        const li = document.createElement("li");
        const code = document.createElement("code");
        code.textContent = v.id;
        li.appendChild(code);
        const impact = v.impact ? " (" + v.impact + ")" : "";
        li.appendChild(
          document.createTextNode(
            impact +
              " — " +
              v.description +
              " — " +
              v.nodes.length +
              (v.nodes.length === 1 ? " element" : " elements"),
          ),
        );
        list.appendChild(li);
      }
      container.appendChild(list);
    }

    const meta = document.createElement("p");
    meta.className = "a11y-lab__meta";
    const engine = results.testEngine;
    const engineLabel =
      engine && engine.name
        ? engine.name + (engine.version ? " " + engine.version : "")
        : "axe-core";
    meta.textContent =
      engineLabel +
      " · " +
      results.incomplete.length +
      " checks need manual review · audited just now, in this browser tab";
    container.appendChild(meta);
  };

  const setup = () => {
    const lab = document.querySelector<HTMLElement>("[data-a11y-lab]");
    if (!lab || lab.dataset.wired === "true") return;
    lab.dataset.wired = "true";

    loadElements();

    const region = lab.querySelector<HTMLElement>("[data-lab-region]");
    const resultsEl = lab.querySelector<HTMLElement>("[data-results]");
    if (!region || !resultsEl) return;

    // The loader is async, so the custom elements are inert markup for a
    // moment. Wiring properties before upgrade would set own-properties that
    // shadow Stencil's accessors — wait for the first hydrated descendant,
    // exactly like ComponentDemo does.
    const t0 = Date.now();
    const wire = () => {
      if (!region.querySelector(".hydrated")) {
        if (Date.now() - t0 < 20000) setTimeout(wire, 60);
        return;
      }

      type DialogEl = HTMLElement & { open: boolean };
      type ButtonEl = HTMLElement & { disabled: boolean };
      const dialog = lab.querySelector<DialogEl>("[data-lab-dialog]");
      const openBtn = lab.querySelector<HTMLElement>("[data-open-dialog]");
      const closeBtn = lab.querySelector<HTMLElement>("[data-close-dialog]");
      const runBtn = lab.querySelector<ButtonEl>("[data-run-audit]");

      if (dialog && openBtn) {
        openBtn.addEventListener("click", () => {
          dialog.open = true;
        });
      }
      if (dialog && closeBtn) {
        closeBtn.addEventListener("click", () => {
          dialog.open = false;
        });
      }

      if (!runBtn) return;
      runBtn.addEventListener("click", async () => {
        runBtn.disabled = true;
        runBtn.textContent = "Auditing…";
        resultsEl.textContent = "";
        try {
          // Lazy on purpose: axe-core is ~500 KB of rules that only the
          // people who press this button should ever download.
          const mod = await import("axe-core");
          const axe = (mod.default ?? mod) as {
            run: (el: Element, opts: object) => Promise<AxeResults>;
          };
          const results = await axe.run(region, {
            // Document-level rules are meaningless for a fragment target.
            rules: {
              region: { enabled: false },
              "landmark-one-main": { enabled: false },
              "page-has-heading-one": { enabled: false },
            },
          });
          renderResults(resultsEl, results);
        } catch (err) {
          resultsEl.textContent =
            "The audit failed to run: " +
            (err instanceof Error ? err.message : String(err));
        } finally {
          runBtn.disabled = false;
          runBtn.textContent = "Run axe-core audit";
        }
      });
    };
    wire();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setup, { once: true });
  } else {
    setup();
  }
  document.addEventListener("astro:page-load", setup);
</script>
