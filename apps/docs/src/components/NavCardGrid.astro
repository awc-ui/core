---
/**
 * NavCardGrid — a responsive grid of navigational "destination" cards used by
 * the documentation overview pages (Getting Started home, Components overview,
 * etc.). Each card is a tonal MD3 surface with a leading icon, title, blurb,
 * and an optional badge. Hovering lifts the card and nudges the trailing
 * arrow — the same spring-motion language used by the landing sections.
 *
 * All colour / shape / elevation / motion comes from --md-sys-* tokens (with
 * the convenience --awc-* easings from custom.css), so the grid is fully
 * dark-mode aware and RTL-safe (logical properties throughout).
 *
 * Usage (from .mdx):
 *   import NavCardGrid from "../../components/NavCardGrid.astro";
 *   <NavCardGrid cards={[
 *     { title: "Installation", description: "...", href: "/getting-started/installation/", icon: "download", tone: "primary" },
 *   ]} columns={2} />
 */

interface NavCard {
  title: string;
  description: string;
  href: string;
  /** Material Symbols Outlined glyph name. */
  icon?: string;
  /** Tonal accent — rotates the icon pill + hover border colour. */
  tone?: 'primary' | 'secondary' | 'tertiary';
  /** Optional pill rendered in the card's top-right corner. */
  badge?: string;
  /** Opens in a new tab with rel="noopener" when true. */
  external?: boolean;
}

interface Props {
  cards: NavCard[];
  /** Preferred max columns on wide viewports (2 or 3). Defaults to 2. */
  columns?: 2 | 3;
}

const { cards = [], columns = 2 } = Astro.props;
---

<div class="awc-navgrid" data-columns={columns}>
  {cards.map((card) => (
    <a
      class={`awc-navcard awc-navcard--${card.tone ?? 'primary'}`}
      href={card.href}
      {...(card.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
    >
      {card.icon && (
        <span class="awc-navcard__icon" aria-hidden="true">
          <span class="material-symbols-outlined">{card.icon}</span>
        </span>
      )}

      <span class="awc-navcard__body">
        <span class="awc-navcard__heading">
          <span class="awc-navcard__title">{card.title}</span>
          {card.badge && <span class="awc-navcard__badge">{card.badge}</span>}
        </span>
        <span class="awc-navcard__text">{card.description}</span>
      </span>

      <span class="awc-navcard__arrow material-symbols-outlined" aria-hidden="true">
        {card.external ? 'open_in_new' : 'arrow_forward'}
      </span>
    </a>
  ))}
</div>

<style>
  .awc-navgrid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-block: 1.75rem;
  }

  .awc-navgrid[data-columns='3'] {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .awc-navcard {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem 1.375rem;
    border-radius: var(--md-sys-shape-corner-large, 16px);
    background: var(--md-sys-color-surface-container-lowest);
    border: 1px solid var(--md-sys-color-outline-variant);
    text-decoration: none;
    color: var(--md-sys-color-on-surface);
    overflow: hidden;
    isolation: isolate;
    transition:
      transform var(--md-sys-motion-duration-medium2, 300ms) var(--awc-spring-spatial),
      box-shadow var(--md-sys-motion-duration-medium2, 300ms) var(--awc-spring-effects),
      border-color var(--awc-dur-default) var(--awc-spring-effects);
  }

  .awc-navcard:hover {
    transform: translateY(-3px);
    box-shadow: var(--md-sys-elevation-2);
    text-decoration: none;
    color: var(--md-sys-color-on-surface);
  }

  .awc-navcard--primary:hover {
    border-color: var(--md-sys-color-primary);
  }
  .awc-navcard--secondary:hover {
    border-color: var(--md-sys-color-secondary);
  }
  .awc-navcard--tertiary:hover {
    border-color: var(--md-sys-color-tertiary);
  }

  /* Leading icon pill — tonal per accent family. */
  .awc-navcard__icon {
    flex-shrink: 0;
    inline-size: 44px;
    block-size: 44px;
    display: inline-grid;
    place-items: center;
    border-radius: var(--md-sys-shape-corner-medium, 12px);
    transition: transform var(--md-sys-motion-duration-medium2, 300ms) var(--awc-spring-spatial);
  }

  .awc-navcard--primary .awc-navcard__icon {
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }
  .awc-navcard--secondary .awc-navcard__icon {
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
  }
  .awc-navcard--tertiary .awc-navcard__icon {
    background: var(--md-sys-color-tertiary-container);
    color: var(--md-sys-color-on-tertiary-container);
  }

  .awc-navcard:hover .awc-navcard__icon {
    transform: scale(1.06) rotate(-4deg);
  }

  .awc-navcard__icon .material-symbols-outlined {
    font-size: 24px;
  }

  .awc-navcard__body {
    display: flex;
    flex-direction: column;
    gap: 0.3125rem;
    min-inline-size: 0;
  }

  .awc-navcard__heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .awc-navcard__title {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--md-sys-color-on-surface);
  }

  .awc-navcard__badge {
    display: inline-block;
    padding-block: 0.125rem;
    padding-inline: 0.5rem;
    border-radius: var(--md-sys-shape-corner-full, 9999px);
    background: var(--md-sys-color-tertiary-container);
    color: var(--md-sys-color-on-tertiary-container);
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.4;
  }

  .awc-navcard__text {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--md-sys-color-on-surface-variant);
  }

  .awc-navcard__arrow {
    margin-inline-start: auto;
    align-self: center;
    font-size: 20px;
    color: var(--md-sys-color-on-surface-variant);
    transition:
      transform var(--awc-dur-default) var(--awc-spring-spatial),
      color var(--awc-dur-default) var(--awc-spring-effects);
  }

  .awc-navcard:hover .awc-navcard__arrow {
    color: var(--md-sys-color-primary);
    transform: translateX(3px);
  }

  /* RTL: the forward arrow should point toward the inline-end, which is the
     left in RTL — mirror it so it always reads as "continue". */
  :global([dir='rtl']) .awc-navcard__arrow {
    transform: scaleX(-1);
  }
  :global([dir='rtl']) .awc-navcard:hover .awc-navcard__arrow {
    transform: scaleX(-1) translateX(3px);
  }

  @media (max-width: 50rem) {
    .awc-navgrid,
    .awc-navgrid[data-columns='3'] {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .awc-navcard,
    .awc-navcard__icon,
    .awc-navcard__arrow {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
