---
interface Props { sensitive?: boolean; }
const production = import.meta.env.PROD && import.meta.env.CONTEXT === 'production';
const { sensitive = false } = Astro.props;
const meta = production && !sensitive && import.meta.env.PUBLIC_META_MEASUREMENT_ENABLED === 'true';
const reddit = production && !sensitive && import.meta.env.PUBLIC_REDDIT_MEASUREMENT_ENABLED === 'true';
const googleMeasurement = production && !sensitive && import.meta.env.PUBLIC_GOOGLE_MEASUREMENT_ENABLED === 'true';
---
<meta data-advertising-config data-production={String(production)} data-google={String(!sensitive)} data-meta={String(meta)} data-reddit={String(reddit)} data-google-measurement={String(googleMeasurement)} />
<script>
  import { initializeAdvertisingConsent } from '../scripts/advertising-consent';
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeAdvertisingConsent, { once: true });
  } else {
    initializeAdvertisingConsent();
  }
</script>
<style is:global>
  .awc-advertising {
    --advertising-surface: var(--md-sys-color-surface-container, light-dark(#f3edf7, #211f26));
    --advertising-text: var(--md-sys-color-on-surface, light-dark(#1d1b20, #e6e0e9));
    --advertising-muted: var(--md-sys-color-on-surface-variant, light-dark(#49454f, #cac4d0));
    --advertising-accent: var(--md-sys-color-primary, light-dark(#6750a4, #d0bcff));
    --advertising-outline: var(--md-sys-color-outline-variant, light-dark(#cac4d0, #49454f));
    font: 400 0.875rem/1.5 system-ui, sans-serif;
    color: var(--advertising-text);
  }
  .awc-advertising [hidden] { display: none !important; }
  .awc-advertising-panel {
    box-sizing: border-box;
    position: fixed;
    z-index: 10000;
    inset: auto 1.5rem max(1.25rem, env(safe-area-inset-bottom)) 1.5rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 2rem;
    width: min(64rem, calc(100% - 3rem));
    max-height: calc(100dvh - 2.5rem);
    margin-inline: auto;
    overflow: auto;
    padding: 1.25rem 3.5rem 1.25rem 1.5rem;
    border: 1px solid var(--advertising-outline);
    border-radius: 1.25rem;
    background: var(--advertising-surface);
    box-shadow: 0 8px 32px #0002;
  }
  .awc-advertising h2 { margin: 0 0 0.375rem; font-size: 0.9375rem; font-weight: 650; line-height: 1.4; letter-spacing: -0.01em; }
  .awc-advertising p { margin: 0; color: var(--advertising-muted); }
  .awc-advertising .awc-advertising-details { margin-top: 0.5rem; font-size: 0.75rem; }
  .awc-advertising a { margin-left: 0.375rem; color: var(--advertising-accent); text-decoration: underline; text-underline-offset: 3px; }
  .awc-advertising button {
    box-sizing: border-box;
    min-height: 44px;
    padding: 0.625rem 1.25rem;
    border: 1px solid var(--advertising-outline);
    border-radius: 2rem;
    font: inherit;
    font-weight: 600;
    color: var(--advertising-text);
    background: transparent;
    cursor: pointer;
    transition: background-color 150ms ease, border-color 150ms ease;
  }
  .awc-advertising button:hover { background: color-mix(in srgb, var(--advertising-accent) 8%, transparent); border-color: var(--advertising-accent); }
  .awc-advertising-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.625rem; min-width: 12.5rem; }
  .awc-advertising .awc-advertising-close { position: absolute; top: 0.375rem; right: 0.375rem; display: grid; place-items: center; width: 44px; padding: 0; border-color: transparent; color: var(--advertising-muted); }
  .awc-advertising :focus-visible { outline: 2px solid var(--advertising-accent); outline-offset: 3px; }
  .awc-advertising .awc-advertising-preferences { position: fixed; z-index: 9999; bottom: max(0.75rem, env(safe-area-inset-bottom)); left: 0.75rem; padding-inline: 1rem; font-size: 0.75rem; font-weight: 500; background: var(--advertising-surface); box-shadow: 0 2px 8px #0001; }
  .awc-advertising [data-advertising-status] { grid-column: 1 / -1; padding-top: 0.75rem; font-size: 0.75rem; }
  .awc-advertising [data-advertising-status]:empty { display: none; }
  @media (max-width: 680px) {
    .awc-advertising-panel { inset-inline: 0.75rem; bottom: max(0.75rem, env(safe-area-inset-bottom)); width: calc(100% - 1.5rem); max-height: calc(100dvh - 1.5rem); grid-template-columns: minmax(0, 1fr); gap: 1rem; padding: 1.125rem; border-radius: 1.125rem; }
    .awc-advertising h2 { padding-right: 1.5rem; }
    .awc-advertising-actions { min-width: 0; }
    .awc-advertising [data-advertising-status] { padding-top: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .awc-advertising button { transition: none; }
  }
</style>
