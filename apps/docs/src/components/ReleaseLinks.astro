---
import DocVersionSelect from './DocVersionSelect.astro';
import { Icon } from '@astrojs/starlight/components';
import { getRelease, npmUrl, githubUrl } from '../lib/release.mjs';

interface Props {
  variant?: 'compact' | 'hero';
}

const { variant = 'compact' } = Astro.props;
const { version, tag } = await getRelease();
const releaseLabel = `@awc-ui/core v${version} on npm${tag ? ` (${tag} tag)` : ''}`;
---

<div class:list={['awc-release-links', { 'awc-release-links--hero': variant === 'hero' }]}>
  {variant === 'compact' && <DocVersionSelect />}
  <a class="awc-release-links__npm" href={tag ? `${npmUrl}/v/${version}` : npmUrl} aria-label={releaseLabel} title={releaseLabel}>
    <Icon name="npm" size="1.125rem" />
    <span class="awc-release-links__label">npm</span>
    <span class="awc-release-links__version">v{version}</span>
  </a>
  <a href={githubUrl} aria-label="AWC UI source on GitHub">
    <Icon name="github" size="1.125rem" />
    <span class="awc-release-links__label">GitHub</span>
  </a>
</div>

<style>
  .awc-release-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .awc-release-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-block-size: 2.75rem;
    padding-inline: 0.625rem;
    border-radius: var(--md-sys-shape-corner-full, 9999px);
    color: var(--md-sys-color-on-surface-variant);
    text-decoration: none;
    white-space: nowrap;
  }

  .awc-release-links a:hover {
    background: var(--md-sys-color-surface-container-high);
    color: var(--md-sys-color-on-surface);
  }

  .awc-release-links a:focus-visible {
    outline: 2px solid var(--md-sys-color-primary);
    outline-offset: 2px;
  }

  .awc-release-links__version {
    padding: 0.25rem 0.5rem;
    border-radius: var(--md-sys-shape-corner-full, 9999px);
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
    font-variant-numeric: tabular-nums;
  }

  .awc-release-links--hero {
    padding-block-start: 0.875rem;
    gap: 0.5rem;
  }

  .awc-release-links--hero a {
    padding-inline: 0.875rem;
    border: 1px solid var(--md-sys-color-outline-variant);
  }

  :global(header) .awc-release-links {
    flex-wrap: nowrap;
  }

  @media (min-width: 50rem) and (max-width: 64rem) {
    :global(header) .awc-release-links__label {
      display: none;
    }
  }
</style>
