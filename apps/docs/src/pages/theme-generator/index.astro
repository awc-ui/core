      <footer class="tg-footer">
        <p>
          Theme generator powered by <code>@material/material-color-utilities</code>
          (Apache-2.0). Computation runs in a Web Worker for sub-200ms updates.
        </p>
      </footer>
    </main>

    <script>
      import ThemeWorker from "@awc-ui/theme/worker?worker";
      import {
        generateCss,
        tokenName,
        DEFAULT_SEED_COLORS,
        type PaletteKey,
        type RoleMap,
        type ThemeWorkerResponse,
      } from "@awc-ui/theme";

      type StateKey = "primary" | "secondary" | "tertiary";
      type Tones = Record<PaletteKey, Record<number, string>>;
      type WorkerResponse = ThemeWorkerResponse;

      const HEX_RE = /^#?[0-9a-fA-F]{6}$/;
      const DEBOUNCE_MS = 50;

      const state: Record<StateKey, string> = {
        primary: DEFAULT_SEED_COLORS.primary,
        secondary: DEFAULT_SEED_COLORS.secondary,
        tertiary: DEFAULT_SEED_COLORS.tertiary,
      };

      // Secondary and tertiary are DERIVED from primary unless the user opts out.
      // compute-theme.ts already does the derivation whenever the hex is absent
      // (same hue at chroma 16 for secondary, hue + 60 at chroma 24 for
      // tertiary) — the UI just has to send nothing instead of a seed.
      const derived: Record<"secondary" | "tertiary", boolean> = {
        secondary: true,
        tertiary: true,
      };

      let lastResponse: WorkerResponse | null = null;
      let mode: "light" | "dark" = "light";
      let contrastLevel = 0;

      // Map raw contrastLevel value → display label. Kept in sync with the
      // toolbar buttons so the intro paragraph's inline level name updates
      // automatically when the user changes contrast.
      const CONTRAST_LEVEL_LABELS: Record<string, string> = {
        "-1": "Reduced",
        "0": "Standard",
        "0.5": "Medium",
        "1": "High",
      };

      function contrastLevelLabel(level: number): string {
        return CONTRAST_LEVEL_LABELS[String(level)] ?? "Standard";
      }

      // ─── HEX UTILITIES ─────────────────────────────────────────────────
      function normalizeHex(v: string): string | null {
        const trimmed = v.trim();
        if (!HEX_RE.test(trimmed)) return null;
        return trimmed.startsWith("#") ? trimmed.toUpperCase() : `#${trimmed.toUpperCase()}`;
      }

      function hexToRgb(hex: string): [number, number, number] {
        const h = hex.startsWith("#") ? hex.slice(1) : hex;
        return [
          parseInt(h.slice(0, 2), 16),
          parseInt(h.slice(2, 4), 16),
          parseInt(h.slice(4, 6), 16),
        ];
      }

      // ─── WCAG 2.1 RELATIVE LUMINANCE & CONTRAST RATIO ──────────────────
      // Per WCAG 2.1: https://www.w3.org/TR/WCAG21/#dfn-relative-luminance
      // L = 0.2126*R + 0.7152*G + 0.0722*B with sRGB linearization.
      // Contrast ratio = (L1 + 0.05) / (L2 + 0.05), L1 > L2.
      function relativeLuminance(hex: string): number {
        const [r, g, b] = hexToRgb(hex).map((c) => {
          const sRGB = c / 255;
          return sRGB <= 0.03928
            ? sRGB / 12.92
            : Math.pow((sRGB + 0.055) / 1.055, 2.4);
        }) as [number, number, number];
        return 0.2126 * r + 0.7152 * g + 0.0722 * b;
      }

      function contrastRatio(fg: string, bg: string): number {
        const l1 = relativeLuminance(fg);
        const l2 = relativeLuminance(bg);
        const [light, dark] = l1 > l2 ? [l1, l2] : [l2, l1];
        return (light + 0.05) / (dark + 0.05);
      }

      // ─── ERROR / PICKER SYNC ───────────────────────────────────────────
      function setError(key: StateKey, msg: string) {
        const el = document.querySelector<HTMLElement>(`[data-error-for="${key}"]`);
        if (el) el.textContent = msg;
        const text = document.querySelector<HTMLInputElement>(
          `[data-color-text][data-key="${key}"]`,
        );
        text?.classList.toggle("tg-input__hex--invalid", !!msg);
      }

      function syncPicker(key: StateKey, hex: string) {
        const picker = document.querySelector<HTMLInputElement>(
          `[data-color-picker][data-key="${key}"]`,
        );
        if (picker && picker.value.toUpperCase() !== hex.toUpperCase()) {
          picker.value = hex;
        }
      }

      // ─── APPLY TONAL PALETTE TO SWATCHES ───────────────────────────────
      function applyPalette(tones: Tones) {
        for (const row of document.querySelectorAll<HTMLElement>("[data-palette-row]")) {
          const key = row.dataset.paletteRow as PaletteKey;
          const palette = tones[key];
          if (!palette) continue;
          for (const sw of row.querySelectorAll<HTMLElement>("[data-palette-tone]")) {
            const tone = Number(sw.dataset.paletteTone);
            const hex = palette[tone];
            if (!hex) continue;
            const colorEl = sw.querySelector<HTMLElement>("[data-swatch-color]");
            const hexEl = sw.querySelector<HTMLElement>("[data-swatch-hex]");
            if (colorEl) colorEl.style.backgroundColor = hex;
            if (hexEl) hexEl.textContent = hex;
          }
        }
      }

      // ─── APPLY ROLE TOKENS TO PREVIEW PANEL ────────────────────────────
      // Writes the generated MD3 color tokens directly onto the preview
      // panel element as inline CSS custom properties.
      //
      // Why inline `style.setProperty` instead of a global <style> rule?
      //   1. INLINE STYLE has the highest possible specificity (1,0,0,0),
      //      so it always wins over `:root { --md-sys-color-*: ... }` from
      //      `@awc-ui/tokens/tokens.css` — including the `[data-theme="dark"]`
      //      block that we'd otherwise have to fight via class selectors.
      //   2. CSS custom properties are inheriting, so children in light DOM
      //      (every <md-button>, <md-chip>, etc.) inherit them, and each
      //      component's shadow root reads them via the `:host` boundary.
      //   3. No selector mismatch / cache surprises — what we set is exactly
      //      what the elements see.
      function applyPreviewTokens(roles: RoleMap) {
        const panel = document.querySelector<HTMLElement>(
          "[data-preview-panel]",
        );
        if (!panel) return;
        for (const [role, hex] of Object.entries(roles)) {
          panel.style.setProperty(`--md-sys-color-${tokenName(role)}`, hex);
        }
      }

      // ─── CONTRAST RECOMMENDATIONS ──────────────────────────────────────
      // When a pair fails its threshold, surface a short headline plus a
      // longer, actionable explanation. The structure matches md-tooltip's
      // rich variant: subhead slot for the heading, content slot for the
      // body. Keyed on the foreground role so each recommendation can
      // pinpoint the source palette that's the weak link.
      type ContrastTip = { subhead: string; content: string };

      function recommend(fg: string, bg: string, ratio: number, minRatio: number): ContrastTip {
        const shortfall = (minRatio - ratio).toFixed(2);

        // Tail every recommendation with the same fallback advice: bumping
        // MD3's contrastLevel is *always* a valid way to clear a failing
        // pair, even when the source colours themselves are fine.
        const levelFix =
          ` Or raise the <em>Contrast</em> control above <strong>Standard</strong> — ` +
          `MD3 will automatically nudge tones to clear this pair.`;

        if (fg === "outline") {
          return {
            subhead: "Outline is too pale against Surface",
            content:
              `Short by <strong>${shortfall}</strong>. Increase your primary's chroma (a more saturated source colour). ` +
              "The Neutral Variant palette inherits its tint from primary's hue — a more vivid primary " +
              "produces a stronger outline tone." + levelFix,
          };
        }

        // Brand-colour text on a plain surface — the most common failure.
        // Caused by source colours that resolve to a too-light tone-40 in
        // light mode (or too-dark tone-80 in dark mode).
        if (
          (fg === "primary" || fg === "secondary" || fg === "tertiary" || fg === "error") &&
          (bg === "surface" || bg === "background" || bg === "surfaceContainerHigh")
        ) {
          const role = fg.charAt(0).toUpperCase() + fg.slice(1);
          return {
            subhead: `${role} is too close in lightness to ${bg}`,
            content:
              `Short by <strong>${shortfall}</strong>. Try one of: ` +
              `<ul><li>Pick a darker, more saturated <strong>${fg}</strong> source colour — HCT tone &lt; 40, chroma &gt; 30 works well.</li>` +
              `<li>Use the <code>on-${fg}-container</code> / <code>${fg}-container</code> pair instead — Material guarantees that pairing.</li>` +
              `<li>Raise the <em>Contrast</em> control above Standard — MD3 darkens tone-40 automatically.</li></ul>`,
          };
        }

        if (fg === "onSurfaceVariant" && bg === "surfaceContainerHigh") {
          return {
            subhead: "Body text contrast is too low",
            content:
              `Short by <strong>${shortfall}</strong>. Your primary's neutral palette is producing low-contrast body text. ` +
              "Pick a primary with HCT chroma between 16 and 40 — extreme low- or high-chroma primaries " +
              "push the neutral palette outside the 4.5:1 band." + levelFix,
          };
        }

        // Role-matched (on-X / X) failure is rare under MD3 TONAL_SPOT but
        // can happen with extreme source colours.
        if (fg.startsWith("on")) {
          const base = fg.slice(2).charAt(0).toLowerCase() + fg.slice(3);
          return {
            subhead: `Source colour for ${base} is too pale`,
            content:
              `Short by <strong>${shortfall}</strong>. The current source colour can't derive a contrasting ` +
              `<code>on-${base}</code> tone. Pick a darker, more saturated source colour to give the algorithm more headroom.` + levelFix,
          };
        }

        return {
          subhead: "Contrast below threshold",
          content: `Short by <strong>${shortfall}</strong>. Try a different source colour to push this pair above ${minRatio}:1.` + levelFix,
        };
      }

      // ─── APPLY CONTRAST PANEL ──────────────────────────────────────────
      // Each row carries its own minimum contrast ratio via `data-min-ratio`
      // (set from the `CONTRAST_PAIRS` tuple at render time). Text pairs
      // need 4.5:1 (WCAG AA SC 1.4.3), non-text UI like borders/dividers
      // only need 3:1 (SC 1.4.11). On failures we also surface a per-pair
      // recommendation via `recommend()` so users know which source colour
      // to nudge to clear the threshold.
      function applyContrast(roles: RoleMap) {
        for (const item of document.querySelectorAll<HTMLElement>("[data-contrast-item]")) {
          const fgRole = item.dataset.fg ?? "";
          const bgRole = item.dataset.bg ?? "";
          const fg = roles[fgRole];
          const bg = roles[bgRole];
          if (!fg || !bg) continue;

          const minRatio = Number(item.dataset.minRatio) || 4.5;
          const ratio = contrastRatio(fg, bg);
          const passes = ratio >= minRatio;

          const chip = item.querySelector<HTMLElement>("[data-contrast-chip]");
          if (chip) {
            chip.style.backgroundColor = bg;
            chip.style.color = fg;
            const label = chip.querySelector<HTMLElement>(".tg-contrast__chip-label");
            if (label) label.style.color = fg;
          }

          const ratioEl = item.querySelector<HTMLElement>("[data-contrast-ratio]");
          if (ratioEl) {
            // Show both the measured ratio and the threshold this pair is
            // tested against so a 3:1 "Outline / Surface" pair reads as a
            // pass even when its ratio is below 4.5:1.
            ratioEl.textContent = `${ratio.toFixed(2)}:1 (need \u2265 ${minRatio}:1)`;
          }

          item.classList.toggle("tg-contrast__item--fail", !passes);
          item.classList.toggle("tg-contrast__item--pass", passes);

          const status = item.querySelector<HTMLElement>("[data-contrast-status]");
          if (status) {
            const label = passes ? "AA" : "Fail";
            const aria = passes
              ? `Passes WCAG AA (\u2265 ${minRatio}:1)`
              : `Fails WCAG AA (\u2265 ${minRatio}:1 required)`;
            status.textContent = label;
            status.setAttribute("aria-label", aria);
          }

          // Populate the rich tooltip's subhead + content slots from the
          // recommendation. Tooltip itself is hidden while the pair
          // passes so the row stays compact.
          const tooltip = item.querySelector<HTMLElement>("[data-contrast-tooltip]");
          const subheadEl = item.querySelector<HTMLElement>("[data-contrast-tip-subhead]");
          const contentEl = item.querySelector<HTMLElement>("[data-contrast-tip-content]");
          if (tooltip && subheadEl && contentEl) {
            if (!passes) {
              const tip = recommend(fgRole, bgRole, ratio, minRatio);
              // `recommend()` returns hardcoded strings under our control,
              // so it's safe to render the HTML fragments (strong / ul /
              // code) via innerHTML. No user input is ever interpolated.
              subheadEl.innerHTML = tip.subhead;
              contentEl.innerHTML = tip.content;
              tooltip.hidden = false;
            } else {
              subheadEl.textContent = "";
              contentEl.textContent = "";
              tooltip.hidden = true;
            }
          }
        }
      }

      // ─── DENSITY ───────────────────────────────────────────────────────
      // Same mechanism the library ships: `data-density` on an ancestor, which
      // tokens.css turns into --md-sys-density-scale and every component reads.
      // Applied to the PANEL rather than <html> so the generator's own chrome
      // keeps its normal sizing while the preview condenses.
      function setDensity(next: string) {
        const panel = document.querySelector<HTMLElement>("[data-preview-panel]");
        if (!panel) return;
        if (next === "0") panel.removeAttribute("data-density");
        else panel.setAttribute("data-density", next);
      }

      // ─── MODE TOGGLE ───────────────────────────────────────────────────
      // Setting `data-theme` on the panel lets `tokens.css`'s
      // `[data-theme="dark"]` block kick in for everything we DON'T override
      // (e.g. surface-tint variants the worker doesn't emit), while our
      // inline panel styles still override the colors we DO emit. Belt and
      // braces — gives a sensible default if the worker fails or stalls.
      // ─── DATA-DRIVEN PREVIEW COMPONENTS ────────────────────────────────
      // Arrays and objects are JS PROPERTIES, never attributes. The elements
      // are lazily upgraded, so poll a frame at a time until each one exists
      // rather than assuming registration has already happened.
      function wire<T extends HTMLElement>(id: string, apply: (el: T) => void) {
        let tries = 0;
        const attempt = () => {
          const el = document.getElementById(id) as T | null;
          if (el) { apply(el); return; }
          if (++tries < 60) requestAnimationFrame(attempt);
        };
        requestAnimationFrame(attempt);
      }

      const CHART_IDS = [
        "tg-bar", "tg-line", "tg-area", "tg-pie", "tg-spark",
        "tg-donut", "tg-semi", "tg-bar-stacked", "tg-bar-h", "tg-area-pct",
        "tg-line-curve", "tg-spark-bar",
      ];

      function wirePreviewData() {
        const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun"];

        wire<any>("tg-bar", (el) => {
          el.xAxis = { data: months };
          el.series = [{ label: "Revenue", data: [12, 19, 7, 15, 22, 18] }];
        });
        wire<any>("tg-line", (el) => {
          el.xAxis = { data: months };
          el.series = [
            { label: "Sessions", data: [30, 42, 35, 51, 48, 60] },
            { label: "Signups", data: [12, 18, 16, 24, 21, 29] },
          ];
        });
        wire<any>("tg-area", (el) => {
          el.xAxis = { data: months };
          el.series = [
            { label: "Documents", data: [8, 12, 14, 18, 20, 24] },
            { label: "Media", data: [4, 6, 9, 11, 13, 16] },
          ];
        });
        wire<any>("tg-pie", (el) => {
          el.data = [
            { label: "Direct", value: 42 },
            { label: "Search", value: 31 },
            { label: "Social", value: 17 },
            { label: "Referral", value: 10 },
          ];
        });
        wire<any>("tg-spark", (el) => {
          el.data = [4, 7, 5, 9, 8, 12, 10, 14];
        });

        // ── Variations ────────────────────────────────────────────────────
        // Same data, different shape: what changes between them is which token
        // roles get exercised, which is the point of having them here.
        const traffic = [
          { label: "Direct", value: 42 },
          { label: "Search", value: 31 },
          { label: "Social", value: 17 },
          { label: "Referral", value: 10 },
        ];
        wire<any>("tg-donut", (el) => { el.data = traffic; });
        wire<any>("tg-semi", (el) => { el.data = traffic; });

        const stacked = [
          { label: "Mobile", data: [12, 19, 7, 15, 22, 18] },
          { label: "Desktop", data: [9, 11, 14, 10, 16, 13] },
          { label: "Tablet", data: [4, 6, 3, 7, 5, 8] },
        ];
        wire<any>("tg-bar-stacked", (el) => {
          el.xAxis = { data: months };
          el.series = stacked;
        });
        wire<any>("tg-bar-h", (el) => {
          el.xAxis = { data: ["Search", "Direct", "Social", "Referral"] };
          el.series = [{ label: "Sessions", data: [31, 42, 17, 10] }];
        });
        wire<any>("tg-area-pct", (el) => {
          el.xAxis = { data: months };
          el.series = stacked;
        });
        wire<any>("tg-line-curve", (el) => {
          el.xAxis = { data: months };
          el.series = [
            { label: "Sessions", data: [30, 42, 35, 51, 48, 60] },
            { label: "Signups", data: [12, 18, 16, 24, 21, 29] },
            { label: "Churn", data: [6, 5, 9, 7, 4, 6] },
          ];
        });
        wire<any>("tg-spark-bar", (el) => {
          el.data = [4, 7, 5, 9, 8, 12, 10, 14];
        });

        wire<any>("tg-transfer", (el) => {
          el.items = [
            { value: "read", label: "Read" },
            { value: "write", label: "Write" },
            { value: "deploy", label: "Deploy" },
            { value: "admin", label: "Admin" },
          ];
          el.value = ["read"];
        });

        wire<any>("tg-org", (el) => {
          el.nodes = [{
            id: "ceo", name: "Ada Lovelace", title: "CEO", children: [
              { id: "eng", name: "Grace Hopper", title: "Engineering" },
              { id: "des", name: "Alan Turing", title: "Design" },
            ],
          }];
        });
      }

      // Charts paint to canvas and read their colors at draw time, so a token
      // change does NOT repaint them the way it does for DOM components. Ask
      // each one to redraw after every recompute.
      function refreshCharts() {
        for (const id of CHART_IDS) {
          const el = document.getElementById(id) as any;
          if (!el) continue;
          // resize() alone does NOT repaint — it early-returns when the box has
          // not changed, so a pure token change left the old colors on the
          // canvas. Handing the data prop a new array identity trips Stencil's
          // prop watcher and forces a genuine re-render. replay() would also
          // work but re-runs the entrance animation on every keystroke.
          if (Array.isArray(el.series)) el.series = [...el.series];
          if (Array.isArray(el.data)) el.data = [...el.data];
          el.resize?.();
        }
      }

      // ─── DERIVE TOGGLES ────────────────────────────────────────────────
      // Reflect derived-ness into the two optional rows: their inputs go
      // disabled and show whatever primary produced, so the reader can see the
      // derived color without being able to edit a value that is not being sent.
      function syncDerivedRow(key: "secondary" | "tertiary") {
        const on = derived[key];
        const row = document.querySelector<HTMLElement>(`[data-input-for="${key}"]`);
        row?.classList.toggle("tg-input--derived", on);
        for (const sel of [`[data-color-text][data-key="${key}"]`, `[data-color-picker][data-key="${key}"]`]) {
          const el = document.querySelector<HTMLInputElement>(sel);
          if (el) el.disabled = on;
        }
        if (on && lastResponse) {
          // Show the color the engine actually derived, taken from the light
          // scheme so the field matches the swatch regardless of preview mode.
          const hex = lastResponse.roles.light[key as keyof typeof lastResponse.roles.light];
          if (typeof hex === "string") {
            const text = document.querySelector<HTMLInputElement>(`[data-color-text][data-key="${key}"]`);
            const pick = document.querySelector<HTMLInputElement>(`[data-color-picker][data-key="${key}"]`);
            if (text) text.value = hex.toUpperCase();
            if (pick) pick.value = hex.toLowerCase();
          }
        }
      }

      for (const box of document.querySelectorAll<HTMLInputElement>("[data-derive-toggle]")) {
        const key = box.dataset.key as "secondary" | "tertiary";
        box.addEventListener("change", () => {
          derived[key] = box.checked;
          syncDerivedRow(key);
          postCompute();
        });
        syncDerivedRow(key);
      }

      function setMode(next: "light" | "dark") {
        mode = next;
        const preview = document.querySelector<HTMLElement>("[data-live-preview]");
        if (preview) preview.dataset.mode = next;
        const panel = document.querySelector<HTMLElement>("[data-preview-panel]");
        if (panel) {
          if (next === "dark") panel.setAttribute("data-theme", "dark");
          else panel.removeAttribute("data-theme");
        }

      for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-mode-toggle]")) {
          const active = btn.dataset.modeToggle === next;
          btn.classList.toggle("tg-toggle--active", active);
          btn.setAttribute("aria-pressed", String(active));
        }

        if (lastResponse && lastResponse.type === "palette") {
          const roles = lastResponse.roles[next];
          applyPreviewTokens(roles);
          applyContrast(roles);
        }
      }

      function downloadTheme() {
        if (!lastResponse || lastResponse.type !== "palette") return;
        const css = generateCss(lastResponse);
        const blob = new Blob([css], { type: "text/css;charset=utf-8" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = "awc-ui-theme.css";
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      }

      // ─── WORKER & DEBOUNCE ─────────────────────────────────────────────
      const worker = new ThemeWorker();
      let timer: number | undefined;
      let pendingStart = 0;

      worker.addEventListener("message", (e: MessageEvent<WorkerResponse>) => {
        const data = e.data;
        if (data.type === "error") {
          console.error("[Theme Worker]", data.message);
          return;
        }
        lastResponse = data;
        applyPalette(data.tones);
        applyPreviewTokens(data.roles[mode]);
        applyContrast(data.roles[mode]);

        refreshCharts();

        // Derived rows mirror the freshly computed colors.
        for (const k of ["secondary", "tertiary"] as const) {
          if (derived[k]) syncDerivedRow(k);
        }

        const totalMs = Math.round(performance.now() - pendingStart);
        const perfEl = document.getElementById("tg-perf");
        if (perfEl) {
          perfEl.textContent =
            `Computed in ${totalMs}ms (worker: ${data.durationMs.toFixed(2)}ms)`;
        }

        const dl = document.getElementById("tg-download") as HTMLButtonElement | null;
        if (dl) dl.disabled = false;
      });

      function postCompute() {
        pendingStart = performance.now();
        worker.postMessage({
          type: "compute",
          primaryHex: state.primary,
          secondaryHex: derived.secondary ? "" : state.secondary,
          tertiaryHex: derived.tertiary ? "" : state.tertiary,
          contrastLevel,
        });
      }

      // Switching contrast level recomputes the whole theme via the worker
      // (cheap — sub-200ms). The intro paragraph reflects the active level
      // in plain English so the panel's text stays in sync with reality.
      function setContrastLevel(next: number) {
        contrastLevel = next;
        for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-contrast-toggle]")) {
          const value = Number(btn.dataset.contrastToggle);
          const active = value === next;
          btn.classList.toggle("tg-toggle--active", active);
          btn.setAttribute("aria-pressed", String(active));
        }
        const label = document.querySelector<HTMLElement>("[data-contrast-level-label]");
        if (label) label.textContent = contrastLevelLabel(next);
        scheduleCompute();
      }

      function scheduleCompute() {
        window.clearTimeout(timer);
        timer = window.setTimeout(postCompute, DEBOUNCE_MS);
      }

      function handleColorChange(key: StateKey, raw: string) {
        const normalized = normalizeHex(raw);
        if (!normalized) {
          setError(key, "Enter a 6-digit hex (e.g. #6750A4)");
          return;
        }
        setError(key, "");
        state[key] = normalized;
        syncPicker(key, normalized);
        scheduleCompute();
      }

      // ─── EVENT WIRING ──────────────────────────────────────────────────
      for (const input of document.querySelectorAll<HTMLInputElement>("[data-color-text]")) {
        const key = input.dataset.key as StateKey;
        input.addEventListener("input", () => handleColorChange(key, input.value));
        input.addEventListener("blur", () => {
          const normalized = normalizeHex(input.value);
          if (normalized) input.value = normalized;
        });
      }

      for (const picker of document.querySelectorAll<HTMLInputElement>("[data-color-picker]")) {
        const key = picker.dataset.key as StateKey;
        picker.addEventListener("input", () => {
          const text = document.querySelector<HTMLInputElement>(
            `[data-color-text][data-key="${key}"]`,
          );
          if (text) text.value = picker.value.toUpperCase();
          handleColorChange(key, picker.value);
        });
      }

      for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-mode-toggle]")) {
        btn.addEventListener("click", () => {
          const m = btn.dataset.modeToggle === "dark" ? "dark" : "light";
          setMode(m);
        });
      }

      for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-contrast-toggle]")) {
        btn.addEventListener("click", () => {
          const next = Number(btn.dataset.contrastToggle);
          if (Number.isFinite(next)) setContrastLevel(next);
        });
      }

      // md-select emits `mdChange` carrying the value in `detail` — it does not
      // fire a native `change`, so listening for that alone would silently do
      // nothing.
      const densitySelect = document.querySelector("[data-density-select]");
      densitySelect?.addEventListener("mdChange", (e) => {
        setDensity(String((e as CustomEvent<string>).detail));
      });

      const dlBtn = document.getElementById("tg-download");
      dlBtn?.addEventListener("click", downloadTheme);

      // ─── LAZY-LOAD AWC UI CUSTOM ELEMENTS ────────────────────────────
      // Components render as plain unstyled HTML until upgrade. We defer the
      // loader until the preview panel scrolls into view to avoid blocking
      // initial paint with custom-element registration.
      let elementsLoaded = false;
      const loadElements = async () => {
        if (elementsLoaded) return;
        elementsLoaded = true;
        try {
          // Dev and build need DIFFERENT loader paths (the recurring trap):
          // - dev: Vite's transform middleware refuses module-imports of /public
          //   files, so import the workspace package — Vite serves it fine.
          // - build: the npm specifier would bundle the loader into /_astro/,
          //   where Stencil's lazy entry chunks 404 — import the COPIED runtime.
          //   The URL sits in a variable because Rollup resolves literal dynamic
          //   imports even behind @vite-ignore and fails the build.
          let mod: { defineCustomElements: (win?: Window) => Promise<unknown> };
          if (import.meta.env.DEV) {
            mod = await import("@awc-ui/core/loader");
          } else {
            const runtimeUrl = "/awc-runtime/md3/md3.esm.js";
            await import(/* @vite-ignore */ runtimeUrl);
        await customElements.whenDefined("md-button");
        return;
          }
          await mod.defineCustomElements(window);
          wirePreviewData();
        } catch (err) {
          console.warn("[AWC UI] Component loader failed:", err);
        }
      };

      const previewSection = document.querySelector<HTMLElement>("[data-live-preview]");
      if (previewSection && "IntersectionObserver" in window) {
        const obs = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              obs.disconnect();
              loadElements();
            }
          },
          { rootMargin: "200px" },
        );
        obs.observe(previewSection);
      }

      // The toolbar's "What does Contrast do?" tooltip is an `md-tooltip`
      // that sits above the preview, so it can be interacted with before
      // the IntersectionObserver above ever fires. Kick the loader once
      // the browser is idle so toolbar custom elements upgrade ASAP after
      // first paint — without blocking that paint. Cheap because
      // `loadElements()` is idempotent.
      if ("requestIdleCallback" in window) {
        (window as unknown as { requestIdleCallback: (cb: () => void) => void })
          .requestIdleCallback(loadElements);
      } else {
        setTimeout(loadElements, 800);
      }

      // Initial paint with default colors.
      postCompute();
    </script>

