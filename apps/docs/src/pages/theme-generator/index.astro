        border-radius: 100px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--tg-success);
        background: rgba(30, 142, 62, 0.12);
      }

      .tg-contrast__item--fail .tg-contrast__status {
        color: var(--tg-error);
        background: rgba(179, 38, 30, 0.12);
      }

      .tg-palette__grid {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }

      .tg-palette__row {
        display: grid;
        grid-template-columns: 140px 1fr;
        gap: 1.25rem;
        align-items: center;
      }

      .tg-palette__label {
        font-weight: 600;
        font-size: 0.9375rem;
      }

      .tg-palette__swatches {
        display: grid;
        grid-template-columns: repeat(13, 1fr);
        gap: 0.375rem;
      }

      .tg-palette__swatch {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }

      .tg-palette__swatch-color {
        block-size: 56px;
        border-radius: 8px;
        border: 1px solid var(--tg-border);
        background: #f5f5f5;
        transition: background-color 0.15s ease;
      }

      .tg-palette__swatch-meta {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.125rem;
      }

      .tg-palette__swatch-tone {
        font-size: 0.6875rem;
        font-weight: 600;
        color: var(--tg-text-muted);
      }

      .tg-palette__swatch-hex {
        font-family: "JetBrains Mono", ui-monospace, monospace;
        font-size: 0.625rem;
        color: var(--tg-text-muted);
        letter-spacing: -0.02em;
      }

      .tg-footer {
        margin-block-start: 2.5rem;
        padding: 1.25rem;
        text-align: center;
        font-size: 0.875rem;
        color: var(--tg-text-muted);
        background: rgba(103, 80, 164, 0.04);
        border-radius: var(--tg-radius);
      }

      .tg-footer p {
        margin: 0;
      }

      @media (max-width: 64rem) {
        .tg-inputs {
          grid-template-columns: 1fr;
          gap: 1.25rem;
        }

        .tg-palette__row {
          grid-template-columns: 1fr;
          gap: 0.75rem;
        }

        .tg-palette__swatches {
          grid-template-columns: repeat(13, minmax(28px, 1fr));
        }

        .tg-palette__swatch-hex {
          display: none;
        }
      }

      @media (max-width: 40rem) {
        .tg-main {
          padding: 2rem 1rem 3rem;
        }

        .tg-inputs,
        .tg-preview,
        .tg-contrast,
        .tg-palette {
          padding: 1.25rem;
        }

        .tg-toolbar {
          flex-direction: column;
          align-items: stretch;
        }

        .tg-toggle-group,
        .tg-download {
          inline-size: 100%;
          justify-content: center;
        }

        .tg-palette__swatches {
          grid-template-columns: repeat(13, 1fr);
          gap: 0.25rem;
        }

        .tg-palette__swatch-color {
          block-size: 36px;
          border-radius: 6px;
        }

        .tg-palette__swatch-tone {
          font-size: 0.5625rem;
        }
      }
    </style>
