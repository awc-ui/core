        --md-tooltip-rich-subhead-color: var(--md-sys-color-on-surface, #1d1b20);
      }

      /* Widen the rich popup. md-tooltip caps the inner surface at
         max-inline-size: 320px inside its shadow DOM — too narrow for
         our multi-line recommendation copy with code chips and bullet
         lists. We reach through `::part(popup)` to relax that cap. */
      md-tooltip.tg-contrast__tooltip::part(popup) {
        max-inline-size: min(440px, calc(100vw - 32px));
        inline-size: max-content;
      }

