---
/*
 * /llm/ — AWC UI LLM specification page.
 *
 * Why a dedicated route (outside Starlight's content collection)?
 *   1. We need fine-grained control over the page-level CTAs
 *      ("Copy entire spec", "Download .md") that wrap the rendered
 *      markdown. Starlight content pages render markdown but don't
 *      give us first-class header actions like this.
 *   2. The page must serve the underlying .md file as a download
 *      asset (awc-ui.main-llm.md). Astro lets us colocate the
 *      raw file under src/pages/ and serve it via a dynamic route.
 *
 * The main-llm spec is the hand-written main-llm.md at the repo root,
 * imported as raw text
 * via Vite's ?raw query and render to HTML at build time with
 * `marked` so the styled doc stays in lockstep with the underlying
 * markdown file (single source of truth).
 *
 * The "Download" link points to a sibling route at
 *   /llm/awc-ui.main-llm.md
 * which is implemented by awc-ui.main-llm.md.ts (see this dir).
 */

import "@awc-ui/tokens/tokens.css";
import { marked } from "marked";
// @ts-ignore — Vite resolves ?raw at build time.
import mainLlmRaw from "../../../../../main-llm.md?raw";

const html = marked.parse(mainLlmRaw, {
  gfm: true,
  breaks: false,
}) as string;

// Drop the H1 from the rendered HTML — the page has its own header.
// `marked` always emits one <h1> for the leading `# ...`. Strip it
// out to avoid the title-twice look.
const htmlWithoutTitle = html.replace(/<h1[^>]*>[^<]*<\/h1>\s*/, "");

const sizeKb = (mainLlmRaw.length / 1024).toFixed(0);
const lineCount = mainLlmRaw.split("\n").length;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AWC UI — LLM Specification</title>
    <meta
      name="description"
      content="The operator's manual for AI agents building production apps with AWC UI. Paste into your agent's system prompt at sprint start."
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
    />
  </head>
  <body>
    <header class="page-header">
      <a href="/" class="back-link">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        Back to docs
      </a>

      <div class="hero">
        <span class="hero__pill">For AI agents</span>
        <h1 class="hero__title">AWC UI &mdash; LLM Specification</h1>
        <p class="hero__lede">
          The operator's manual for AI agents building production apps with
          AWC UI. Drop it into your agent's system prompt at sprint start
          &mdash; it ships the decision protocol, component matrix, token
          reference, page recipes, and top-10 anti-patterns in one file.
        </p>

        <div class="hero__meta">
          <span><strong>{lineCount}</strong> lines &middot; <strong>{sizeKb}</strong> KB</span>
          <span class="hero__meta-sep">·</span>
          <span>Hand-written &middot; <code>main-llm.md</code> at the repo root</span>
        </div>

        <div class="hero__actions">
          <button
            type="button"
            class="action-btn action-btn--primary"
            id="copy-all"
            data-spec-content={mainLlmRaw}
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="14" height="14" x="8" y="8" rx="2" />
              <path
                d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"
              />
            </svg>
            <span class="action-btn__label">Copy entire spec</span>
          </button>

          <a
            href="/llm/awc-ui.main-llm.md"
            download="awc-ui.main-llm.md"
            class="action-btn action-btn--outline"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 3v12" />
              <path d="m7 10 5 5 5-5" />
              <rect width="18" height="4" x="3" y="17" rx="1" />
            </svg>
            <span>Download .md</span>
          </a>

        </div>
      </div>
    </header>

    <main class="prose" set:html={htmlWithoutTitle} />

    <footer class="page-footer">
      <p>
        AWC UI &mdash; Material Design 3 web components. This spec is
        regenerated from source on every build; if it's stale, run
        <code>main-llm.md</code> at the repository root.
      </p>
    </footer>

    <script is:inline>
      (() => {
        const btn = document.getElementById("copy-all");
        if (!btn) return;
        btn.addEventListener("click", async () => {
          const payload = btn.getAttribute("data-spec-content") || "";
          try {
            await navigator.clipboard.writeText(payload);
            const label = btn.querySelector(".action-btn__label");
            const prev = label?.textContent;
            if (label) label.textContent = "Copied!";
            btn.classList.add("action-btn--copied");
            setTimeout(() => {
              if (label && prev) label.textContent = prev;
              btn.classList.remove("action-btn--copied");
            }, 1500);
          } catch (err) {
            console.warn("[llm] copy failed", err);
          }
        });
      })();
    </script>

    <style is:global>
      /* ════════════════════════════════════════════════════════════════
         /llm/ — AWC UI LLM spec page. Self-contained styles
         because this route lives outside Starlight (which would
         otherwise inject its own theme). Aims for a "spec document
         on a developer-facing portal" feel — quiet, high-contrast,
         very readable, with the surface tones of AWC UI itself.
         ════════════════════════════════════════════════════════════════ */

      :root {
        color-scheme: light dark;
      }

      [data-theme="dark"] {
        color-scheme: dark;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0;
        font-family: "Roboto", system-ui, -apple-system, sans-serif;
        background: var(--md-sys-color-surface);
        color: var(--md-sys-color-on-surface);
        line-height: 1.65;
      }

      /* ──────────────────────────────────────────────────────────────
         Hero / page header
         ──────────────────────────────────────────────────────────── */

      .page-header {
        padding: 32px 24px 48px;
        max-width: 1100px;
        margin: 0 auto;
        position: relative;
      }

      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.875rem;
        color: var(--md-sys-color-primary);
        text-decoration: none;
        margin-block-end: 32px;
        padding: 6px 12px;
        border-radius: var(--md-sys-shape-corner-full);
        transition: background 150ms ease;
      }

      .back-link:hover {
        background: color-mix(in srgb, var(--md-sys-color-primary) 10%, transparent);
      }

      .hero {
        max-width: 820px;
      }

      .hero__pill {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 6px 14px;
        border-radius: var(--md-sys-shape-corner-full);
        background: color-mix(in srgb, var(--md-sys-color-tertiary) 18%, transparent);
        color: var(--md-sys-color-on-tertiary-container, var(--md-sys-color-on-surface));
        margin-block-end: 16px;
      }

      .hero__title {
        font-size: clamp(2rem, 5vw, 3rem);
        line-height: 1.15;
        margin: 0 0 16px;
        color: var(--md-sys-color-on-surface);
        font-weight: 700;
        letter-spacing: -0.02em;
      }

      .hero__lede {
        font-size: 1.125rem;
        line-height: 1.6;
        color: var(--md-sys-color-on-surface-variant);
        margin: 0 0 20px;
      }

      .hero__lede em {
        font-style: italic;
        color: var(--md-sys-color-on-surface);
      }

      .hero__meta {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.8125rem;
        color: var(--md-sys-color-on-surface-variant);
        margin-block-end: 24px;
        flex-wrap: wrap;
      }

      .hero__meta-sep {
        opacity: 0.5;
      }

      .hero__meta code {
        font-family: ui-monospace, "JetBrains Mono", monospace;
        font-size: 0.75rem;
        background: var(--md-sys-color-surface-container-low);
        padding: 1px 6px;
        border-radius: 4px;
      }

      .hero__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      .action-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: var(--md-sys-shape-corner-full);
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 150ms ease;
        border: 1px solid transparent;
        text-decoration: none;
        font-family: inherit;
      }

      .action-btn:hover {
        transform: translateY(-1px);
      }

      .action-btn--primary {
        background: var(--md-sys-color-primary);
        color: var(--md-sys-color-on-primary);
        border-color: var(--md-sys-color-primary);
      }

      .action-btn--primary:hover {
        background: color-mix(in srgb, var(--md-sys-color-primary) 90%, white 10%);
      }

      .action-btn--copied {
        background: var(--md-sys-color-tertiary, var(--md-sys-color-primary));
        border-color: var(--md-sys-color-tertiary, var(--md-sys-color-primary));
        color: var(--md-sys-color-on-tertiary, var(--md-sys-color-on-primary));
      }

      .action-btn--outline {
        background: transparent;
        color: var(--md-sys-color-primary);
        border-color: var(--md-sys-color-outline);
      }

      .action-btn--outline:hover {
        background: color-mix(in srgb, var(--md-sys-color-primary) 8%, transparent);
        border-color: var(--md-sys-color-primary);
      }

      .action-btn--ghost {
        background: transparent;
        color: var(--md-sys-color-on-surface-variant);
        border-color: transparent;
      }

      .action-btn--ghost:hover {
        color: var(--md-sys-color-primary);
        background: color-mix(in srgb, var(--md-sys-color-primary) 6%, transparent);
      }

      /* ──────────────────────────────────────────────────────────────
         Rendered markdown — `.prose` is the standard "long-form
         technical document" container. Mirrors the rhythm of GitHub
         README rendering, dialled up for readability.
         ──────────────────────────────────────────────────────────── */

      .prose {
        max-width: 880px;
        margin: 0 auto 96px;
        padding: 0 24px;
        font-size: 1rem;
      }

      .prose h2 {
        font-size: 1.875rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        margin: 64px 0 16px;
        padding-block-end: 12px;
        border-block-end: 1px solid var(--md-sys-color-outline-variant);
        color: var(--md-sys-color-on-surface);
        scroll-margin-block-start: 24px;
      }

      .prose h3 {
        font-size: 1.375rem;
        font-weight: 600;
        margin: 40px 0 12px;
        color: var(--md-sys-color-on-surface);
      }

      .prose h4 {
        font-size: 1.125rem;
        font-weight: 600;
        margin: 24px 0 8px;
        color: var(--md-sys-color-on-surface);
      }

      .prose p {
        margin: 0 0 16px;
        color: var(--md-sys-color-on-surface);
      }

      .prose strong {
        color: var(--md-sys-color-on-surface);
        font-weight: 600;
      }

      .prose em {
        font-style: italic;
      }

      .prose a {
        color: var(--md-sys-color-primary);
        text-decoration: underline;
        text-underline-offset: 2px;
        text-decoration-thickness: 1px;
        text-decoration-color: color-mix(
          in srgb,
          var(--md-sys-color-primary) 50%,
          transparent
        );
        transition: text-decoration-color 150ms ease;
      }

      .prose a:hover {
        text-decoration-color: var(--md-sys-color-primary);
      }

      .prose code {
        font-family: ui-monospace, "JetBrains Mono", monospace;
        font-size: 0.85em;
        background: var(--md-sys-color-surface-container);
        padding: 2px 6px;
        border-radius: 4px;
        color: var(--md-sys-color-primary);
      }

      .prose pre {
        margin: 16px 0 24px;
        padding: 16px 20px;
        background: var(--md-sys-color-surface-container-lowest);
        border: 1px solid var(--md-sys-color-outline-variant);
        border-radius: var(--md-sys-shape-corner-medium);
        overflow-x: auto;
        font-size: 0.85rem;
        line-height: 1.55;
        position: relative;
      }

      .prose pre::before {
        content: "";
        position: absolute;
        inset-block: 0;
        inset-inline-start: 0;
        inline-size: 3px;
        background: var(--md-sys-color-primary);
        border-radius: 4px 0 0 4px;
      }

      .prose pre code {
        background: transparent;
        padding: 0;
        color: var(--md-sys-color-on-surface);
        font-size: inherit;
      }

      .prose ul,
      .prose ol {
        margin: 0 0 20px;
        padding-inline-start: 28px;
      }

      .prose li {
        margin-block-end: 6px;
      }

      .prose li code {
        font-size: 0.8125em;
      }

      .prose blockquote {
        margin: 16px 0;
        padding: 12px 20px;
        border-inline-start: 4px solid var(--md-sys-color-primary);
        background: color-mix(in srgb, var(--md-sys-color-primary) 5%, transparent);
        border-radius: 0 var(--md-sys-shape-corner-small) var(--md-sys-shape-corner-small) 0;
        color: var(--md-sys-color-on-surface-variant);
      }

      .prose blockquote p {
        margin: 0;
      }

      .prose blockquote strong {
        color: var(--md-sys-color-primary);
      }

      .prose table {
        width: 100%;
        margin: 16px 0 24px;
        border-collapse: collapse;
        font-size: 0.875rem;
        display: block;
        overflow-x: auto;
      }

      .prose thead {
        background: var(--md-sys-color-surface-container);
      }

      .prose th,
      .prose td {
        padding: 10px 14px;
        text-align: start;
        border-block-end: 1px solid var(--md-sys-color-outline-variant);
      }

      .prose th {
        font-weight: 600;
        color: var(--md-sys-color-on-surface);
        white-space: nowrap;
      }

      .prose td {
        vertical-align: top;
      }

      .prose td code {
        white-space: nowrap;
      }

      .prose hr {
        margin: 56px 0;
        border: 0;
        border-block-start: 1px solid var(--md-sys-color-outline-variant);
      }

      .prose:has(> h2:first-child) > h2:first-child {
        margin-block-start: 0;
      }

      /* ──────────────────────────────────────────────────────────────
         Footer
         ──────────────────────────────────────────────────────────── */

      .page-footer {
        max-width: 880px;
        margin: 0 auto;
        padding: 24px;
        text-align: center;
        color: var(--md-sys-color-on-surface-variant);
        font-size: 0.8125rem;
        border-block-start: 1px solid var(--md-sys-color-outline-variant);
      }

      .page-footer code {
        font-family: ui-monospace, "JetBrains Mono", monospace;
        background: var(--md-sys-color-surface-container);
        padding: 1px 6px;
        border-radius: 4px;
      }
    </style>
  </body>
</html>
