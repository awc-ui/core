# Storybook base URL for iframe embeds
# Local dev: http://localhost:6006
# Production: /storybook (served from the same domain)
PUBLIC_STORYBOOK_URL=/storybook

# Public build configuration only. PR builds always force the form off.
PUBLIC_WAITLIST_ENABLED=false
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_WAITLIST_CONTROLLER_NAME=
PUBLIC_WAITLIST_CONTACT_ADDRESS=

# Optional server signup measurement: production only, explicit visitor consent.
# These flags do not control the separately consented basic Google Ads tag.
PUBLIC_META_MEASUREMENT_ENABLED=false
PUBLIC_REDDIT_MEASUREMENT_ENABLED=false
PUBLIC_GOOGLE_MEASUREMENT_ENABLED=false

# Runtime credentials and switches belong in Netlify Production / Functions.
# See waitlist/README.md. Never place mailbox passwords or secret keys here.
