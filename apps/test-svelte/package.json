{
  "name": "@awc-ui/test-svelte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:ct": "pnpm --filter @awc-ui/core build && playwright test -c playwright-ct.config.ts",
    "test:ct:coverage": "pnpm --filter @awc-ui/core build && rm -rf coverage .cache playwright/.cache && playwright test -c playwright-ct.config.ts"
  },
  "dependencies": {
    "@awc-ui/core": "workspace:*",
    "@awc-ui/tokens": "workspace:*",
    "material-icons": "^1.13.14",
    "material-symbols": "^0.40.2",
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@playwright/experimental-ct-react": "1.62.1",
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "monocart-reporter": "^2.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.4.0",
    "vite": "^6.4.3"
  }
}
