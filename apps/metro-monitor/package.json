{
  "name": "@awc-ui/metro-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Metro station monitoring showcase built with AWC UI",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1 --port 4387 --strictPort",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview --host 127.0.0.1 --port 4387 --strictPort",
    "test": "node --test src/*.test.mjs"
  },
  "dependencies": {
    "@awc-ui/core": "workspace:*",
    "@awc-ui/react": "workspace:*",
    "@awc-ui/theme": "workspace:*",
    "@fontsource/roboto": "^5.3.0",
    "material-symbols": "^0.40.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@stencil/react-output-target": "1.6.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0"
  }
}
