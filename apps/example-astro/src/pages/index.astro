---
import '@awc-ui/core/css/tokens.css';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AWC UI — Astro SSR (DSD)</title>
  </head>
  <body style="margin:0">
    <main style="padding:40px;font-family:system-ui,sans-serif;display:grid;gap:20px;max-width:640px">
      <h1 style="margin:0">AWC UI — Astro (DSD)</h1>
      <p style="margin:0;color:#555">Rendered to Declarative Shadow DOM at build time, hydrated on the client.</p>
      <md-card variant="elevated">
        <div style="padding:20px;display:grid;gap:16px">
          <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
            <md-button variant="filled">Filled</md-button>
            <md-button variant="outlined">Outlined</md-button>
            <md-badge value="3"></md-badge>
          </div>
          <md-checkbox checked>Server-checked</md-checkbox>
        </div>
      </md-card>
    </main>
    <script>
      // Client-only: register the custom elements so the build-time DSD hydrates.
      import { defineCustomElements } from '@awc-ui/core/loader';
      defineCustomElements(window);
    </script>
  </body>
</html>
