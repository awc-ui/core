{
  "name": "@awc-ui/test-vue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:ct": "pnpm --filter @awc-ui/core build && playwright test -c playwright-ct.config.ts",
    "test:ct:coverage": "pnpm --filter @awc-ui/core build && rm -rf coverage .cache playwright/.cache && playwright test -c playwright-ct.config.ts"
  },
  "dependencies": {
    "@awc-ui/core": "workspace:*",
    "@awc-ui/tokens": "workspace:*",
    "material-icons": "^1.13.14",
    "material-symbols": "^0.40.2",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/experimental-ct-react": "^1.58.2",
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-vue": "^5.0.0",
    "monocart-reporter": "^2.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.0.0"
  }
}
