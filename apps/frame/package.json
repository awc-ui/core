{
  "name": "@awc-ui/frame",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frame \u2014 a YouTube-inspired video app showcasing AWC UI web components.",
  "scripts": {
    "dev": "node scripts/build-frameworks.mjs && node scripts/serve.mjs",
    "build": "node scripts/build-frameworks.mjs",
    "build:showcase": "node scripts/build-frameworks.mjs",
    "preview": "node scripts/serve.mjs",
    "lint": "node --check src/app.js && node --check src/model.js && node --check src/data.js && node --check src/player.js && node --check src/shell.js && node --check src/frameworks.js && node --check src/loading.js && node --check src/preboot.js",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@awc-ui/core": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vue": "^3.5.0",
    "svelte": "^4.2.19",
    "@angular/common": "~17.3.0",
    "@angular/compiler": "~17.3.0",
    "@angular/core": "~17.3.0",
    "@angular/platform-browser": "~17.3.0",
    "rxjs": "^7.8.0",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~17.3.0",
    "@angular/cli": "~17.3.0",
    "@angular/compiler-cli": "~17.3.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "parse5": "^7.3.0",
    "typescript": "~5.4.0",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
