{
  "$schema": "../../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false, "cache": { "enabled": false } },
  "projects": {
    "frame-angular": {
      "projectType": "application", "root": "", "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist", "index": "src/index.html", "browser": "src/main.ts",
            "tsConfig": "tsconfig.json", "polyfills": ["zone.js"],
            "baseHref": "./", "assets": [{ "glob": "**/*", "input": "../../.framework-assets", "output": "." }],
            "optimization": { "scripts": true, "styles": { "minify": true, "inlineCritical": false }, "fonts": false },
            "sourceMap": false, "extractLicenses": true
          }
        }
      }
    }
  }
}
