---
import '@awc-ui/core/css/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  currentPath?: string;
}

const { title, description, currentPath = '' } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/">Merrow <span>&amp;</span> Co</a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>Shop</a>
          <a href="/checkout" aria-current={currentPath === '/checkout' ? 'page' : undefined}>Checkout</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="site-footer__inner">
        <span>Merrow &amp; Co — honest homewares, made to be mended.</span>
        <span>Free UK delivery over £75 · 30-day returns</span>
      </div>
    </footer>

    <script>
      // Client-only: register the custom elements so the build-time DSD hydrates.
      import { defineCustomElements } from '@awc-ui/core/loader';
      defineCustomElements(window);
    </script>
  </body>
</html>
