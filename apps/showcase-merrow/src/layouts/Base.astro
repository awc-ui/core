---
import '@awc-ui/core/css/tokens.css';
import '../styles/global.css';
import { withBase } from '../lib/base';

interface Props {
  title: string;
  description: string;
  currentPath?: string;
}

const { title, description, currentPath = '' } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href={withBase('/')}>Merrow <span>&amp;</span> Co</a>
        <nav class="site-nav" aria-label="Primary">
          <a href={withBase('/')} aria-current={currentPath === '/' ? 'page' : undefined}>Shop</a>
          <a href={withBase('/checkout')} aria-current={currentPath === '/checkout' ? 'page' : undefined}>Checkout</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="site-footer__inner">
        <span>Merrow &amp; Co — honest homewares, made to be mended.</span>
        <span>Free UK delivery over £75 · 30-day returns</span>
      </div>
    </footer>

    {/*
      Client-only: register the custom elements so the build-time DSD hydrates.

      This MUST stay `is:inline` with a root-absolute URL. `@awc-ui/core/loader`
      resolves each component's lazy `*.entry.js` chunk relative to its own
      module URL; if Astro bundles it into /_astro/ (which it does for a normal
      <script>), every chunk 404s because Astro never emits Stencil's lazy
      chunks. Pointing at the shared runtime the docs site already ships at
      /awc-runtime/ makes the loader resolve siblings that actually exist, and
      keeps that one URL root-absolute on purpose — it is shared across every
      showcase and is NOT relative to this app's base path.
    */}
    <script is:inline type="module">
      import('/awc-runtime/md3/md3.esm.js').catch((err) =>
        console.error('[awc-ui] component registration failed', err),
      );
    </script>
  </body>
</html>
