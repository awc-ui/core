---
import Base from '../../layouts/Base.astro';
import { products, formatPrice, type Product } from '../../data/products';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const stars = [5, 4, 3, 2, 1] as const;
---
<Base
  title={`${product.name} — Merrow & Co`}
  description={`${product.blurb} ${formatPrice(product.price)}, rated ${product.rating} out of 5 by ${product.reviews} customers.`}
>
  <main>
    <md-breadcrumbs label="You are here" separator="›">
      <md-breadcrumb-item href="/" icon="home">Home</md-breadcrumb-item>
      <md-breadcrumb-item href="/">Shop</md-breadcrumb-item>
      <md-breadcrumb-item current>{product.name}</md-breadcrumb-item>
    </md-breadcrumbs>

    <div class="product-layout">
      <section class="gallery" aria-label="Product gallery">
        <div class={`gallery__main tone-${product.tone}`}>
          <md-skeleton
            variant="rounded"
            animation="wave"
            full-width
            height="380px"
            aria-label={`${product.name} photography loading`}
          ></md-skeleton>
        </div>
        <div class="gallery__thumbs">
          <md-skeleton variant="rounded" animation="pulse" width="88px" height="88px" announce="false"></md-skeleton>
          <md-skeleton variant="rounded" animation="pulse" width="88px" height="88px" announce="false"></md-skeleton>
          <md-skeleton variant="rounded" animation="pulse" width="88px" height="88px" announce="false"></md-skeleton>
        </div>
        <p class="gallery__note">Studio photography for this piece is on its way from the workshop.</p>
      </section>

      <md-card variant="outlined">
        <div class="buy-panel">
          <p class="product-card__category" style="margin:0">{product.category}</p>
          <h1 class="page-title" style="font: var(--md-sys-typescale-headline-medium-font)">{product.name}</h1>

          <div class="buy-panel__rating">
            <md-rating
              readonly
              precision="0.5"
              size="sm"
              value={String(product.rating)}
              rating-label={`Rated ${product.rating} out of 5`}
            ></md-rating>
            <a href="#reviews" style="color: var(--md-sys-color-primary)">{product.rating} · {product.reviews} reviews</a>
          </div>

          <span class="buy-panel__price">{formatPrice(product.price)}</span>

          <p style="margin:0; color: var(--md-sys-color-on-surface-variant)">{product.description}</p>

          <div class="product-card__tags">
            {product.tags.map((t) => (
              <md-chip variant="assist" density="-1" label={t}></md-chip>
            ))}
          </div>

          <div class="buy-panel__cart-row">
            <md-number-field
              id="qty-field"
              variant="outlined"
              label="Quantity"
              value="1"
              min="1"
              max="12"
              step="1"
              density="-1"
              supporting-text="Max 12 per order"
            ></md-number-field>
            <md-button
              id="add-to-cart"
              variant="filled"
              icon="shopping_bag"
              data-product-name={product.name}
              data-product-price={String(product.price)}
            >Add to basket</md-button>
          </div>

          <ul class="detail-list">
            {product.details.map((d) => <li>{d}</li>)}
          </ul>
        </div>
      </md-card>
    </div>

    <section id="reviews" aria-label="Customer reviews">
      <h2 class="section-title" style="margin-block-end: var(--md-sys-spacing-gap-md)">What customers say</h2>
      <md-card variant="filled">
        <div class="review-summary">
          <div class="review-summary__score">
            <span class="review-summary__number">{product.rating.toFixed(1)}</span>
            <md-rating
              readonly
              precision="0.5"
              size="sm"
              value={String(product.rating)}
              rating-label={`Average rating ${product.rating} out of 5`}
            ></md-rating>
            <span class="review-summary__count">{product.reviews} verified reviews</span>
          </div>
          <div class="review-summary__bars">
            {stars.map((s, i) => (
              <div class="review-bar">
                <span>{s} star</span>
                <md-meter
                  value={String(product.breakdown[i])}
                  max="100"
                  label={`${s} star reviews`}
                  color={s >= 4 ? 'success' : s === 3 ? 'warning' : 'error'}
                ></md-meter>
                <span class="review-bar__pct">{product.breakdown[i]}%</span>
              </div>
            ))}
          </div>
        </div>
      </md-card>
    </section>
  </main>

  <md-snackbar
    id="cart-toast"
    action="Checkout"
    closeable
    auto-hide-duration="5000"
  ></md-snackbar>

  <script>
    const qty = document.getElementById('qty-field') as any;
    const addButton = document.getElementById('add-to-cart') as HTMLElement | null;
    const toast = document.getElementById('cart-toast') as any;

    addButton?.addEventListener('mdClick', () => {
      const n = typeof qty?.value === 'number' && qty.value > 0 ? qty.value : 1;
      const name = addButton.dataset.productName || 'item';
      toast.message = n === 1 ? `Added ${name} to your basket` : `Added ${n} × ${name} to your basket`;
      toast.show();
    });

    toast?.addEventListener('mdAction', () => {
      window.location.assign('/checkout');
    });
  </script>
</Base>
