---
import Base from '../layouts/Base.astro';
import { products, formatPrice } from '../data/products';
import { withBase } from '../lib/base';

const categories = ['Tableware', 'Kitchen', 'Textiles', 'Decor'] as const;
---
<Base
  title="Shop all homewares — Merrow & Co"
  description="Browse the full Merrow & Co collection: stoneware tableware, cast-iron kitchenware, linen textiles and handblown decor, made to last."
  currentPath="/"
>
  <main>
    <md-breadcrumbs label="You are here" separator="›">
      <md-breadcrumb-item href={withBase('/')} icon="home">Home</md-breadcrumb-item>
      <md-breadcrumb-item current>Shop</md-breadcrumb-item>
    </md-breadcrumbs>

    <div>
      <h1 class="page-title">All homewares</h1>
      <p class="page-subtitle">
        Everything we make, in one place — stoneware, cast iron, linen and glass from
        small British workshops. Filter by room, or sort by price and rating.
      </p>
    </div>

    <div class="filter-bar">
      <div class="filter-bar__chips" role="group" aria-label="Filter by category">
        {categories.map((c) => (
          <md-chip variant="filter" label={c} data-filter={c}></md-chip>
        ))}
      </div>
      <md-select
        id="sort-select"
        class="filter-bar__sort"
        variant="outlined"
        label="Sort by"
        value="featured"
        density="-2"
      >
        <md-select-option value="featured" label="Featured"></md-select-option>
        <md-select-option value="price-asc" label="Price: low to high"></md-select-option>
        <md-select-option value="price-desc" label="Price: high to low"></md-select-option>
        <md-select-option value="rating" label="Highest rated"></md-select-option>
      </md-select>
    </div>

    <p class="result-count" id="result-count" aria-live="polite">
      Showing all {products.length} products
    </p>

    <div class="product-grid" id="product-grid">
      {products.map((p, i) => (
        <md-card
          variant="outlined"
          class="product-card"
          data-category={p.category}
          data-price={String(p.price)}
          data-rating={String(p.rating)}
          data-index={String(i)}
        >
          <div class="product-card__inner">
            <a
              class={`product-media tone-${p.tone}`}
              href={withBase(`/products/${p.slug}`)}
              aria-label={`${p.name} — view product`}
            ></a>
            <p class="product-card__category">{p.category}</p>
            <h2 class="product-card__name">
              <a href={withBase(`/products/${p.slug}`)}>{p.name}</a>
            </h2>
            <div class="product-card__rating">
              <md-rating
                readonly
                precision="0.5"
                size="sm"
                value={String(p.rating)}
                rating-label={`Rated ${p.rating} out of 5`}
              ></md-rating>
              <span>{p.rating} · {p.reviews} reviews</span>
            </div>
            <div class="product-card__tags">
              {p.tags.slice(0, 2).map((t) => (
                <md-chip variant="assist" density="-2" label={t}></md-chip>
              ))}
            </div>
            <div class="product-card__foot">
              <span class="price">{formatPrice(p.price)}</span>
              <md-button variant="tonal" href={withBase(`/products/${p.slug}`)}>View</md-button>
            </div>
          </div>
        </md-card>
      ))}
    </div>
  </main>

  <script>
    const grid = document.getElementById('product-grid')!;
    const count = document.getElementById('result-count')!;
    const sortSelect = document.getElementById('sort-select') as any;
    const chips = Array.from(document.querySelectorAll('md-chip[data-filter]'));
    const active = new Set<string>();

    const cards = () => Array.from(grid.querySelectorAll<HTMLElement>('.product-card'));

    function apply() {
      let visible = 0;
      for (const card of cards()) {
        const show = active.size === 0 || active.has(card.dataset.category || '');
        card.classList.toggle('is-hidden', !show);
        if (show) visible += 1;
      }

      const mode = (sortSelect && sortSelect.value) || 'featured';
      const sorted = cards().sort((a, b) => {
        const pa = Number(a.dataset.price);
        const pb = Number(b.dataset.price);
        const ra = Number(a.dataset.rating);
        const rb = Number(b.dataset.rating);
        switch (mode) {
          case 'price-asc':
            return pa - pb;
          case 'price-desc':
            return pb - pa;
          case 'rating':
            return rb - ra;
          default:
            return Number(a.dataset.index) - Number(b.dataset.index);
        }
      });
      for (const card of sorted) grid.appendChild(card);

      const total = cards().length;
      count.textContent =
        visible === total
          ? `Showing all ${total} products`
          : `Showing ${visible} of ${total} products`;
    }

    for (const chip of chips) {
      chip.addEventListener('mdSelect', (e: Event) => {
        const detail = (e as CustomEvent<{ selected: boolean }>).detail;
        const category = (chip as HTMLElement).dataset.filter || '';
        if (detail.selected) active.add(category);
        else active.delete(category);
        apply();
      });
    }

    sortSelect?.addEventListener('mdChange', apply);
  </script>
</Base>
