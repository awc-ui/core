{
  "name": "@awc-ui/aero",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aero flight booking showcase built with AWC UI and React",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4498 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4498 --strictPort",
    "lint": "tsc --noEmit",
    "test": "node --test tests/flights.test.mjs tests/composite-field-enter.test.mjs tests/bookings.test.mjs",
    "test:assets": "node --test tests/font-assets.test.mjs"
  },
  "dependencies": {
    "@awc-ui/core": "workspace:*",
    "@awc-ui/react": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@stencil/react-output-target": "1.6.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0"
  },
  "engines": { "node": ">=22.13.0" }
}
